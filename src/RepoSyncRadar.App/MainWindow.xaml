<Window x:Class="RepoSyncRadar.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:pages="clr-namespace:RepoSyncRadar.App.Components"
        Title="RepoSyncRadar"
        Height="900"
        Width="1600"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="3*" />
    </Grid.ColumnDefinitions>

    <!-- Left + center: Blazor app shell (sidebar, workbench, drafts). -->
    <blazor:BlazorWebView x:Name="BlazorView"
                          Grid.Column="0"
                          HostPage="wwwroot/index.html">
      <blazor:BlazorWebView.RootComponents>
        <blazor:RootComponent Selector="#app"
                              ComponentType="{x:Type pages:Workbench}" />
      </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>

    <GridSplitter Grid.Column="1"
                  HorizontalAlignment="Stretch"
                  Background="#DDDDDD" />

    <!-- Right: the live docs.github.com surface. Source is assigned in code-behind
         after CreationProperties (custom UserDataFolder) so DocsView does not collide
         with BlazorWebView's internal WebView2 on the default folder. -->
    <Grid Grid.Column="2">
      <wv2:WebView2 x:Name="DocsView" />
      <!--
        Shown only when WebView2 init fails (Evergreen runtime missing, etc.).
        Kept inside the same grid cell so layout does not shift on fallback.
      -->
      <Border x:Name="DocsFallback"
              Background="#FFF8E1"
              BorderBrush="#E0C97A"
              BorderThickness="1"
              Padding="16"
              Visibility="Collapsed">
        <TextBlock x:Name="DocsFallbackMessage"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Text="WebView2 を初期化できませんでした。" />
      </Border>
    </Grid>
  </Grid>
</Window>
