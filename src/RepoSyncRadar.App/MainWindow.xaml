<Window x:Class="RepoSyncRadar.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:pages="clr-namespace:RepoSyncRadar.App.Components"
        Title="RepoSyncRadar"
        Height="900"
        Width="1600"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="3*" />
    </Grid.ColumnDefinitions>

    <!-- Left + center: Blazor app shell (sidebar, workbench, drafts). -->
    <blazor:BlazorWebView x:Name="BlazorView"
                          Grid.Column="0"
                          HostPage="wwwroot/index.html"
                          BlazorWebViewInitializing="OnBlazorViewInitializing">
      <blazor:BlazorWebView.RootComponents>
        <blazor:RootComponent Selector="#app"
                              ComponentType="{x:Type pages:Workbench}" />
      </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>

    <GridSplitter Grid.Column="1"
                  HorizontalAlignment="Stretch"
                  Background="#DDDDDD"
                  Cursor="SizeWE"
                  ResizeBehavior="PreviousAndNext"
                  ShowsPreview="False" />

    <!-- Right: official docs surface + optional PR HEAD local preview surface.
         Source is assigned in code-behind after CreationProperties (custom
         UserDataFolder) so standalone WebView2 instances do not collide with
         BlazorWebView's internal WebView2 on the default folder. -->
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="50" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="OfficialDocsColumn" Width="*" />
        <ColumnDefinition x:Name="PreviewDocsSplitterColumn" Width="0" />
        <ColumnDefinition x:Name="PreviewDocsColumn" Width="0" />
      </Grid.ColumnDefinitions>

      <Border Grid.Row="0"
              Grid.Column="0"
              Background="#0D1117"
              BorderBrush="#30363D"
              BorderThickness="0,0,0,1"
              Padding="10,4">
        <Grid>
          <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock x:Name="OfficialDocsHeaderText"
                     Text="公式 docs.github.com"
                     Foreground="#C9D1D9"
                     FontSize="12"
                     TextTrimming="CharacterEllipsis" />
          <DockPanel Grid.Row="1"
                     LastChildFill="True">
            <Border x:Name="OfficialDocsFileBadge"
                    DockPanel.Dock="Left"
                    Background="#1F6FEB"
                    CornerRadius="3"
                    Padding="4,0"
                    Margin="0,1,6,0"
                    Visibility="Collapsed">
              <TextBlock x:Name="OfficialDocsFileBadgeText"
                         Foreground="#FFFFFF"
                         FontSize="10"
                         FontWeight="SemiBold" />
            </Border>
            <TextBlock x:Name="OfficialDocsFilePathText"
                       Foreground="#8B949E"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Grid>
      </Border>

      <GridSplitter x:Name="PreviewDocsSplitter"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Background="#DDDDDD"
                    Cursor="SizeWE"
                    ResizeBehavior="PreviousAndNext"
                    ShowsPreview="False"
                    Visibility="Collapsed" />

      <Border x:Name="PreviewDocsHeader"
              Grid.Row="0"
              Grid.Column="2"
              Background="#0D1117"
              BorderBrush="#30363D"
              BorderThickness="0,0,0,1"
              Padding="10,4"
              Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock x:Name="PreviewDocsHeaderText"
                     Text="PR HEAD localhost"
                     Foreground="#C9D1D9"
                     FontSize="12"
                     TextTrimming="CharacterEllipsis" />
          <DockPanel Grid.Row="1"
                     LastChildFill="True">
            <Border x:Name="PreviewDocsFileBadge"
                    DockPanel.Dock="Left"
                    Background="#1F6FEB"
                    CornerRadius="3"
                    Padding="4,0"
                    Margin="0,1,6,0"
                    Visibility="Collapsed">
              <TextBlock x:Name="PreviewDocsFileBadgeText"
                         Foreground="#FFFFFF"
                         FontSize="10"
                         FontWeight="SemiBold" />
            </Border>
            <TextBlock x:Name="PreviewDocsFilePathText"
                       Foreground="#8B949E"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1"
            Grid.Column="0">
        <wv2:WebView2 x:Name="DocsView" />
        <Border x:Name="DocsPreviewStatusOverlay"
                Panel.ZIndex="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Margin="10"
                Padding="10,8"
                Background="#E60D1117"
                BorderBrush="#30363D"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="Collapsed"
                IsHitTestVisible="False">
          <StackPanel>
            <TextBlock x:Name="DocsPreviewStatusText"
                       Foreground="#F0F6FC"
                       FontWeight="SemiBold"
                       FontSize="12"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="DocsPreviewStatusDetailText"
                       Foreground="#8B949E"
                       FontSize="11"
                       Margin="0,2,0,6"
                       TextWrapping="Wrap" />
            <ProgressBar Height="3"
                         IsIndeterminate="True" />
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="1"
            Grid.Column="2"
            x:Name="PreviewViewHost"
            Visibility="Collapsed">
        <wv2:WebView2 x:Name="PreviewView" />
        <Border x:Name="PreviewStatusOverlay"
                Panel.ZIndex="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Margin="10"
                Padding="10,8"
                Background="#E60D1117"
                BorderBrush="#30363D"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="Collapsed"
                IsHitTestVisible="False">
          <StackPanel>
            <TextBlock x:Name="PreviewStatusText"
                       Foreground="#F0F6FC"
                       FontWeight="SemiBold"
                       FontSize="12"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="PreviewStatusDetailText"
                       Foreground="#8B949E"
                       FontSize="11"
                       Margin="0,2,0,6"
                       TextWrapping="Wrap" />
            <ProgressBar Height="3"
                         IsIndeterminate="True" />
          </StackPanel>
        </Border>
      </Grid>

      <!--
        Shown only when WebView2 init fails (Evergreen runtime missing, etc.).
        Kept inside the same grid cell so layout does not shift on fallback.
      -->
      <Border x:Name="DocsFallback"
              Grid.Row="0"
              Grid.RowSpan="2"
              Grid.Column="0"
              Grid.ColumnSpan="3"
              Background="#FFF8E1"
              BorderBrush="#E0C97A"
              BorderThickness="1"
              Padding="16"
              Visibility="Collapsed">
        <TextBlock x:Name="DocsFallbackMessage"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Text="WebView2 を初期化できませんでした。" />
      </Border>
    </Grid>
  </Grid>
</Window>
