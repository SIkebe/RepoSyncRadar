<Window x:Class="RepoSyncRadar.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:pages="clr-namespace:RepoSyncRadar.App.Components"
        Title="RepoSyncRadar"
        Height="900"
        Width="1600"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="3*" />
    </Grid.ColumnDefinitions>

    <!-- Left + center: Blazor app shell (sidebar, workbench, drafts). -->
    <blazor:BlazorWebView x:Name="BlazorView"
                          Grid.Column="0"
                          HostPage="wwwroot/index.html">
      <blazor:BlazorWebView.RootComponents>
        <blazor:RootComponent Selector="#app"
                              ComponentType="{x:Type pages:Workbench}" />
      </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>

    <GridSplitter Grid.Column="1"
                  HorizontalAlignment="Stretch"
                  Background="#DDDDDD" />

    <!-- Right: the live docs.github.com surface. Phase 1 will drive Source via DocsViewBridge. -->
    <wv2:WebView2 x:Name="DocsView"
                  Grid.Column="2"
                  Source="https://docs.github.com/" />
  </Grid>
</Window>
