<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows SDK バージョンを明示して WinRT projection (Microsoft.Windows.SDK.NET) を
         取り込む。WebView2.Wpf の D3DImage 初期化がこれを要求する。 -->
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <RootNamespace>RepoSyncRadar.App</RootNamespace>
    <AssemblyName>RepoSyncRadar</AssemblyName>
    <StartupObject>RepoSyncRadar.App.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="GitHub.Copilot.SDK" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Octokit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RepoSyncRadar.Core\RepoSyncRadar.Core.csproj" />
  </ItemGroup>

  <Target Name="StopRunningDebugAppBeforeBuild"
          BeforeTargets="PrepareForBuild"
          Condition="'$(Configuration)' == 'Debug' and '$(DesignTimeBuild)' != 'true' and '$(RepoSyncRadarStopRunningAppBeforeBuild)' != 'false'">
    <PropertyGroup>
      <_RepoSyncRadarDebugExePath>$(TargetDir)$(AssemblyName).exe</_RepoSyncRadarDebugExePath>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\Stop-RepoSyncRadarDebugProcess.ps1&quot; -TargetPath &quot;$(_RepoSyncRadarDebugExePath)&quot;"
          IgnoreExitCode="true" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="RepoSyncRadar.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />

    <Content Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- appsettings.local.json は .gitignore 対象 (個人/環境固有の値・トークン置き場)。
         Razor SDK が暗黙で Content に含めるが CopyToOutputDirectory が未指定なので、
         ここで明示して保存毎に bin にコピーさせる。Publish 時は含めない。 -->
    <Content Update="appsettings.local.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <Content Update="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    GitHub.Copilot.SDK の targets は build 時に $(OutDir)runtimes\<rid>\native 配下へ
    CLI と managed runtime assets を配置するが、PublishSingleFile=true では publish 出力
    ($(PublishDir)) に伝播しない。Build 出力の native directory を publish 後にコピーし、
    installed app が SDK の runtime wrapper または explicit CLI marker を解決できるようにする。
    CopilotSkipCliDownload=true や RuntimeIdentifier 未指定のクロスビルドでは source directory
    が無いので Condition で no-op にする。
  -->
  <Target Name="CopyCopilotRuntimeAfterPublish"
          AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' != '' And '$(CopilotSkipCliDownload)' != 'true'">
    <PropertyGroup>
      <_CopilotPublishSourceDir>$(OutDir)runtimes\$(RuntimeIdentifier)\native\</_CopilotPublishSourceDir>
      <_CopilotPublishDestDir>$(PublishDir)runtimes\$(RuntimeIdentifier)\native\</_CopilotPublishDestDir>
    </PropertyGroup>
    <ItemGroup>
      <_CopilotPublishRuntimeAsset Include="$(_CopilotPublishSourceDir)**\*" />
    </ItemGroup>
    <Warning Text="GitHub.Copilot.SDK runtime assets were not found under '$(_CopilotPublishSourceDir)'; the published app will fail with 'Copilot runtime not found'."
             Condition="'@(_CopilotPublishRuntimeAsset)' == ''" />
    <MakeDir Directories="$(_CopilotPublishDestDir)"
             Condition="'@(_CopilotPublishRuntimeAsset)' != ''" />
    <Copy SourceFiles="@(_CopilotPublishRuntimeAsset)"
          DestinationFiles="@(_CopilotPublishRuntimeAsset->'$(_CopilotPublishDestDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_CopilotPublishRuntimeAsset)' != ''" />
  </Target>

</Project>
