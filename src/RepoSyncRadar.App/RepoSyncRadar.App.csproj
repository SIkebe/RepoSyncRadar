<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows SDK バージョンを明示して WinRT projection (Microsoft.Windows.SDK.NET) を
         取り込む。WebView2.Wpf の D3DImage 初期化がこれを要求する。 -->
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <RootNamespace>RepoSyncRadar.App</RootNamespace>
    <AssemblyName>RepoSyncRadar</AssemblyName>
    <StartupObject>RepoSyncRadar.App.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="GitHub.Copilot.SDK" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Octokit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RepoSyncRadar.Core\RepoSyncRadar.Core.csproj" />
  </ItemGroup>

  <Target Name="StopRunningDebugAppBeforeBuild"
          BeforeTargets="PrepareForBuild"
          Condition="'$(Configuration)' == 'Debug' and '$(DesignTimeBuild)' != 'true' and '$(RepoSyncRadarStopRunningAppBeforeBuild)' != 'false'">
    <PropertyGroup>
      <_RepoSyncRadarDebugExePath>$(TargetDir)$(AssemblyName).exe</_RepoSyncRadarDebugExePath>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\Stop-RepoSyncRadarDebugProcess.ps1&quot; -TargetPath &quot;$(_RepoSyncRadarDebugExePath)&quot;"
          IgnoreExitCode="true" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="RepoSyncRadar.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />

    <Content Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- appsettings.local.json は .gitignore 対象 (個人/環境固有の値・トークン置き場)。
         Razor SDK が暗黙で Content に含めるが CopyToOutputDirectory が未指定なので、
         ここで明示して保存毎に bin にコピーさせる。Publish 時は含めない。 -->
    <Content Update="appsettings.local.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <Content Update="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    GitHub.Copilot.SDK の targets は build 時に $(OutDir)runtimes\<rid>\native\copilot.exe を
    配置するが、PublishSingleFile=true で publish するとこのネイティブ実行ファイルが
    publish 出力 ($(PublishDir)) に伝播せず、Velopack で pack されたインストール版で
    "Copilot runtime not found" になる。Build 出力に存在する copilot.exe を publish 後に
    明示的にコピーしてこれを回避する。CopilotSkipCliDownload=true や RuntimeIdentifier 未指定の
    クロスビルドでは copilot.exe が無いので Condition で no-op にする。
  -->
  <Target Name="CopyCopilotRuntimeAfterPublish"
          AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' != '' And '$(CopilotSkipCliDownload)' != 'true'">
    <PropertyGroup>
      <_CopilotPublishBinaryName Condition="$(RuntimeIdentifier.StartsWith('win-'))">copilot.exe</_CopilotPublishBinaryName>
      <_CopilotPublishBinaryName Condition="'$(_CopilotPublishBinaryName)' == ''">copilot</_CopilotPublishBinaryName>
      <_CopilotPublishSource>$(OutDir)runtimes\$(RuntimeIdentifier)\native\$(_CopilotPublishBinaryName)</_CopilotPublishSource>
      <_CopilotPublishDestDir>$(PublishDir)runtimes\$(RuntimeIdentifier)\native\</_CopilotPublishDestDir>
    </PropertyGroup>
    <Warning Text="GitHub.Copilot.SDK runtime '$(_CopilotPublishSource)' not found during publish; the published app will fail with 'Copilot runtime not found'."
             Condition="!Exists('$(_CopilotPublishSource)')" />
    <MakeDir Directories="$(_CopilotPublishDestDir)"
             Condition="Exists('$(_CopilotPublishSource)')" />
    <Copy SourceFiles="$(_CopilotPublishSource)"
          DestinationFolder="$(_CopilotPublishDestDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_CopilotPublishSource)')" />
  </Target>

</Project>
