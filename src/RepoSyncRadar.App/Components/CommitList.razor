@using Microsoft.Extensions.DependencyInjection
@using RepoSyncRadar.Core.Data
@using RepoSyncRadar.Core.Models

@*
    CommitList — Phase 1 commit inbox view. Loads commits from IRadarRepository using the
    supplied filter and renders one row per commit. Empty state explicitly tells the user
    to press the Triage button rather than leaving them to guess. Triage-triggered refresh is
    driven by Workbench via the Filter parameter reference changing.
*@

<section class="radar-commit-list" data-testid="commit-list">
    @if (_commits is null)
    {
        <p class="loading" data-testid="commit-list-loading">読み込み中…</p>
    }
    else if (_commits.Count == 0)
    {
        <p class="empty" data-testid="commit-list-empty">
            表示するコミットがありません。<br />
            <small class="empty-hint">
                上部の <strong>Triage</strong> ボタンを押すと github/docs の最新 Repo sync コミットを取得し、スコアリングします。
                ボタンが無効の場合は、まず <strong>Sign in</strong> から GitHub にサインインしてください。
            </small>
        </p>
    }
    else
    {
        <div class="commit-list-selection-toolbar" data-testid="commit-list-selection-toolbar">
            <button type="button"
                    class="commit-list-select-all"
                    data-testid="commit-list-select-all"
                    @onclick="ToggleAllVisibleAsync">@BuildSelectAllLabel()</button>
            <span class="commit-list-selection-count" data-testid="commit-list-selected-count">
                @CountSelectedVisible() 件選択中
            </span>
        </div>
        <ul class="commit-rows">
            @foreach (var commit in _commits)
            {
                <li class="@BuildRowClass(commit)"
                    data-testid="commit-row"
                    data-sha="@commit.Sha"
                    @onclick="() => OnSelectAsync(commit)">
                    <input type="checkbox"
                           class="commit-row-select"
                           data-testid="commit-select"
                           data-sha="@commit.Sha"
                           aria-label="@($"{FirstLine(commit.Message)} を選択")"
                           checked="@IsSelected(commit.Sha)"
                           @onclick:stopPropagation="true"
                           @onchange="() => ToggleSelectionAsync(commit.Sha)" />
                    <span class="sha">@ShortSha(commit.Sha)</span>
                    <span class="message" title="@commit.Message">@FirstLine(commit.Message)</span>
                    <span class="@BuildScoreClass(commit)"
                          data-testid="commit-row-score"
                          title="@BuildScoreTitle(commit)">@FormatScore(commit)</span>
                    <time class="authored" datetime="@commit.AuthoredAt.ToString("O")">
                        @commit.AuthoredAt.ToString("yyyy-MM-dd")
                    </time>
                </li>
            }
        </ul>
    }
</section>

@code {
    [CascadingParameter] public IServiceProvider Services { get; set; } = default!;

    [Parameter] public CommitQueryFilter? Filter { get; set; }

    [Parameter] public int RefreshToken { get; set; }

    [Parameter] public string? SelectedSha { get; set; }

    [Parameter] public IReadOnlySet<string> SelectedShas { get; set; } = new HashSet<string>(StringComparer.Ordinal);

    [Parameter] public EventCallback<Commit> OnCommitSelected { get; set; }

    [Parameter] public EventCallback<CommitSelectionChange> SelectionChanged { get; set; }

    private IReadOnlyList<Commit>? _commits;
    private CommitQueryFilter? _appliedFilter;
    private int _appliedRefreshToken = -1;

    protected override async Task OnParametersSetAsync()
    {
        // Re-query only when the filter reference (or any of its values) changes.
        if (_commits is not null
            && _appliedRefreshToken == RefreshToken
            && Equals(_appliedFilter, Filter))
        {
            return;
        }

        var repo = Services.GetRequiredService<IRadarRepository>();
        _appliedFilter = Filter;
        _appliedRefreshToken = RefreshToken;
        _commits = await repo.QueryCommitsAsync(Filter ?? new CommitQueryFilter());
    }

    private Task OnSelectAsync(Commit commit) => OnCommitSelected.InvokeAsync(commit);

    private Task ToggleSelectionAsync(string sha)
        => SelectionChanged.InvokeAsync(new CommitSelectionChange([sha], !IsSelected(sha)));

    private Task ToggleAllVisibleAsync()
    {
        if (_commits is null || _commits.Count == 0)
        {
            return Task.CompletedTask;
        }

        var shas = _commits.Select(static commit => commit.Sha).ToArray();
        return SelectionChanged.InvokeAsync(new CommitSelectionChange(shas, !AreAllVisibleSelected()));
    }

    private string BuildRowClass(Commit commit)
    {
        var classes = new List<string> { "commit-row" };
        if (SelectedSha == commit.Sha)
        {
            classes.Add("active");
        }
        if (IsSelected(commit.Sha))
        {
            classes.Add("selected");
        }
        return string.Join(' ', classes);
    }

    private string BuildSelectAllLabel()
        => AreAllVisibleSelected() ? "全解除" : "全選択";

    private bool AreAllVisibleSelected()
        => _commits is { Count: > 0 } && _commits.All(commit => IsSelected(commit.Sha));

    private int CountSelectedVisible()
        => _commits?.Count(commit => IsSelected(commit.Sha)) ?? 0;

    private bool IsSelected(string sha)
        => SelectedShas.Contains(sha);

    private static string BuildScoreClass(Commit commit)
        => commit.Scoring is null ? "score unscored" : "score";

    private static string BuildScoreTitle(Commit commit)
        => commit.Scoring is { } scoring
            ? $"スコア {FormatScore(scoring.Score)}"
            : "未スコアリング";

    private static string FormatScore(Commit commit)
        => commit.Scoring is { } scoring ? FormatScore(scoring.Score) : "未採点";

    private static string FormatScore(double score)
        => score.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);

    private static string ShortSha(string sha)
        => string.IsNullOrEmpty(sha) ? string.Empty : sha[..Math.Min(7, sha.Length)];

    private static string FirstLine(string? message)
    {
        if (string.IsNullOrEmpty(message))
        {
            return string.Empty;
        }
        var newline = message.IndexOf('\n');
        return newline < 0 ? message : message[..newline];
    }
}
