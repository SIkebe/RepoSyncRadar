@* Displays the diff explanation and media-specific drafts for a focused
    commit. Loads existing drafts on initialization; "Regenerate" re-invokes the Adoption
   session. Implemented per IMPLEMENTATION_PLAN.md §Step 17. *@

@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.DependencyInjection
@using RepoSyncRadar.App.Copilot
@using RepoSyncRadar.Core.Data
@using RepoSyncRadar.Core.Models
@using RepoSyncRadar.Core.Services

@implements IDisposable

<div id="drafts-panel" class="drafts-panel action-panel" data-testid="drafts-panel">
    <header class="action-panel-header">
        <div>
            <h3>@L["Drafts.Title"]</h3>
            <p>@L["Drafts.Description"]</p>
        </div>
        @if (!string.IsNullOrEmpty(Sha) && !_busy)
        {
            <button type="button"
                    class="toolbar-button secondary"
                    data-testid="drafts-regenerate"
                    disabled="@_busy"
                    @onclick="RegenerateAsync">@L["Drafts.Regenerate"]</button>
        }
    </header>

    @if (string.IsNullOrEmpty(Sha))
    {
        <p class="drafts-empty">@L["Drafts.Empty"]</p>
    }
    else if (_busy)
    {
        <div class="preview-progress drafts-progress" data-testid="drafts-progress">
            <div class="preview-progress-row">
                <span class="preview-spinner" aria-hidden="true"></span>
                <span class="preview-progress-text progress-phase" data-testid="drafts-progress-text">
                    @L["Drafts.Progress"]
                </span>
                <span class="progress-metric progress-metric-elapsed" data-testid="drafts-progress-elapsed">
                    <span class="progress-metric-label">@L["Common.Elapsed"]</span>
                    <span class="progress-metric-value">@FormatElapsed(_elapsed)</span>
                </span>
                <button type="button"
                        class="preview-cancel"
                        data-testid="drafts-cancel"
                        disabled="@_canceling"
                        @onclick="CancelAsync">@(_canceling ? L["Common.Canceling"] : L["Common.Cancel"])</button>
            </div>
            <p class="drafts-busy" data-testid="drafts-busy">@L["Drafts.BusyHint"]</p>
        </div>
    }
    else
    {
        @RenderChannel("explanation", L["Drafts.Channel.Explanation"], _bundle?.ExplanationJa, large: true)
        @RenderChannel("twitter", "Twitter", _bundle?.TwitterJa)
        @RenderChannel("teams", "Teams", _bundle?.TeamsJa)
        @RenderChannel("customer", L["Drafts.Channel.Customer"], _bundle?.CustomerJa)
        @if (!string.IsNullOrEmpty(_status))
        {
            <p class="drafts-status" data-testid="drafts-status">@_status</p>
        }
    }
</div>

@code {
    [Parameter] public string? Sha { get; set; }

    [CascadingParameter] public IServiceProvider Services { get; set; } = default!;

    private IStringLocalizer<SharedResource>? _localizer;
    private IStringLocalizer<SharedResource> L => _localizer ??= Services.GetRequiredService<IStringLocalizer<SharedResource>>();

    private DraftBundle? _bundle;
    private string? _lastLoadedSha;
    private bool _busy;
    private bool _canceling;
    private DateTimeOffset _startedAt;
    private TimeSpan _elapsed;
    private CancellationTokenSource? _cts;
    private Task? _timerTask;
    private string? _status;
    private IReviewBroadcaster? _broadcaster;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(Sha))
        {
            _bundle = null;
            _lastLoadedSha = null;
            return;
        }
        if (Sha == _lastLoadedSha)
        {
            return;
        }
        _status = null;
        await LoadAsync();
        _lastLoadedSha = Sha;
    }

    protected override void OnInitialized()
    {
        _broadcaster = Services.GetService<IReviewBroadcaster>();
        if (_broadcaster is not null)
        {
            _broadcaster.Reviewed += OnReviewed;
        }
    }

    private async void OnReviewed(object? sender, EventArgs e)
    {
        try
        {
            await InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task LoadAsync()
    {
        var sha = Sha;
        if (string.IsNullOrEmpty(sha))
        {
            return;
        }
        var dbFactory = Services.GetService<IDbContextFactory<RadarDbContext>>();
        if (dbFactory is null)
        {
            return;
        }
        await using var db = await dbFactory.CreateDbContextAsync();
        var drafts = await db.Drafts.AsNoTracking().Where(d => d.Sha == sha).ToListAsync();
        if (drafts.Count == 0)
        {
            _bundle = null;
            return;
        }
        _bundle = new DraftBundle(
            FindDraft(drafts, "twitter"),
            FindDraft(drafts, "teams"),
            FindDraft(drafts, "customer"),
            FindDraft(drafts, "explanation"));
    }

    private static string FindDraft(IEnumerable<Draft> drafts, string channel)
    {
        var match = drafts.FirstOrDefault(d => string.Equals(d.Channel, channel, StringComparison.OrdinalIgnoreCase));
        return match?.Body ?? string.Empty;
    }

    private async Task RegenerateAsync()
    {
        if (string.IsNullOrEmpty(Sha) || _busy)
        {
            return;
        }
        var agent = Services.GetService<ICopilotAgent>();
        if (agent is null)
        {
            _status = L["Common.AgentNotRegistered"];
            return;
        }
        StartProgress();
        _status = null;
        StateHasChanged();
        try
        {
            _bundle = await agent.GenerateDraftsAsync(Sha, _cts!.Token);
            _broadcaster?.Publish();
        }
        catch (OperationCanceledException)
        {
            _status = L["Drafts.RegenerateCanceled"];
        }
        catch (Exception ex)
        {
            _status = $"{L["Drafts.RegenerateFailed"]}: {BuildFriendlyErrorMessage(ex)}";
        }
        finally
        {
            await StopProgressAsync();
            StateHasChanged();
        }
    }

    private void StartProgress()
    {
        _busy = true;
        _canceling = false;
        _startedAt = DateTimeOffset.UtcNow;
        _elapsed = TimeSpan.Zero;
        _cts = new CancellationTokenSource();
        _timerTask = UpdateElapsedAsync(_cts.Token);
    }

    private async Task StopProgressAsync()
    {
        CancelProgress();
        if (_timerTask is not null)
        {
            try { await _timerTask.ConfigureAwait(false); }
            catch (OperationCanceledException) { }
            _timerTask = null;
        }
        _cts?.Dispose();
        _cts = null;
        _busy = false;
        _canceling = false;
    }

    private void CancelProgress()
    {
        try { _cts?.Cancel(); } catch (ObjectDisposedException) { }
    }

    private async Task UpdateElapsedAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                _elapsed = ProgressElapsedDisplay.Advance(_elapsed, _startedAt, DateTimeOffset.UtcNow);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private Task CancelAsync()
    {
        if (!_busy || _cts is null || _canceling)
        {
            return Task.CompletedTask;
        }

        _canceling = true;
        try { _cts.Cancel(); } catch (ObjectDisposedException) { }
        return Task.CompletedTask;
    }

    private static string FormatElapsed(TimeSpan elapsed)
        => elapsed.TotalHours >= 1
            ? $"{(int)elapsed.TotalHours}:{elapsed.Minutes:D2}:{elapsed.Seconds:D2}"
            : $"{elapsed.Minutes:D2}:{elapsed.Seconds:D2}";

    private string BuildFriendlyErrorMessage(Exception ex)
        => ex.Message.Contains("non-JSON", StringComparison.OrdinalIgnoreCase)
            || ex.Message.Contains("JSON", StringComparison.OrdinalIgnoreCase)
            ? L["Drafts.NonJsonResponse"]
            : ex.Message;

    private async Task CopyAsync(string? text, string channel)
    {
        if (string.IsNullOrEmpty(text))
        {
            return;
        }
        var clipboard = Services.GetService<IClipboard>();
        if (clipboard is null)
        {
            _status = L["Drafts.ClipboardUnavailable"];
            return;
        }
        await clipboard.SetTextAsync(text);
        _status = L["Drafts.Copied", channel];
    }

    private RenderFragment RenderChannel(string channel, string label, string? body, bool large = false) => builder =>
    {
        builder.OpenElement(0, "section");
        builder.AddAttribute(1, "class", large ? "drafts-channel drafts-channel-large" : "drafts-channel");
        builder.AddAttribute(2, "data-testid", $"drafts-section-{channel}");

        builder.OpenElement(3, "header");
        builder.OpenElement(4, "h4");
        builder.AddContent(5, label);
        builder.CloseElement();
        builder.OpenElement(6, "button");
        builder.AddAttribute(7, "type", "button");
        builder.AddAttribute(8, "class", "toolbar-button secondary compact");
        builder.AddAttribute(9, "data-testid", $"drafts-copy-{channel}");
        builder.AddAttribute(10, "disabled", string.IsNullOrEmpty(body));
        builder.AddAttribute(11, "onclick",
            Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => CopyAsync(body, label)));
        builder.AddContent(12, L["Common.Copy"]);
        builder.CloseElement();
        builder.CloseElement();

        if (string.IsNullOrWhiteSpace(body))
        {
            builder.OpenElement(13, "p");
            builder.AddAttribute(14, "class", "drafts-placeholder");
            builder.AddAttribute(15, "data-testid", $"drafts-empty-{channel}");
            builder.AddContent(16, L["Drafts.ChannelEmpty"]);
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(13, "pre");
            builder.AddAttribute(14, "data-testid", $"drafts-body-{channel}");
            builder.AddContent(15, body);
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    public void Dispose()
    {
        if (_broadcaster is not null)
        {
            _broadcaster.Reviewed -= OnReviewed;
        }
        CancelProgress();
        _cts?.Dispose();
        _cts = null;
    }
}
