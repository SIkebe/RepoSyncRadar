@* Editable workspace for generated diff explanations and sharing drafts. *@

@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.DependencyInjection
@using RepoSyncRadar.App.Copilot
@using RepoSyncRadar.Core.Data
@using RepoSyncRadar.Core.Models
@using RepoSyncRadar.Core.Services
@inherits LocalizedComponentBase

@implements IDisposable

<div id="drafts-panel" class="drafts-panel action-panel" data-testid="drafts-panel">
    <header class="action-panel-header">
        <div>
            <h3>@L["Drafts.Title"]</h3>
            <p>@L["Drafts.Description"]</p>
        </div>
        @if (!string.IsNullOrEmpty(Sha) && !_busy)
        {
            <div class="drafts-header-actions">
                <button type="button"
                        class="toolbar-button secondary"
                        data-testid="drafts-regenerate"
                        disabled="@_busy"
                        @onclick="() => RegenerateAsync(confirmOverwrite: false)">@L["Drafts.Regenerate"]</button>
                @if (_confirmRegenerate)
                {
                    <button type="button"
                            class="toolbar-button danger"
                            data-testid="drafts-regenerate-confirm"
                            disabled="@_busy"
                            @onclick="() => RegenerateAsync(confirmOverwrite: true)">@L["Drafts.RegenerateConfirm"]</button>
                }
            </div>
        }
    </header>

    @if (string.IsNullOrEmpty(Sha))
    {
        <p class="drafts-empty">@L["Drafts.Empty"]</p>
    }
    else if (_busy)
    {
        <div class="preview-progress drafts-progress"
             data-testid="drafts-progress"
             role="status"
             aria-live="polite"
             aria-atomic="true">
            <div class="preview-progress-row">
                <span class="preview-spinner" aria-hidden="true"></span>
                <span class="preview-progress-text progress-phase" data-testid="drafts-progress-text">
                    @L["Drafts.Progress"]
                </span>
                <span class="progress-metric progress-metric-elapsed" data-testid="drafts-progress-elapsed">
                    <span class="progress-metric-label">@L["Common.Elapsed"]</span>
                    <span class="progress-metric-value">@FormatElapsed(_elapsed)</span>
                </span>
                <button type="button"
                        class="preview-cancel"
                        data-testid="drafts-cancel"
                        disabled="@_canceling"
                        @onclick="CancelAsync">@(_canceling ? L["Common.Canceling"] : L["Common.Cancel"])</button>
            </div>
            <p class="drafts-busy" data-testid="drafts-busy">@L["Drafts.BusyHint"]</p>
        </div>
    }
    else
    {
        @foreach (var state in _channels)
        {
            var headingId = $"drafts-heading-{state.Channel}";
            var metaId = $"drafts-meta-{state.Channel}";
            var warningsId = $"drafts-warnings-{state.Channel}";
            var warnings = GetWarnings(state).ToArray();
            <section class="@GetChannelClass(state)" data-testid="drafts-section-@state.Channel">
                <header>
                    <h4 id="@headingId">@state.Label</h4>
                    <div class="drafts-channel-actions">
                        @if (state.HasDraft)
                        {
                            <button type="button"
                                    class="toolbar-button secondary compact"
                                    data-testid="drafts-save-@state.Channel"
                                    disabled="@(!state.IsDirty)"
                                    @onclick="() => SaveAsync(state)">@L["Common.Save"]</button>
                            <button type="button"
                                    class="toolbar-button secondary compact"
                                    data-testid="drafts-revert-@state.Channel"
                                    disabled="@(!state.IsDirty)"
                                    @onclick="() => Revert(state)">@L["Drafts.Revert"]</button>
                        }
                        <button type="button"
                                class="toolbar-button secondary compact"
                                data-testid="drafts-copy-@state.Channel"
                                disabled="@(!state.HasDraft || string.IsNullOrEmpty(state.EditedBody))"
                                @onclick="() => CopyAsync(state)">@L["Common.Copy"]</button>
                    </div>
                </header>

                @if (!state.HasDraft)
                {
                    <p class="drafts-placeholder" data-testid="drafts-empty-@state.Channel">@L["Drafts.ChannelEmpty"]</p>
                }
                else
                {
                    <textarea class="drafts-body"
                              data-testid="drafts-body-@state.Channel"
                              rows="@state.Rows"
                              aria-labelledby="@headingId"
                              aria-describedby="@BuildDraftBodyDescription(metaId, warningsId, warnings)"
                              aria-errormessage="@BuildDraftBodyErrorMessage(warningsId, warnings)"
                              aria-invalid="@BuildDraftBodyInvalid(warnings)"
                              value="@state.EditedBody"
                              @oninput="e => OnBodyInput(state, e.Value?.ToString() ?? string.Empty)"></textarea>
                    <div id="@metaId" class="drafts-channel-meta">
                        @if (state.Channel == TwitterChannel)
                        {
                            <span data-testid="drafts-count-twitter">@L["Drafts.TwitterCount", CountTwitterCharacters(state.EditedBody)]</span>
                        }
                        @if (state.IsDirty)
                        {
                            <span data-testid="drafts-dirty-@state.Channel">@L["Drafts.Unsaved"]</span>
                        }
                    </div>
                    @if (warnings.Length > 0)
                    {
                        <div id="@warningsId">
                            @foreach (var warning in warnings)
                            {
                                <p class="drafts-validation" data-testid="drafts-warning-@state.Channel" role="alert">@warning</p>
                            }
                        </div>
                    }
                }
            </section>
        }
        @if (!string.IsNullOrEmpty(_status))
        {
            <p class="drafts-status"
               data-testid="drafts-status"
               role="status"
               aria-live="polite"
               aria-atomic="true">@_status</p>
        }
    }
</div>

@code {
    private const string ExplanationChannel = "explanation";
    private const string TwitterChannel = "twitter";
    private const string CustomerChannel = "customer";
    private const int TwitterUrlLength = 23;

    [Parameter] public string? Sha { get; set; }

    [CascadingParameter] public IServiceProvider Services { get; set; } = default!;

    private IStringLocalizer<SharedResource>? _localizer;
    private IStringLocalizer<SharedResource> L => _localizer ??= Services.GetRequiredService<IStringLocalizer<SharedResource>>();

    private readonly List<DraftChannelState> _channels = new();
    private IReadOnlyList<string> _officialDocUrls = [];
    private string? _lastLoadedSha;
    private bool _busy;
    private bool _canceling;
    private bool _confirmRegenerate;
    private DateTimeOffset _startedAt;
    private TimeSpan _elapsed;
    private CancellationTokenSource? _cts;
    private Task? _timerTask;
    private string? _status;
    private IReviewBroadcaster? _broadcaster;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(Sha))
        {
            _channels.Clear();
            _officialDocUrls = [];
            _lastLoadedSha = null;
            _confirmRegenerate = false;
            return;
        }
        if (Sha == _lastLoadedSha)
        {
            return;
        }
        _status = null;
        _confirmRegenerate = false;
        await LoadAsync(preserveDirty: false);
        _lastLoadedSha = Sha;
    }

    protected override void OnInitialized()
    {
        _broadcaster = Services.GetService<IReviewBroadcaster>();
        if (_broadcaster is not null)
        {
            _broadcaster.Reviewed += OnReviewed;
        }
    }

    private async void OnReviewed(object? sender, EventArgs e)
    {
        try
        {
            await InvokeAsync(async () =>
            {
                await LoadAsync(preserveDirty: true);
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task LoadAsync(bool preserveDirty)
    {
        var sha = Sha;
        if (string.IsNullOrEmpty(sha))
        {
            return;
        }
        var dbFactory = Services.GetService<IDbContextFactory<RadarDbContext>>();
        if (dbFactory is null)
        {
            return;
        }
        await using var db = await dbFactory.CreateDbContextAsync();
        var drafts = await db.Drafts
            .AsNoTracking()
            .Where(d => d.Sha == sha)
            .OrderByDescending(d => d.GeneratedAt)
            .ThenByDescending(d => d.Id)
            .ToListAsync();
        var commit = await db.Commits
            .AsNoTracking()
            .Include(c => c.Files)
            .FirstOrDefaultAsync(c => c.Sha == sha);
        _officialDocUrls = commit is null
            ? []
            : await OfficialDocsUrlResolver.LoadAsync(db, commit, CancellationToken.None);
        SetChannels(drafts, preserveDirty);
    }

    private void SetChannels(IReadOnlyList<Draft> drafts, bool preserveDirty)
    {
        var previous = _channels.ToDictionary(static state => state.Channel, StringComparer.OrdinalIgnoreCase);
        var next = new[]
        {
            CreateState(ExplanationChannel, L["Drafts.Channel.Explanation"], rows: 8),
            CreateState(TwitterChannel, "Twitter", rows: 3),
            CreateState(CustomerChannel, L["Drafts.Channel.Customer"], rows: 18),
        };

        _channels.Clear();
        foreach (var state in next)
        {
            var draft = drafts.FirstOrDefault(d => string.Equals(d.Channel, state.Channel, StringComparison.OrdinalIgnoreCase));
            state.HasDraft = draft is not null;
            state.SavedBody = draft?.Body ?? string.Empty;
            state.EditedBody = preserveDirty
                && previous.TryGetValue(state.Channel, out var old)
                && old.IsDirty
                    ? old.EditedBody
                    : state.SavedBody;
            _channels.Add(state);
        }
    }

    private static DraftChannelState CreateState(string channel, string label, int rows)
        => new(channel, label, rows);

    private async Task RegenerateAsync(bool confirmOverwrite)
    {
        if (string.IsNullOrEmpty(Sha) || _busy)
        {
            return;
        }
        if (HasDirtyDrafts() && !confirmOverwrite)
        {
            _confirmRegenerate = true;
            _status = L["Drafts.RegenerateUnsaved"];
            return;
        }

        var agent = Services.GetService<ICopilotAgent>();
        if (agent is null)
        {
            _status = L["Common.AgentNotRegistered"];
            return;
        }
        StartProgress();
        _status = null;
        _confirmRegenerate = false;
        StateHasChanged();
        try
        {
            var bundle = await agent.GenerateDraftsAsync(Sha, _cts!.Token);
            ApplyBundle(bundle);
            _broadcaster?.Publish();
        }
        catch (OperationCanceledException)
        {
            _status = L["Drafts.RegenerateCanceled"];
        }
        catch (Exception ex)
        {
            _status = $"{L["Drafts.RegenerateFailed"]}: {BuildFriendlyErrorMessage(ex)}";
        }
        finally
        {
            await StopProgressAsync();
            StateHasChanged();
        }
    }

    private void ApplyBundle(DraftBundle bundle)
    {
        SetBody(ExplanationChannel, bundle.ExplanationJa);
        SetBody(TwitterChannel, bundle.TwitterJa);
        SetBody(CustomerChannel, bundle.CustomerJa);

        void SetBody(string channel, string body)
        {
            var state = _channels.FirstOrDefault(s => string.Equals(s.Channel, channel, StringComparison.Ordinal));
            if (state is null)
            {
                return;
            }
            state.HasDraft = true;
            state.SavedBody = body;
            state.EditedBody = body;
        }
    }

    private async Task SaveAsync(DraftChannelState state)
    {
        if (string.IsNullOrEmpty(Sha) || !state.HasDraft)
        {
            return;
        }
        if (string.IsNullOrWhiteSpace(state.EditedBody))
        {
            _status = L["Drafts.SaveBlockedEmpty", state.Label];
            return;
        }

        var dbFactory = Services.GetService<IDbContextFactory<RadarDbContext>>();
        if (dbFactory is null)
        {
            return;
        }

        try
        {
            await using var db = await dbFactory.CreateDbContextAsync();
            var drafts = await db.Drafts
                .Where(d => d.Sha == Sha && d.Channel == state.Channel)
                .OrderByDescending(d => d.GeneratedAt)
                .ThenByDescending(d => d.Id)
                .ToListAsync();
            var nowUtc = DateTime.UtcNow;
            var current = drafts.FirstOrDefault();
            if (current is null)
            {
                current = new Draft
                {
                    Sha = Sha,
                    Channel = state.Channel,
                    Posted = false,
                    GeneratedAt = nowUtc,
                };
                db.Drafts.Add(current);
            }
            else
            {
                current.GeneratedAt = nowUtc;
                if (drafts.Count > 1)
                {
                    db.Drafts.RemoveRange(drafts.Skip(1));
                }
            }

            current.Body = state.EditedBody;
            await db.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            _status = $"{L["Drafts.SaveFailed"]}: {BuildFriendlyErrorMessage(ex)}";
            return;
        }

        state.SavedBody = state.EditedBody;
        state.HasDraft = true;
        _confirmRegenerate = false;
        _status = L["Drafts.Saved", state.Label];
        _broadcaster?.Publish();
    }

    private void Revert(DraftChannelState state)
    {
        state.EditedBody = state.SavedBody;
        _confirmRegenerate = false;
        _status = L["Drafts.Reverted", state.Label];
    }

    private void OnBodyInput(DraftChannelState state, string value)
    {
        state.EditedBody = value;
        _confirmRegenerate = false;
    }

    private bool HasDirtyDrafts()
        => _channels.Any(static state => state.IsDirty);

    private IEnumerable<string> GetWarnings(DraftChannelState state)
    {
        if (string.IsNullOrWhiteSpace(state.EditedBody))
        {
            yield return L["Drafts.Warning.Empty"];
        }
        if (RequiresDocsUrlWarning(state))
        {
            yield return L["Drafts.Warning.MissingDocsUrl"];
        }
    }

    private bool RequiresDocsUrlWarning(DraftChannelState state)
        => _officialDocUrls.Count > 0
            && (state.Channel == TwitterChannel || state.Channel == CustomerChannel)
            && !state.EditedBody.Contains("docs.github.com", StringComparison.OrdinalIgnoreCase);

    private static int CountTwitterCharacters(string text)
    {
        var count = 0;
        for (var i = 0; i < text.Length;)
        {
            var urlStart = StartsWithUrl(text, i);
            if (urlStart)
            {
                count += TwitterUrlLength;
                i = AdvancePastUrl(text, i);
            }
            else
            {
                count++;
                i++;
            }
        }
        return count;
    }

    private static bool StartsWithUrl(string text, int index)
        => text.AsSpan(index).StartsWith("https://", StringComparison.OrdinalIgnoreCase)
            || text.AsSpan(index).StartsWith("http://", StringComparison.OrdinalIgnoreCase);

    private static int AdvancePastUrl(string text, int index)
    {
        while (index < text.Length && !char.IsWhiteSpace(text[index]))
        {
            index++;
        }
        return index;
    }

    private static string GetChannelClass(DraftChannelState state)
        => state.Channel switch
        {
            ExplanationChannel => "drafts-channel drafts-channel-large",
            CustomerChannel => "drafts-channel drafts-channel-customer",
            _ => "drafts-channel",
        };

    private static string BuildDraftBodyDescription(string metaId, string warningsId, IReadOnlyCollection<string> warnings)
        => warnings.Count > 0 ? $"{metaId} {warningsId}" : metaId;

    private static string? BuildDraftBodyErrorMessage(string warningsId, IReadOnlyCollection<string> warnings)
        => warnings.Count > 0 ? warningsId : null;

    private static string? BuildDraftBodyInvalid(IReadOnlyCollection<string> warnings)
        => warnings.Count > 0 ? "true" : null;

    private async Task CopyAsync(DraftChannelState state)
    {
        if (!state.HasDraft || string.IsNullOrEmpty(state.EditedBody))
        {
            return;
        }
        var clipboard = Services.GetService<IClipboard>();
        if (clipboard is null)
        {
            _status = L["Drafts.ClipboardUnavailable"];
            return;
        }
        await clipboard.SetTextAsync(state.EditedBody);
        _status = L["Drafts.Copied", state.Label];
    }

    private void StartProgress()
    {
        _busy = true;
        _canceling = false;
        _startedAt = DateTimeOffset.UtcNow;
        _elapsed = TimeSpan.Zero;
        _cts = new CancellationTokenSource();
        _timerTask = UpdateElapsedAsync(_cts.Token);
    }

    private async Task StopProgressAsync()
    {
        CancelProgress();
        if (_timerTask is not null)
        {
            try { await _timerTask.ConfigureAwait(false); }
            catch (OperationCanceledException) { }
            _timerTask = null;
        }
        _cts?.Dispose();
        _cts = null;
        _busy = false;
        _canceling = false;
    }

    private void CancelProgress()
    {
        try { _cts?.Cancel(); } catch (ObjectDisposedException) { }
    }

    private async Task UpdateElapsedAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                _elapsed = ProgressElapsedDisplay.Advance(_elapsed, _startedAt, DateTimeOffset.UtcNow);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private Task CancelAsync()
    {
        if (!_busy || _cts is null || _canceling)
        {
            return Task.CompletedTask;
        }

        _canceling = true;
        try { _cts.Cancel(); } catch (ObjectDisposedException) { }
        return Task.CompletedTask;
    }

    private static string FormatElapsed(TimeSpan elapsed)
        => elapsed.TotalHours >= 1
            ? $"{(int)elapsed.TotalHours}:{elapsed.Minutes:D2}:{elapsed.Seconds:D2}"
            : $"{elapsed.Minutes:D2}:{elapsed.Seconds:D2}";

    private string BuildFriendlyErrorMessage(Exception ex)
        => ex.Message.Contains("non-JSON", StringComparison.OrdinalIgnoreCase)
            || ex.Message.Contains("JSON", StringComparison.OrdinalIgnoreCase)
            ? L["Drafts.NonJsonResponse"]
            : ex.Message;

    public void Dispose()
    {
        if (_broadcaster is not null)
        {
            _broadcaster.Reviewed -= OnReviewed;
        }
        CancelProgress();
        _cts?.Dispose();
        _cts = null;
    }

    private sealed class DraftChannelState
    {
        public DraftChannelState(string channel, string label, int rows)
        {
            Channel = channel;
            Label = label;
            Rows = rows;
        }

        public string Channel { get; }

        public string Label { get; }

        public int Rows { get; }

        public bool HasDraft { get; set; }

        public string SavedBody { get; set; } = string.Empty;

        public string EditedBody { get; set; } = string.Empty;

        public bool IsDirty => !string.Equals(SavedBody, EditedBody, StringComparison.Ordinal);
    }
}
