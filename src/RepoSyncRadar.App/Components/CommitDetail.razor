@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Options
@using RepoSyncRadar.Core.Models
@using RepoSyncRadar.Core.Options
@using RepoSyncRadar.Core.Services
@using RepoSyncRadar.Core.Services.Preview

@*
    CommitDetail — Phase 1 commit inspector. Shows the file list with +/- stats and any
    canonical docs.github.com URLs returned by IPathToUrlResolver. Also surfaces the
    LLM-produced Scoring (score / category / audience / summary / why) so the morning
    triage output is visible to the user. Diff rendering and Adopt/Reject actions live
    in sibling components.

    Each file row carries a "WebView2 で開く" button so the user can flip the right-side
    docs surface to that file without going through the "ローカルプレビュー" button.
    If a local preview server is active (PreviewSession.IsActive) we publish the
    rewritten http://localhost:{port}{mapped} URL; otherwise we publish the first
    resolved docs.github.com URL so the official rendering is shown directly. This
    realises DESIGN.md §1.2 / §4.1 "公式ドキュメントとレンダリング上区別がつかない見た目で
    差分を検証" — the right pane is always the canonical look, only the source changes.
*@

<section class="radar-commit-detail" data-testid="commit-detail">
    @if (Commit is null)
    {
        <p class="empty" data-testid="commit-detail-empty">コミットを選択してください。</p>
    }
    else
    {
        <header class="commit-header">
            <span class="sha" data-testid="commit-detail-sha">@Commit.Sha</span>
            <span class="message" data-testid="commit-detail-message">@Commit.Message</span>
            <span class="author">@Commit.Author</span>
        </header>
        @if (Commit.Scoring is { } scoring)
        {
            var audience = TryParseAudience(scoring.AudienceJson);
            <section class="scoring" data-testid="commit-detail-scoring">
                <dl>
                    <dt>Score</dt>
                    <dd data-testid="commit-detail-score">@FormatScore(scoring.Score)</dd>
                    <dt>Category</dt>
                    <dd data-testid="commit-detail-category">@scoring.Category</dd>
                    @if (audience is { Count: > 0 })
                    {
                        <dt>Audience</dt>
                        <dd data-testid="commit-detail-audience">@string.Join(" / ", audience)</dd>
                    }
                    <dt>Summary</dt>
                    <dd data-testid="commit-detail-summary">@scoring.SummaryJa</dd>
                    <dt>Why</dt>
                    <dd data-testid="commit-detail-why">@scoring.WhyJa</dd>
                </dl>
            </section>
        }
        else
        {
            <p class="unscored" data-testid="commit-detail-unscored">未スコアリング (Morning Triage 未実行)</p>
        }
        <ul class="files">
            @foreach (var file in Commit.Files)
            {
                var previewTarget = ResolvePreviewTarget(file);
                <li class="file-row" data-testid="commit-detail-file" data-path="@file.Path">
                    <span class="path">@file.Path</span>
                    <span class="stats"
                          data-testid="commit-detail-stats-@file.Path">@FormatStats(file)</span>
                    @if (previewTarget is not null)
                    {
                        <button type="button"
                                class="open-in-webview"
                                data-testid="commit-detail-open-in-webview"
                                data-path="@file.Path"
                                title="@previewTarget.AbsoluteUri"
                                @onclick="() => OpenInWebView(previewTarget)">@PreviewButtonLabel</button>
                    }
                    @if (_urlsByPath.TryGetValue(file.Path, out var urls) && urls.Count > 0)
                    {
                        <ul class="urls">
                            @foreach (var url in urls)
                            {
                                <li>
                                    <a href="@url" target="_blank" rel="noopener"
                                       data-testid="commit-detail-url">@url</a>
                                </li>
                            }
                        </ul>
                    }
                </li>
            }
        </ul>
    }
</section>

@code {
    private const string PreviewButtonLabel = "WebView2 で開く";

    [CascadingParameter] public IServiceProvider Services { get; set; } = default!;

    [Parameter] public Commit? Commit { get; set; }

    [Parameter] public string Language { get; set; } = "en";

    private readonly Dictionary<string, IReadOnlyList<string>> _urlsByPath =
        new(StringComparer.Ordinal);

    private string? _resolvedForSha;

    protected override async Task OnParametersSetAsync()
    {
        if (Commit is null)
        {
            _urlsByPath.Clear();
            _resolvedForSha = null;
            return;
        }

        if (string.Equals(_resolvedForSha, Commit.Sha, StringComparison.Ordinal))
        {
            return;
        }

        _urlsByPath.Clear();
        var resolver = Services.GetRequiredService<IPathToUrlResolver>();
        foreach (var file in Commit.Files)
        {
            var urls = await resolver.ResolveAsync(file.Path, Language);
            _urlsByPath[file.Path] = urls;
        }
        _resolvedForSha = Commit.Sha;
    }

    /// <summary>
    /// Picks the right URL for the "WebView2 で開く" button on a single file row.
    /// Priority: (1) active local preview server + path mappable → http://localhost
    /// rewrite, (2) any resolver-supplied docs.github.com URL (relative paths are
    /// absolutised against <see cref="DocsApiOptions.BaseAddress"/>), (3) <c>null</c>
    /// → button hidden (the file is not a publishable content page).
    /// </summary>
    private Uri? ResolvePreviewTarget(CommitFile file)
    {
        var session = Services.GetService<PreviewSession>();
        var mapped = PreviewPathMapper.Map(file.Path, Language);
        if (mapped is not null && session is { IsActive: true } && session.ActivePort is { } port)
        {
            return new Uri(
                string.Create(System.Globalization.CultureInfo.InvariantCulture,
                    $"http://localhost:{port}{mapped}"),
                UriKind.Absolute);
        }
        if (_urlsByPath.TryGetValue(file.Path, out var urls) && urls.Count > 0)
        {
            var first = urls[0];
            if (Uri.TryCreate(first, UriKind.Absolute, out var absolute))
            {
                return absolute;
            }
            var baseAddress = Services.GetService<IOptions<DocsApiOptions>>()?.Value.BaseAddress;
            if (baseAddress is not null && Uri.TryCreate(baseAddress, first, out absolute))
            {
                return absolute;
            }
        }
        return null;
    }

    private void OpenInWebView(Uri url)
    {
        var navigator = Services.GetService<IPreviewNavigator>();
        navigator?.Publish(url);
    }

    private static string FormatStats(CommitFile file)
        => $"+{file.Additions} -{file.Deletions}";

    private static string FormatScore(double score)
        => score.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);

    private static IReadOnlyList<string>? TryParseAudience(string audienceJson)
    {
        if (string.IsNullOrWhiteSpace(audienceJson))
        {
            return null;
        }
        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<string[]>(audienceJson);
        }
        catch (System.Text.Json.JsonException)
        {
            return null;
        }
    }
}
