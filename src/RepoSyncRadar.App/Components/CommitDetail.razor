@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Options
@using System.Threading
@using RepoSyncRadar.Core.Models
@using RepoSyncRadar.Core.Options
@using RepoSyncRadar.Core.Services
@using RepoSyncRadar.Core.Services.Preview
@implements IDisposable

@*
    CommitDetail — Phase 1 commit inspector. Shows the file list with +/- stats and any
    canonical docs.github.com URLs returned by IPathToUrlResolver. Also surfaces the
    LLM-produced Scoring (score / category / audience / summary / why / detailed analysis)
    so the morning triage output is visible to the user. Diff rendering and Adopt/Archive
    actions live in sibling components.

    Each publishable file row carries a "WebView2 で開く" button. Clicking it starts
    the local PR-HEAD preview pipeline when needed, then navigates the right-side
    WebView2 to that exact file. This realises DESIGN.md §1.2 / §4.1
    "公式ドキュメントとレンダリング上区別がつかない見た目で差分を検証" — the right pane
    is always the canonical look, only the source changes.
*@

<section class="radar-commit-detail" data-testid="commit-detail">
    @if (Commit is null)
    {
        <p class="empty" data-testid="commit-detail-empty">コミットを選択してください。</p>
    }
    else
    {
        <header class="commit-header">
            <div class="commit-meta-row">
                <span class="sha" data-testid="commit-detail-sha" title="@Commit.Sha">@ShortSha(Commit.Sha)</span>
                <span class="author">@Commit.Author</span>
                @if (Commit.PrNumber > 0)
                {
                    var commitDiffUrl = BuildCommitDiffUrl(Commit);
                    <button type="button"
                        class="commit-pr-link toolbar-button compact secondary"
                        data-testid="commit-detail-open-pr"
                        title="右ペインで PR #@Commit.PrNumber のコミット差分を開きます"
                        @onclick="() => OpenCommitDiffInWebViewAsync(commitDiffUrl)">PR #@Commit.PrNumber</button>
                    <a class="commit-pr-external-link toolbar-button compact secondary"
                       data-testid="commit-detail-open-pr-external"
                       href="@commitDiffUrl"
                       target="_blank"
                       rel="noopener"
                       title="既定ブラウザーで PR #@Commit.PrNumber のコミット差分を開きます">↗</a>
                }
            </div>
            <p class="message" data-testid="commit-detail-message" title="@DisplayCommitMessage(Commit.Message)">@DisplayCommitMessage(Commit.Message)</p>
        </header>
        @if (Commit.Scoring is { } scoring)
        {
            var audience = TryParseAudience(scoring.AudienceJson);
            <section class="scoring" data-testid="commit-detail-scoring">
                <div class="scoring-summary-row">
                    <div class="score-tile">
                        <span class="score-label">スコア</span>
                        <span class="score-value" data-testid="commit-detail-score">@FormatScore(scoring.Score)</span>
                    </div>
                    <dl class="scoring-meta">
                        <div class="scoring-meta-item">
                            <dt>カテゴリ</dt>
                            <dd data-testid="commit-detail-category"><span class="meta-chip category-chip">@scoring.Category</span></dd>
                        </div>
                        @if (audience is { Count: > 0 })
                        {
                            <div class="scoring-meta-item">
                                <dt>対象</dt>
                                <dd class="audience-chips" data-testid="commit-detail-audience">
                                    @foreach (var item in audience)
                                    {
                                        <span class="meta-chip audience-chip">@item</span>
                                    }
                                </dd>
                            </div>
                        }
                    </dl>
                </div>
                <dl class="scoring-notes">
                    <div class="scoring-note">
                        <dt>要約</dt>
                        <dd data-testid="commit-detail-summary">@scoring.SummaryJa</dd>
                    </div>
                    <div class="scoring-note">
                        <dt>理由</dt>
                        <dd data-testid="commit-detail-why">@scoring.WhyJa</dd>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(scoring.DetailsJa))
                    {
                        <div class="scoring-note scoring-detail-note">
                            <dt>詳細分析</dt>
                            <dd class="analysis-detail" data-testid="commit-detail-details">@scoring.DetailsJa</dd>
                        </div>
                    }
                </dl>
            </section>
        }
        else
        {
            <p class="unscored" data-testid="commit-detail-unscored">未スコアリング (Triage 未実行)</p>
        }
        <div class="files-toolbar" data-testid="commit-detail-preview-toolbar">
            <div class="files-heading">
                <span class="files-heading-label">ファイル</span>
                <span class="files-heading-count">@BuildPreviewableFileCountLabel()</span>
            </div>
            <div class="preview-cleanup-control">
                <button type="button"
                        data-testid="commit-detail-preview-cleanup-button"
                        class="toolbar-button secondary preview-cleanup"
                        title="キャッシュされた docs worktree をすべて削除します"
                        disabled="@IsPreviewOperationBusy"
                        @onclick="CleanupPreviewCacheAsync">キャッシュ削除</button>
                @if (_previewCleanupBusy)
                {
                    <div class="preview-progress preview-cleanup-progress" data-testid="commit-detail-preview-cleanup-progress">
                        <div class="preview-progress-row">
                            <span class="preview-spinner" aria-hidden="true"></span>
                            <span class="preview-progress-text" data-testid="commit-detail-preview-cleanup-progress-text">
                                @(_previewStatus ?? "キャッシュをクリーンアップ中…")
                                <span class="preview-progress-elapsed" data-testid="commit-detail-preview-cleanup-progress-elapsed">
                                    ・ @_previewElapsedSec 秒経過 / 上限 @_previewTimeoutSec 秒
                                </span>
                            </span>
                            <button type="button"
                                    data-testid="commit-detail-preview-cleanup-cancel-button"
                                    class="preview-cancel"
                                    disabled="@_previewCanceling"
                                    @onclick="CancelPreviewAsync">@(_previewCanceling ? "中止中…" : "中止")</button>
                        </div>
                    </div>
                }
                else if (_previewStatusIsCleanup && !string.IsNullOrWhiteSpace(_previewStatus))
                {
                    <p class="preview-status preview-cleanup-status" data-testid="commit-detail-preview-cleanup-status">@_previewStatus</p>
                }
            </div>
        </div>
        <ul class="files">
            @foreach (var file in Commit.Files)
            {
                var previewTarget = ResolvePreviewTarget(file);
                var canOpenPreview = previewTarget is not null || IsLocalComparisonPreviewable(file);
                var previewPosition = GetPreviewPosition(file);
                var isActivePreview = IsActivePreviewFile(file);
                <li class="@BuildFileRowClass(file)" data-testid="commit-detail-file" data-path="@file.Path">
                    <span class="file-main">
                        @if (previewPosition.Ordinal > 0)
                        {
                            <span class="preview-file-index" title="プレビュー対象 @previewPosition.Ordinal / @previewPosition.Total">@previewPosition.Ordinal</span>
                        }
                        <span class="path">@file.Path</span>
                        @if (isActivePreview)
                        {
                            <span class="preview-active-badge">表示中</span>
                        }
                    </span>
                    <span class="stats"
                          data-testid="commit-detail-stats-@file.Path">@FormatStats(file)</span>
                    @if (canOpenPreview)
                    {
                        <div class="preview-file-action">
                            <button type="button"
                                    class="open-in-webview"
                                    data-testid="commit-detail-open-in-webview"
                                    data-path="@file.Path"
                                    disabled="@IsPreviewOperationBusy"
                                    title="@BuildPreviewTitle(file, previewTarget)"
                                    @onclick="() => OpenInWebViewAsync(file)">@BuildPreviewButtonLabel(file)</button>
                            @if (IsPreviewBusyFile(file))
                            {
                                <div class="preview-progress preview-file-progress" data-testid="commit-detail-preview-progress">
                                    <div class="preview-progress-row">
                                        <span class="preview-spinner" aria-hidden="true"></span>
                                        <span class="preview-progress-text" data-testid="commit-detail-preview-progress-text">
                                            @(_previewStatus ?? "起動中…")
                                            <span class="preview-progress-elapsed" data-testid="commit-detail-preview-progress-elapsed">
                                                ・ @_previewElapsedSec 秒経過 / 上限 @_previewTimeoutSec 秒
                                                @if (_previewPid is { } pid)
                                                {
                                                    <span class="preview-progress-pid" data-testid="commit-detail-preview-progress-pid">・ PID @pid</span>
                                                }
                                            </span>
                                        </span>
                                        <button type="button"
                                                data-testid="commit-detail-preview-cancel-button"
                                                class="preview-cancel"
                                                disabled="@_previewCanceling"
                                                @onclick="CancelPreviewAsync">@(_previewCanceling ? "中止中…" : "中止")</button>
                                    </div>
                                    @if (_previewStdoutTail.Count > 0)
                                    {
                                        <pre class="preview-log-tail preview-log-stdout" data-testid="commit-detail-preview-stdout">@string.Join('\n', _previewStdoutTail)</pre>
                                    }
                                    @if (_previewStderrTail.Count > 0)
                                    {
                                        <pre class="preview-log-tail preview-log-stderr" data-testid="commit-detail-preview-stderr">@string.Join('\n', _previewStderrTail)</pre>
                                    }
                                </div>
                            }
                            else if (IsPreviewFeedbackFile(file))
                            {
                                <p class="preview-status preview-file-status" data-testid="commit-detail-preview-status">@_previewStatus</p>
                            }
                        </div>
                    }
                    @if (_urlsByPath.TryGetValue(file.Path, out var urls) && urls.Count > 0)
                    {
                        <ul class="urls">
                            @foreach (var url in urls)
                            {
                                <li>
                                    <a href="@url" target="_blank" rel="noopener"
                                       data-testid="commit-detail-url">@url</a>
                                </li>
                            }
                        </ul>
                    }
                </li>
            }
        </ul>
    }
</section>

@code {
    private const string PreviewButtonLabel = "WebView2 で開く";
    private const int MaxLogTailLines = 10;
    private static readonly TimeSpan PollInterval = TimeSpan.FromMilliseconds(500);

    [CascadingParameter] public IServiceProvider Services { get; set; } = default!;

    [Parameter] public Commit? Commit { get; set; }

    [Parameter] public string Language { get; set; } = "en";

    private readonly Dictionary<string, IReadOnlyList<string>> _urlsByPath =
        new(StringComparer.Ordinal);

    private string? _resolvedForSha;
    private string? _activePreviewSha;
    private string? _previewBusyPath;
    private string? _previewBusySha;
    private bool _previewCleanupBusy;
    private string? _activePreviewPath;
    private string? _previewStatusPath;
    private string? _previewStatusSha;
    // §Step 19.9: 現在表示中の Markdown プレビューの docs version。
    private DocsVersion? _activeVersion;
    private IPreviewNavigator? _subscribedNavigator;
    private string? _previewStatus;
    private bool _previewStatusIsCleanup;
    private bool _previewCanceling;
    private DateTimeOffset _previewStartedAt;
    private int _previewElapsedSec;
    private int _previewTimeoutSec = 600;
    private List<string> _previewStdoutTail = new();
    private List<string> _previewStderrTail = new();
    private int? _previewPid;
    private long _previewOperationSerial;
    private PreviewOperation? _previewOperation;
    private CancellationTokenSource? _predictivePrewarmCts;

    private bool IsPreviewOperationBusy => _previewCleanupBusy || IsPreviewBusyForCurrentCommit;

    private bool IsPreviewBusyForCurrentCommit
        => Commit is not null
            && _previewBusyPath is not null
            && string.Equals(_previewBusySha, Commit.Sha, StringComparison.Ordinal);

    private sealed record PreviewOperation(
        long Id,
        string? Sha,
        CancellationTokenSource Cancellation,
        string CancellationSubject)
    {
        public Task? PollTask { get; set; }
    }

    protected override void OnInitialized()
    {
        var navigator = Services?.GetService<IPreviewNavigator>();
        if (navigator is not null)
        {
            navigator.VersionChangeRequested += OnVersionChangeRequested;
            navigator.FileNavigationRequested += OnFileNavigationRequested;
            _subscribedNavigator = navigator;
        }
    }

    public void Dispose()
    {
        if (_subscribedNavigator is not null)
        {
            _subscribedNavigator.VersionChangeRequested -= OnVersionChangeRequested;
            _subscribedNavigator.FileNavigationRequested -= OnFileNavigationRequested;
            _subscribedNavigator = null;
        }
        try { _previewOperation?.Cancellation.Cancel(); } catch (ObjectDisposedException) { }
        _previewOperation?.Cancellation.Dispose();
        _previewOperation = null;
        CancelPredictivePrewarm();
    }

    /// <summary>
    /// §Step 19.9: ホストの ComboBox で version 切替が起きた場合、アクティブな
    /// Markdown プレビューを同じ path / sha で新しい version を使って再 render する。
    /// </summary>
    private void OnVersionChangeRequested(object? sender, DocsVersion version)
    {
        if (IsPreviewOperationBusy || _activePreviewPath is null || Commit is null)
        {
            return;
        }
        if (_activeVersion is not null && _activeVersion == version)
        {
            return;
        }

        var file = Commit.Files.FirstOrDefault(f => string.Equals(f.Path, _activePreviewPath, StringComparison.Ordinal));
        if (file is null)
        {
            return;
        }
        _ = InvokeAsync(async () => await OpenInWebViewAsync(file, version));
    }

    private void OnFileNavigationRequested(object? sender, PreviewFileNavigationDirection direction)
    {
        if (IsPreviewOperationBusy || _activePreviewPath is null || Commit is null)
        {
            return;
        }

        var previewFiles = Commit.Files
            .Where(IsLocalComparisonPreviewable)
            .ToList();
        var offset = PreviewFileNavigationDirections.GetOffset(direction);
        if (offset == 0)
        {
            return;
        }

        var currentIndex = previewFiles.FindIndex(file => string.Equals(file.Path, _activePreviewPath, StringComparison.Ordinal));
        var targetIndex = currentIndex + offset;
        if (currentIndex < 0 || targetIndex < 0 || targetIndex >= previewFiles.Count)
        {
            return;
        }

        var targetFile = previewFiles[targetIndex];
        var version = _activeVersion;
        _ = InvokeAsync(async () => await OpenInWebViewAsync(targetFile, version));
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Commit is null)
        {
            _urlsByPath.Clear();
            _resolvedForSha = null;
            _activePreviewSha = null;
            CancelCurrentPreviewOperation();
            ClearPreviewOperationState();
            _activePreviewPath = null;
            CancelPredictivePrewarm();
            return;
        }

        if (!string.Equals(_activePreviewSha, Commit.Sha, StringComparison.Ordinal))
        {
            _activePreviewSha = Commit.Sha;
            _activePreviewPath = null;
            _activeVersion = null;
            StartPredictivePrewarm(Commit);
        }

        if (string.Equals(_resolvedForSha, Commit.Sha, StringComparison.Ordinal))
        {
            return;
        }

        _urlsByPath.Clear();
        var resolver = Services.GetRequiredService<IPathToUrlResolver>();
        foreach (var file in Commit.Files)
        {
            var urls = await resolver.ResolveAsync(file.Path, Language);
            _urlsByPath[file.Path] = urls;
        }
        _resolvedForSha = Commit.Sha;
    }

    /// <summary>
    /// Picks the right URL for the "WebView2 で開く" button on a single file row.
    /// Priority: (1) active local preview server + path mappable → http://localhost
    /// rewrite, (2) any resolver-supplied docs.github.com URL (relative paths are
    /// absolutised against <see cref="DocsApiOptions.BaseAddress"/>), (3) <c>null</c>
    /// → button hidden (the file is not a publishable content page).
    /// </summary>
    private Uri? ResolvePreviewTarget(CommitFile file)
    {
        var session = Services.GetService<PreviewSession>();
        var mapped = PreviewPathMapper.Map(file.Path, Language);
        if (mapped is not null && session is { IsActive: true } && session.ActivePort is { } port)
        {
            return new Uri(
                string.Create(System.Globalization.CultureInfo.InvariantCulture,
                    $"http://localhost:{port}{mapped}"),
                UriKind.Absolute);
        }
        return ResolveOfficialTarget(file);
    }

    private bool IsPreviewMappable(CommitFile file)
        => PreviewPathMapper.Map(file.Path, Language) is not null;

    private static bool IsMarkdownPreviewable(CommitFile file)
        => PreviewPathMapper.IsMarkdown(file.Path);

    private bool IsLocalComparisonPreviewable(CommitFile file)
        => IsPreviewMappable(file) || IsMarkdownPreviewable(file);

    private string BuildPreviewTitle(CommitFile file, Uri? currentTarget)
    {
        if (IsPreviewMappable(file))
        {
            return "変更前コミットと PR HEAD のローカルプレビューを並べて、このファイルを WebView2 で開きます";
        }
        if (IsMarkdownPreviewable(file))
        {
            return "Markdown をレンダリングして変更前コミットと PR HEAD の差分を WebView2 で開きます";
        }
        return currentTarget?.AbsoluteUri ?? "公式ドキュメントを WebView2 で開きます";
    }

    private string BuildPreviewButtonLabel(CommitFile file)
        => IsPreviewBusyFile(file)
            ? "起動中…"
            : IsActivePreviewFile(file)
                ? "表示中"
            : PreviewButtonLabel;

    private string BuildFileRowClass(CommitFile file)
    {
        var classes = new List<string> { "file-row" };
        if (IsActivePreviewFile(file))
        {
            classes.Add("preview-active");
        }
        if (IsPreviewBusyFile(file))
        {
            classes.Add("preview-busy");
        }
        return string.Join(' ', classes);
    }

    private bool IsActivePreviewFile(CommitFile file)
        => string.Equals(_activePreviewPath, file.Path, StringComparison.Ordinal);

    private bool IsPreviewBusyFile(CommitFile file)
        => Commit is not null
            && string.Equals(_previewBusySha, Commit.Sha, StringComparison.Ordinal)
            && string.Equals(_previewBusyPath, file.Path, StringComparison.Ordinal);

    private bool IsPreviewFeedbackFile(CommitFile file)
        => !_previewStatusIsCleanup
            && !string.IsNullOrWhiteSpace(_previewStatus)
            && Commit is not null
            && string.Equals(_previewStatusSha, Commit.Sha, StringComparison.Ordinal)
            && string.Equals(_previewStatusPath, file.Path, StringComparison.Ordinal);

    private PreviewFilePosition GetPreviewPosition(CommitFile file)
    {
        if (Commit is null || !IsLocalComparisonPreviewable(file))
        {
            return default;
        }

        var total = 0;
        var ordinal = 0;
        foreach (var candidate in Commit.Files)
        {
            if (!IsLocalComparisonPreviewable(candidate))
            {
                continue;
            }
            total++;
            if (string.Equals(candidate.Path, file.Path, StringComparison.Ordinal))
            {
                ordinal = total;
            }
        }

        return new PreviewFilePosition(ordinal, total);
    }

    private string BuildPreviewableFileCountLabel()
    {
        var count = CountLocalComparisonPreviewableFiles();
        return count > 0
            ? string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{count} 件を比較可能")
            : "比較可能なファイルなし";
    }

    private int CountLocalComparisonPreviewableFiles()
        => Commit?.Files.Count(IsLocalComparisonPreviewable) ?? 0;

    private async Task OpenInWebViewAsync(CommitFile file)
        => await OpenInWebViewAsync(file, version: null);

    private Task OpenCommitDiffInWebViewAsync(string url)
    {
        if (Services.GetService<IPreviewNavigator>() is not { } navigator
            || !Uri.TryCreate(url, UriKind.Absolute, out var uri))
        {
            return Task.CompletedTask;
        }

        navigator.Publish(uri);
        _activePreviewPath = null;
        _activeVersion = null;
        _previewStatus = $"PR #{Commit?.PrNumber.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty} のコミット差分を右ペインで開きました";
        return Task.CompletedTask;
    }

    private async Task OpenInWebViewAsync(CommitFile file, DocsVersion? version)
    {
        var navigator = Services.GetService<IPreviewNavigator>();
        if (navigator is null || IsPreviewOperationBusy)
        {
            return;
        }

        var commit = Commit;

        if (commit is not null && IsPreviewMappable(file) && !IsMarkdownPreviewable(file)
            && Services.GetService<IPreviewCoordinator>() is { } coordinator)
        {
            // Step 19.7: Markdown ファイルは下の Markdig 経路に流す。ここに来るのは
            // content/ 配下で .md/.markdown 以外の公開対象 (現状は事実上存在しない)
            // のみで、将来 YAML データファイル等を公開した場合の保険として残す。
            var operation = StartPreviewOperation(commit.Sha, file.Path, $"{file.Path} のローカルプレビューを準備中…", "プレビュー起動");
            var token = operation.Cancellation.Token;
            var host = Services.GetService<PreviewServerHost>();
            operation.PollTask = Task.Run(
                () => PollPreviewProgressAsync(host, includePreviewServerState: host is not null, token),
                CancellationToken.None);
            try
            {
                var progress = new Progress<string>(message =>
                {
                    _ = InvokeAsync(() =>
                    {
                        _previewStatus = message;
                        StateHasChanged();
                    });
                });
                var link = await coordinator.PrepareComparisonPreviewAsync(
                    commit.PrNumber,
                    commit.Sha,
                    file.Path,
                    progress,
                    token);
                if (link is not null)
                {
                    if (!CanPublishPreview(operation, commit.Sha))
                    {
                        return;
                    }

                    var previewPosition = GetPreviewPosition(file);
                    navigator.PublishComparison(new PreviewComparisonRequest(
                        link.BeforeUrl,
                        link.AfterUrl,
                        $"変更前 {ShortSha(link.BeforeSha)} localhost",
                        $"PR HEAD {ShortSha(link.AfterSha)} localhost",
                        file.Path,
                        previewPosition.Ordinal,
                        previewPosition.Total));
                    _activePreviewPath = file.Path;
                    _previewStatus = $"{file.Path} を変更前 / PR HEAD で比較表示しました";
                    return;
                }
                if (CanUpdatePreviewFeedback(operation))
                {
                    _previewStatus = "プレビュー機能は無効です (DocsRepository 未設定)";
                }
                return;
            }
            catch (OperationCanceledException)
            {
                if (CanUpdatePreviewFeedback(operation))
                {
                    _previewStatus = BuildPreviewCancellationStatus(operation);
                }
                return;
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                if (CanUpdatePreviewFeedback(operation))
                {
                    _previewStatus = ex.Message;
                }
                return;
            }
            finally
            {
                await FinishPreviewOperationAsync(operation);
            }
        }

        if (commit is not null && IsMarkdownPreviewable(file)
            && Services.GetService<IPreviewCoordinator>() is { } markdownCoordinator)
        {
            var operation = StartPreviewOperation(commit.Sha, file.Path, $"{file.Path} を Markdown として比較準備中…", "プレビュー起動");
            var token = operation.Cancellation.Token;
            var host = Services.GetService<PreviewServerHost>();
            operation.PollTask = Task.Run(
                () => PollPreviewProgressAsync(host, includePreviewServerState: host is not null, token),
                CancellationToken.None);
            try
            {
                var progress = new Progress<string>(message =>
                {
                    _ = InvokeAsync(() =>
                    {
                        _previewStatus = message;
                        StateHasChanged();
                    });
                });
                var link = await markdownCoordinator.PrepareMarkdownComparisonPreviewAsync(
                    commit.PrNumber,
                    commit.Sha,
                    file.Path,
                    progress,
                    version: version,
                    cancellationToken: token);
                if (link is not null)
                {
                    if (!CanPublishPreview(operation, commit.Sha))
                    {
                        return;
                    }

                    var previewPosition = GetPreviewPosition(file);
                    navigator.PublishComparison(new PreviewComparisonRequest(
                        link.BeforeUrl,
                        link.AfterUrl,
                        $"変更前 {ShortSha(link.BeforeSha)} Markdown",
                        $"PR HEAD {ShortSha(link.AfterSha)} Markdown",
                        file.Path,
                        previewPosition.Ordinal,
                        previewPosition.Total,
                        CurrentVersion: link.CurrentVersion,
                        AffectedVersions: link.AffectedVersions));
                    _activePreviewPath = file.Path;
                    _activeVersion = link.CurrentVersion;
                    _previewStatus = $"{file.Path} を Markdown として変更前 / PR HEAD で比較表示しました";
                    return;
                }
                if (CanUpdatePreviewFeedback(operation))
                {
                    _previewStatus = "プレビュー機能は無効です (DocsRepository 未設定)";
                }
                return;
            }
            catch (OperationCanceledException)
            {
                if (CanUpdatePreviewFeedback(operation))
                {
                    _previewStatus = BuildPreviewCancellationStatus(operation);
                }
                return;
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                if (CanUpdatePreviewFeedback(operation))
                {
                    _previewStatus = ex.Message;
                }
                return;
            }
            finally
            {
                await FinishPreviewOperationAsync(operation);
            }
        }

        if (ResolvePreviewTarget(file) is { } activeTarget
            && string.Equals(activeTarget.Scheme, Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase)
            && string.Equals(activeTarget.Host, "localhost", StringComparison.OrdinalIgnoreCase))
        {
            navigator.Publish(activeTarget);
            _activePreviewPath = file.Path;
            _previewStatus = null;
            _previewStatusIsCleanup = false;
            return;
        }

        if (ResolveOfficialTarget(file) is { } officialTarget)
        {
            navigator.Publish(officialTarget);
            _activePreviewPath = file.Path;
            _previewStatus = null;
            _previewStatusIsCleanup = false;
            return;
        }

        _previewStatus = "このファイルは公開ドキュメント URL に対応していません";
        _previewStatusIsCleanup = false;
        _previewStatusPath = file.Path;
    }

    private PreviewOperation StartPreviewOperation(string? sha, string? busyPath, string status, string cancellationSubject)
    {
        CancelCurrentPreviewOperation();

        var operation = new PreviewOperation(
            ++_previewOperationSerial,
            sha,
            new CancellationTokenSource(),
            cancellationSubject);
        _previewOperation = operation;
        _previewBusyPath = busyPath;
        _previewBusySha = sha;
        _previewStatusPath = busyPath;
        _previewStatusSha = sha;
        _previewCleanupBusy = busyPath is null;
        _previewCanceling = false;
        _previewStatus = status;
        _previewStatusIsCleanup = _previewCleanupBusy;
        _previewStdoutTail = new List<string>();
        _previewStderrTail = new List<string>();
        _previewPid = null;
        _previewStartedAt = DateTimeOffset.UtcNow;
        _previewElapsedSec = 0;
        _previewTimeoutSec = Services.GetService<IOptions<DocsRepositoryOptions>>()?.Value.PreviewReadyTimeoutSeconds ?? 600;
        ArmPreviewTimeout(operation.Cancellation);
        return operation;
    }

    private async Task FinishPreviewOperationAsync(PreviewOperation operation)
    {
        try { operation.Cancellation.Cancel(); } catch (ObjectDisposedException) { }
        if (operation.PollTask is not null)
        {
            try { await operation.PollTask.ConfigureAwait(false); }
            catch (OperationCanceledException) { }
        }
        operation.Cancellation.Dispose();
        if (ReferenceEquals(_previewOperation, operation))
        {
            _previewOperation = null;
            _previewBusyPath = null;
            _previewBusySha = null;
            _previewCleanupBusy = false;
            _previewCanceling = false;
        }
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private void CancelCurrentPreviewOperation()
    {
        try { _previewOperation?.Cancellation.Cancel(); } catch (ObjectDisposedException) { }
    }

    private void ClearPreviewOperationState()
    {
        _previewOperation = null;
        _previewBusyPath = null;
        _previewBusySha = null;
        _previewCleanupBusy = false;
        _previewStatusPath = null;
        _previewStatusSha = null;
        _previewStatus = null;
        _previewCanceling = false;
    }

    private bool CanPublishPreview(PreviewOperation operation, string sha)
        => ReferenceEquals(_previewOperation, operation)
            && Commit is not null
            && string.Equals(Commit.Sha, sha, StringComparison.Ordinal);

    private bool CanUpdatePreviewFeedback(PreviewOperation operation)
        => ReferenceEquals(_previewOperation, operation);

    private async Task CleanupPreviewCacheAsync()
    {
        if (IsPreviewOperationBusy)
        {
            return;
        }
        var operation = StartPreviewOperation(sha: null, busyPath: null, "キャッシュをクリーンアップ中…", "キャッシュ削除");
        var token = operation.Cancellation.Token;
        operation.PollTask = Task.Run(
            () => PollPreviewProgressAsync(host: null, includePreviewServerState: false, token),
            CancellationToken.None);
        try
        {
            if (Services.GetService<IPreviewCoordinator>() is not { } coordinator)
            {
                _previewStatus = "プレビュー機能は無効です (DocsRepository 未設定)";
                return;
            }
            var removed = await coordinator.CleanupCacheAsync(token);
            _previewStatus = string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{removed} 件の worktree を削除しました");
        }
        catch (OperationCanceledException)
        {
            if (CanUpdatePreviewFeedback(operation))
            {
                _previewStatus = BuildPreviewCancellationStatus(operation);
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            if (CanUpdatePreviewFeedback(operation))
            {
                _previewStatus = ex.Message;
            }
        }
        finally
        {
            await FinishPreviewOperationAsync(operation);
        }
    }

    private Task CancelPreviewAsync()
    {
        if (!IsPreviewOperationBusy || _previewOperation is null || _previewCanceling)
        {
            return Task.CompletedTask;
        }
        _previewCanceling = true;
        try { _previewOperation.Cancellation.Cancel(); } catch (ObjectDisposedException) { }
        return Task.CompletedTask;
    }

    private void ArmPreviewTimeout(CancellationTokenSource cts)
    {
        if (_previewTimeoutSec > 0)
        {
            cts.CancelAfter(TimeSpan.FromSeconds(_previewTimeoutSec));
        }
    }

    private string BuildPreviewCancellationStatus(PreviewOperation operation)
        => _previewCanceling
            ? $"{operation.CancellationSubject}を中止しました"
            : $"{operation.CancellationSubject}が上限 {_previewTimeoutSec} 秒を超えたため中止しました";

    private async Task PollPreviewProgressAsync(PreviewServerHost? host, bool includePreviewServerState, CancellationToken token)
    {
        try
        {
            using var timer = new PeriodicTimer(PollInterval);
            while (await timer.WaitForNextTickAsync(token).ConfigureAwait(false))
            {
                var stdoutTail = includePreviewServerState && host is not null
                    ? TakeTail(host.RecentStdoutLines, MaxLogTailLines)
                    : _previewStdoutTail;
                var stderrTail = includePreviewServerState && host is not null
                    ? TakeTail(host.RecentStderrLines, MaxLogTailLines)
                    : _previewStderrTail;
                var pid = includePreviewServerState && host is not null
                    ? host.CurrentProcessId
                    : _previewPid;
                var elapsed = (int)(DateTimeOffset.UtcNow - _previewStartedAt).TotalSeconds;
                await InvokeAsync(() =>
                {
                    _previewStdoutTail = stdoutTail;
                    _previewStderrTail = stderrTail;
                    _previewPid = pid;
                    _previewElapsedSec = elapsed;
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // expected when startup completes or the user cancels
        }
    }

    private static List<string> TakeTail(IReadOnlyList<string> source, int take)
    {
        if (source.Count <= take)
        {
            return new List<string>(source);
        }
        var result = new List<string>(take);
        for (var i = source.Count - take; i < source.Count; i++)
        {
            result.Add(source[i]);
        }
        return result;
    }

    private void StartPredictivePrewarm(Commit commit)
    {
        CancelPredictivePrewarm();
        if (commit.PrNumber <= 0
            || string.IsNullOrEmpty(commit.Sha)
            || Services.GetService<IPreviewCoordinator>() is not { } coordinator)
        {
            return;
        }

        var cts = new CancellationTokenSource();
        _predictivePrewarmCts = cts;
        var prNumber = commit.PrNumber;
        var sha = commit.Sha;
        _ = Task.Run(async () =>
        {
            try
            {
                var prewarmTask = coordinator.PredictivePrewarmAsync(prNumber, sha, cts.Token);
                if (prewarmTask is not null)
                {
                    await prewarmTask.ConfigureAwait(false);
                }
            }
            catch (OperationCanceledException)
            {
            }
            catch (ObjectDisposedException)
            {
            }
        }, CancellationToken.None);
    }

    private void CancelPredictivePrewarm()
    {
        try { _predictivePrewarmCts?.Cancel(); } catch (ObjectDisposedException) { }
        _predictivePrewarmCts?.Dispose();
        _predictivePrewarmCts = null;
    }

    private Uri? ResolveOfficialTarget(CommitFile file)
    {
        if (!_urlsByPath.TryGetValue(file.Path, out var urls) || urls.Count == 0)
        {
            return null;
        }
        var first = urls[0];
        if (Uri.TryCreate(first, UriKind.Absolute, out var absolute))
        {
            return absolute;
        }
        var baseAddress = Services.GetService<IOptions<DocsApiOptions>>()?.Value.BaseAddress;
        return baseAddress is not null && Uri.TryCreate(baseAddress, first, out absolute)
            ? absolute
            : null;
    }

    private static string FormatStats(CommitFile file)
        => $"+{file.Additions} -{file.Deletions}";

    private static string ShortSha(string sha)
        => sha.Length <= 7 ? sha : sha[..7];

    private static string DisplayCommitMessage(string? message)
    {
        if (string.IsNullOrWhiteSpace(message))
        {
            return string.Empty;
        }

        foreach (var rawLine in message.Replace("\r\n", "\n", StringComparison.Ordinal).Split('\n'))
        {
            var line = rawLine.Trim();
            if (line.Length == 0 || IsCommitMessageTrailer(line))
            {
                continue;
            }
            return line;
        }
        return string.Empty;
    }

    private static bool IsCommitMessageTrailer(string line)
        => line.StartsWith("Co-authored-by:", StringComparison.OrdinalIgnoreCase)
            || line.StartsWith("Signed-off-by:", StringComparison.OrdinalIgnoreCase)
            || line.StartsWith("Reviewed-by:", StringComparison.OrdinalIgnoreCase)
            || line.StartsWith("Acked-by:", StringComparison.OrdinalIgnoreCase);

    private string BuildCommitDiffUrl(Commit commit)
    {
        var options = Services.GetService<IOptions<GitHubOptions>>()?.Value ?? new GitHubOptions();
        var owner = Uri.EscapeDataString(options.Owner.Trim());
        var repo = Uri.EscapeDataString(options.Repo.Trim());
        var sha = Uri.EscapeDataString(commit.Sha.Trim());
        return string.Create(
            System.Globalization.CultureInfo.InvariantCulture,
            $"https://github.com/{owner}/{repo}/commit/{sha}");
    }

    private readonly record struct PreviewFilePosition(int Ordinal, int Total);

    private static string FormatScore(double score)
        => score.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);

    private static IReadOnlyList<string>? TryParseAudience(string audienceJson)
    {
        if (string.IsNullOrWhiteSpace(audienceJson))
        {
            return null;
        }
        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<string[]>(audienceJson);
        }
        catch (System.Text.Json.JsonException)
        {
            return null;
        }
    }
