@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Options
@using System.Threading
@using RepoSyncRadar.Core.Models
@using RepoSyncRadar.Core.Options
@using RepoSyncRadar.Core.Services
@using RepoSyncRadar.Core.Services.Preview

@*
    CommitDetail — Phase 1 commit inspector. Shows the file list with +/- stats and any
    canonical docs.github.com URLs returned by IPathToUrlResolver. Also surfaces the
    LLM-produced Scoring (score / category / audience / summary / why) so the morning
    triage output is visible to the user. Diff rendering and Adopt/Reject actions live
    in sibling components.

    Each publishable file row carries a "WebView2 で開く" button. Clicking it starts
    the local PR-HEAD preview pipeline when needed, then navigates the right-side
    WebView2 to that exact file. If the local pipeline is disabled we fall back to
    the resolved docs.github.com URL. This realises DESIGN.md §1.2 / §4.1
    "公式ドキュメントとレンダリング上区別がつかない見た目で差分を検証" — the right pane
    is always the canonical look, only the source changes.
*@

<section class="radar-commit-detail" data-testid="commit-detail">
    @if (Commit is null)
    {
        <p class="empty" data-testid="commit-detail-empty">コミットを選択してください。</p>
    }
    else
    {
        <header class="commit-header">
            <span class="sha" data-testid="commit-detail-sha">@Commit.Sha</span>
            <span class="message" data-testid="commit-detail-message">@Commit.Message</span>
            <span class="author">@Commit.Author</span>
        </header>
        @if (Commit.Scoring is { } scoring)
        {
            var audience = TryParseAudience(scoring.AudienceJson);
            <section class="scoring" data-testid="commit-detail-scoring">
                <dl>
                    <dt>Score</dt>
                    <dd data-testid="commit-detail-score">@FormatScore(scoring.Score)</dd>
                    <dt>Category</dt>
                    <dd data-testid="commit-detail-category">@scoring.Category</dd>
                    @if (audience is { Count: > 0 })
                    {
                        <dt>Audience</dt>
                        <dd data-testid="commit-detail-audience">@string.Join(" / ", audience)</dd>
                    }
                    <dt>Summary</dt>
                    <dd data-testid="commit-detail-summary">@scoring.SummaryJa</dd>
                    <dt>Why</dt>
                    <dd data-testid="commit-detail-why">@scoring.WhyJa</dd>
                </dl>
            </section>
        }
        else
        {
            <p class="unscored" data-testid="commit-detail-unscored">未スコアリング (Morning Triage 未実行)</p>
        }
        <ul class="files">
            @foreach (var file in Commit.Files)
            {
                var previewTarget = ResolvePreviewTarget(file);
                var canOpenPreview = previewTarget is not null || IsLocalComparisonPreviewable(file);
                var previewPosition = GetPreviewPosition(file);
                var isActivePreview = IsActivePreviewFile(file);
                <li class="@BuildFileRowClass(file)" data-testid="commit-detail-file" data-path="@file.Path">
                    <span class="file-main">
                        @if (previewPosition.Ordinal > 0)
                        {
                            <span class="preview-file-index" title="プレビュー対象 @previewPosition.Ordinal / @previewPosition.Total">@previewPosition.Ordinal</span>
                        }
                        <span class="path">@file.Path</span>
                        @if (isActivePreview)
                        {
                            <span class="preview-active-badge">表示中</span>
                        }
                    </span>
                    <span class="stats"
                          data-testid="commit-detail-stats-@file.Path">@FormatStats(file)</span>
                    @if (canOpenPreview)
                    {
                        <button type="button"
                                class="open-in-webview"
                                data-testid="commit-detail-open-in-webview"
                                data-path="@file.Path"
                                disabled="@(_previewBusyPath is not null)"
                                title="@BuildPreviewTitle(file, previewTarget)"
                                @onclick="() => OpenInWebViewAsync(file)">@BuildPreviewButtonLabel(file)</button>
                    }
                    @if (_urlsByPath.TryGetValue(file.Path, out var urls) && urls.Count > 0)
                    {
                        <ul class="urls">
                            @foreach (var url in urls)
                            {
                                <li>
                                    <a href="@url" target="_blank" rel="noopener"
                                       data-testid="commit-detail-url">@url</a>
                                </li>
                            }
                        </ul>
                    }
                </li>
            }
        </ul>
        @if (_previewBusyPath is not null)
        {
            <div class="preview-progress" data-testid="commit-detail-preview-progress">
                <div class="preview-progress-row">
                    <span class="preview-spinner" aria-hidden="true"></span>
                    <span class="preview-progress-text" data-testid="commit-detail-preview-progress-text">
                        @(_previewStatus ?? "起動中…")
                        <span class="preview-progress-elapsed" data-testid="commit-detail-preview-progress-elapsed">
                            ・ @_previewElapsedSec 秒経過 / 上限 @_previewTimeoutSec 秒
                            @if (_previewPid is { } pid)
                            {
                                <span class="preview-progress-pid" data-testid="commit-detail-preview-progress-pid">・ PID @pid</span>
                            }
                        </span>
                    </span>
                    <button type="button"
                            data-testid="commit-detail-preview-cancel-button"
                            class="preview-cancel"
                            disabled="@_previewCanceling"
                            @onclick="CancelPreviewAsync">@(_previewCanceling ? "中止中…" : "中止")</button>
                </div>
                @if (_previewStdoutTail.Count > 0)
                {
                    <pre class="preview-log-tail preview-log-stdout" data-testid="commit-detail-preview-stdout">@string.Join('\n', _previewStdoutTail)</pre>
                }
                @if (_previewStderrTail.Count > 0)
                {
                    <pre class="preview-log-tail preview-log-stderr" data-testid="commit-detail-preview-stderr">@string.Join('\n', _previewStderrTail)</pre>
                }
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_previewStatus))
        {
            <p class="preview-status" data-testid="commit-detail-preview-status">@_previewStatus</p>
        }
    }
</section>

@code {
    private const string PreviewButtonLabel = "WebView2 で開く";
    private const int MaxLogTailLines = 10;
    private static readonly TimeSpan PollInterval = TimeSpan.FromMilliseconds(500);

    [CascadingParameter] public IServiceProvider Services { get; set; } = default!;

    [Parameter] public Commit? Commit { get; set; }

    [Parameter] public string Language { get; set; } = "en";

    private readonly Dictionary<string, IReadOnlyList<string>> _urlsByPath =
        new(StringComparer.Ordinal);

    private string? _resolvedForSha;
    private string? _previewBusyPath;
    private string? _activePreviewPath;
    private string? _previewStatus;
    private bool _previewCanceling;
    private CancellationTokenSource? _previewCts;
    private DateTimeOffset _previewStartedAt;
    private int _previewElapsedSec;
    private int _previewTimeoutSec = 600;
    private List<string> _previewStdoutTail = new();
    private List<string> _previewStderrTail = new();
    private int? _previewPid;
    private Task? _previewPollTask;

    protected override async Task OnParametersSetAsync()
    {
        if (Commit is null)
        {
            _urlsByPath.Clear();
            _resolvedForSha = null;
            _previewBusyPath = null;
            _activePreviewPath = null;
            _previewStatus = null;
            _previewCanceling = false;
            return;
        }

        if (string.Equals(_resolvedForSha, Commit.Sha, StringComparison.Ordinal))
        {
            return;
        }

        _activePreviewPath = null;
        _urlsByPath.Clear();
        var resolver = Services.GetRequiredService<IPathToUrlResolver>();
        foreach (var file in Commit.Files)
        {
            var urls = await resolver.ResolveAsync(file.Path, Language);
            _urlsByPath[file.Path] = urls;
        }
        _resolvedForSha = Commit.Sha;
    }

    /// <summary>
    /// Picks the right URL for the "WebView2 で開く" button on a single file row.
    /// Priority: (1) active local preview server + path mappable → http://localhost
    /// rewrite, (2) any resolver-supplied docs.github.com URL (relative paths are
    /// absolutised against <see cref="DocsApiOptions.BaseAddress"/>), (3) <c>null</c>
    /// → button hidden (the file is not a publishable content page).
    /// </summary>
    private Uri? ResolvePreviewTarget(CommitFile file)
    {
        var session = Services.GetService<PreviewSession>();
        var mapped = PreviewPathMapper.Map(file.Path, Language);
        if (mapped is not null && session is { IsActive: true } && session.ActivePort is { } port)
        {
            return new Uri(
                string.Create(System.Globalization.CultureInfo.InvariantCulture,
                    $"http://localhost:{port}{mapped}"),
                UriKind.Absolute);
        }
        return ResolveOfficialTarget(file);
    }

    private bool IsPreviewMappable(CommitFile file)
        => PreviewPathMapper.Map(file.Path, Language) is not null;

    private static bool IsMarkdownPreviewable(CommitFile file)
        => PreviewPathMapper.IsMarkdown(file.Path);

    private bool IsLocalComparisonPreviewable(CommitFile file)
        => IsPreviewMappable(file) || IsMarkdownPreviewable(file);

    private string BuildPreviewTitle(CommitFile file, Uri? currentTarget)
    {
        if (IsPreviewMappable(file))
        {
            return "変更前コミットと PR HEAD のローカルプレビューを並べて、このファイルを WebView2 で開きます";
        }
        if (IsMarkdownPreviewable(file))
        {
            return "Markdown をレンダリングして変更前コミットと PR HEAD の差分を WebView2 で開きます";
        }
        return currentTarget?.AbsoluteUri ?? "公式ドキュメントを WebView2 で開きます";
    }

    private string BuildPreviewButtonLabel(CommitFile file)
        => string.Equals(_previewBusyPath, file.Path, StringComparison.Ordinal)
            ? "起動中…"
            : IsActivePreviewFile(file)
                ? "表示中"
            : PreviewButtonLabel;

    private string BuildFileRowClass(CommitFile file)
    {
        var classes = new List<string> { "file-row" };
        if (IsActivePreviewFile(file))
        {
            classes.Add("preview-active");
        }
        if (string.Equals(_previewBusyPath, file.Path, StringComparison.Ordinal))
        {
            classes.Add("preview-busy");
        }
        return string.Join(' ', classes);
    }

    private bool IsActivePreviewFile(CommitFile file)
        => string.Equals(_activePreviewPath, file.Path, StringComparison.Ordinal);

    private PreviewFilePosition GetPreviewPosition(CommitFile file)
    {
        if (Commit is null || !IsLocalComparisonPreviewable(file))
        {
            return default;
        }

        var total = 0;
        var ordinal = 0;
        foreach (var candidate in Commit.Files)
        {
            if (!IsLocalComparisonPreviewable(candidate))
            {
                continue;
            }
            total++;
            if (string.Equals(candidate.Path, file.Path, StringComparison.Ordinal))
            {
                ordinal = total;
            }
        }

        return new PreviewFilePosition(ordinal, total);
    }

    private async Task OpenInWebViewAsync(CommitFile file)
    {
        var navigator = Services.GetService<IPreviewNavigator>();
        if (navigator is null || _previewBusyPath is not null)
        {
            return;
        }

        if (Commit is not null && IsPreviewMappable(file)
            && Services.GetService<IPreviewCoordinator>() is { } coordinator)
        {
            _previewBusyPath = file.Path;
            _previewCanceling = false;
            _previewStatus = $"{file.Path} のローカルプレビューを準備中…";
            _previewStdoutTail = new List<string>();
            _previewStderrTail = new List<string>();
            _previewPid = null;
            _previewStartedAt = DateTimeOffset.UtcNow;
            _previewElapsedSec = 0;
            _previewTimeoutSec = Services.GetService<IOptions<DocsRepositoryOptions>>()?.Value.PreviewReadyTimeoutSeconds ?? 600;
            _previewCts = new CancellationTokenSource();
            var token = _previewCts.Token;
            var host = Services.GetService<PreviewServerHost>();
            if (host is not null)
            {
                _previewPollTask = Task.Run(() => PollPreviewProgressAsync(host, token), CancellationToken.None);
            }
            try
            {
                var progress = new Progress<string>(message =>
                {
                    _ = InvokeAsync(() =>
                    {
                        _previewStatus = message;
                        StateHasChanged();
                    });
                });
                var link = await coordinator.PrepareComparisonPreviewAsync(
                    Commit.PrNumber,
                    Commit.Sha,
                    file.Path,
                    progress,
                    token);
                if (link is not null)
                {
                    var previewPosition = GetPreviewPosition(file);
                    navigator.PublishComparison(new PreviewComparisonRequest(
                        link.BeforeUrl,
                        link.AfterUrl,
                        $"変更前 {ShortSha(link.BeforeSha)} localhost",
                        $"PR HEAD {ShortSha(link.AfterSha)} localhost",
                        file.Path,
                        previewPosition.Ordinal,
                        previewPosition.Total));
                    _activePreviewPath = file.Path;
                    _previewStatus = $"{file.Path} を変更前 / PR HEAD で比較表示しました";
                    return;
                }
            }
            catch (OperationCanceledException)
            {
                _previewStatus = "プレビュー起動を中止しました";
                return;
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                _previewStatus = ex.Message;
                return;
            }
            finally
            {
                try { _previewCts?.Cancel(); } catch (ObjectDisposedException) { }
                if (_previewPollTask is not null)
                {
                    try { await _previewPollTask; }
                    catch (OperationCanceledException) { }
                    _previewPollTask = null;
                }
                _previewCts?.Dispose();
                _previewCts = null;
                _previewBusyPath = null;
                _previewCanceling = false;
            }
        }

        if (Commit is not null && IsMarkdownPreviewable(file)
            && Services.GetService<IPreviewCoordinator>() is { } markdownCoordinator)
        {
            _previewBusyPath = file.Path;
            _previewCanceling = false;
            _previewStatus = $"{file.Path} を Markdown として比較準備中…";
            _previewStdoutTail = new List<string>();
            _previewStderrTail = new List<string>();
            _previewPid = null;
            _previewStartedAt = DateTimeOffset.UtcNow;
            _previewElapsedSec = 0;
            _previewTimeoutSec = Services.GetService<IOptions<DocsRepositoryOptions>>()?.Value.PreviewReadyTimeoutSeconds ?? 600;
            _previewCts = new CancellationTokenSource();
            var token = _previewCts.Token;
            var host = Services.GetService<PreviewServerHost>();
            if (host is not null)
            {
                _previewPollTask = Task.Run(() => PollPreviewProgressAsync(host, token), CancellationToken.None);
            }
            try
            {
                var progress = new Progress<string>(message =>
                {
                    _ = InvokeAsync(() =>
                    {
                        _previewStatus = message;
                        StateHasChanged();
                    });
                });
                var link = await markdownCoordinator.PrepareMarkdownComparisonPreviewAsync(
                    Commit.PrNumber,
                    Commit.Sha,
                    file.Path,
                    progress,
                    token);
                if (link is not null)
                {
                    var previewPosition = GetPreviewPosition(file);
                    navigator.PublishComparison(new PreviewComparisonRequest(
                        link.BeforeUrl,
                        link.AfterUrl,
                        $"変更前 {ShortSha(link.BeforeSha)} Markdown",
                        $"PR HEAD {ShortSha(link.AfterSha)} Markdown",
                        file.Path,
                        previewPosition.Ordinal,
                        previewPosition.Total));
                    _activePreviewPath = file.Path;
                    _previewStatus = $"{file.Path} を Markdown として変更前 / PR HEAD で比較表示しました";
                    return;
                }
            }
            catch (OperationCanceledException)
            {
                _previewStatus = "プレビュー起動を中止しました";
                return;
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                _previewStatus = ex.Message;
                return;
            }
            finally
            {
                try { _previewCts?.Cancel(); } catch (ObjectDisposedException) { }
                if (_previewPollTask is not null)
                {
                    try { await _previewPollTask; }
                    catch (OperationCanceledException) { }
                    _previewPollTask = null;
                }
                _previewCts?.Dispose();
                _previewCts = null;
                _previewBusyPath = null;
                _previewCanceling = false;
            }
        }

        if (ResolvePreviewTarget(file) is { } activeTarget
            && string.Equals(activeTarget.Scheme, Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase)
            && string.Equals(activeTarget.Host, "localhost", StringComparison.OrdinalIgnoreCase))
        {
            navigator.Publish(activeTarget);
            _activePreviewPath = file.Path;
            _previewStatus = null;
            return;
        }

        if (ResolveOfficialTarget(file) is { } officialTarget)
        {
            navigator.Publish(officialTarget);
            _activePreviewPath = file.Path;
            _previewStatus = null;
            return;
        }

        _previewStatus = "このファイルは公開ドキュメント URL に対応していません";
    }

    private Task CancelPreviewAsync()
    {
        if (_previewBusyPath is null || _previewCts is null || _previewCanceling)
        {
            return Task.CompletedTask;
        }
        _previewCanceling = true;
        try { _previewCts.Cancel(); } catch (ObjectDisposedException) { }
        return Task.CompletedTask;
    }

    private async Task PollPreviewProgressAsync(PreviewServerHost host, CancellationToken token)
    {
        try
        {
            using var timer = new PeriodicTimer(PollInterval);
            while (await timer.WaitForNextTickAsync(token).ConfigureAwait(false))
            {
                var stdoutTail = TakeTail(host.RecentStdoutLines, MaxLogTailLines);
                var stderrTail = TakeTail(host.RecentStderrLines, MaxLogTailLines);
                var pid = host.CurrentProcessId;
                var elapsed = (int)(DateTimeOffset.UtcNow - _previewStartedAt).TotalSeconds;
                await InvokeAsync(() =>
                {
                    _previewStdoutTail = stdoutTail;
                    _previewStderrTail = stderrTail;
                    _previewPid = pid;
                    _previewElapsedSec = elapsed;
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // expected when startup completes or the user cancels
        }
    }

    private static List<string> TakeTail(IReadOnlyList<string> source, int take)
    {
        if (source.Count <= take)
        {
            return new List<string>(source);
        }
        var result = new List<string>(take);
        for (var i = source.Count - take; i < source.Count; i++)
        {
            result.Add(source[i]);
        }
        return result;
    }

    private Uri? ResolveOfficialTarget(CommitFile file)
    {
        if (!_urlsByPath.TryGetValue(file.Path, out var urls) || urls.Count == 0)
        {
            return null;
        }
        var first = urls[0];
        if (Uri.TryCreate(first, UriKind.Absolute, out var absolute))
        {
            return absolute;
        }
        var baseAddress = Services.GetService<IOptions<DocsApiOptions>>()?.Value.BaseAddress;
        return baseAddress is not null && Uri.TryCreate(baseAddress, first, out absolute)
            ? absolute
            : null;
    }

    private static string FormatStats(CommitFile file)
        => $"+{file.Additions} -{file.Deletions}";

    private static string ShortSha(string sha)
        => sha.Length <= 7 ? sha : sha[..7];

    private readonly record struct PreviewFilePosition(int Ordinal, int Total);

    private static string FormatScore(double score)
        => score.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);

    private static IReadOnlyList<string>? TryParseAudience(string audienceJson)
    {
        if (string.IsNullOrWhiteSpace(audienceJson))
        {
            return null;
        }
        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<string[]>(audienceJson);
        }
        catch (System.Text.Json.JsonException)
        {
            return null;
        }
    }
}
