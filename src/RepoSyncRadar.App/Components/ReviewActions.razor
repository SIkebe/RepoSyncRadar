@using Microsoft.Extensions.DependencyInjection
@using System.Globalization
@using RepoSyncRadar.Core.Data
@using RepoSyncRadar.Core.Models

@{ ApplyDisplayCultureForRender(); }

@*
    ReviewActions — Focus / Archive / Hold / Ignore Directory buttons for the selected
    commit. See IMPLEMENTATION_PLAN.md §Step 16. The component talks to IRadarRepository
    directly (not RadarWriteTools) so that users can act without requiring a Copilot
    session, and emits an IReviewBroadcaster event so the Sidebar updates immediately.
*@

<div class="radar-review-actions action-panel" data-testid="review-actions">
    <header class="action-panel-header">
        <div>
            <h3>@L["ReviewActions.Title"]</h3>
            <p>@L["ReviewActions.Description"]</p>
        </div>
    </header>

    <div class="review-primary-actions" data-testid="review-primary-actions">
        <button type="button"
                data-testid="review-adopt"
                class="review-button adopt"
                disabled="@_busy"
                @onclick="AdoptAsync">
            @L["ReviewActions.Watch"]
        </button>

        <button type="button"
                data-testid="review-later"
                class="review-button later"
                disabled="@_busy"
                @onclick="LaterAsync">
            @L["ReviewActions.Later"]
        </button>
    </div>

    <div class="review-reject-box">
        <label class="review-field-label" for="review-reject-reason">@L["ReviewActions.ArchiveReason"] <span>@L["ReviewActions.Required"]</span></label>
        @if (HasArchivedReason)
        {
            <div class="review-archived-reason" data-testid="review-archived-reason">
                <span>@L["ReviewActions.ArchivedReason"]</span>
                <strong>@ArchivedReason</strong>
            </div>
        }
        <div class="review-reject-presets" data-testid="review-reject-reason-options">
            @foreach (var reason in RejectReasonPresets)
            {
                var reasonLabel = L[reason.ResourceKey].Value;
                <button type="button"
                        class="@BuildRejectReasonPresetClass(reasonLabel)"
                        data-testid="review-reject-reason-option"
                        data-reason="@reasonLabel"
                        disabled="@_busy"
                        @onclick="() => SelectRejectReason(reasonLabel)">@reasonLabel</button>
            }
        </div>
        <div class="review-input-action">
            <input id="review-reject-reason"
                   type="text"
                   data-testid="review-reject-reason"
                   placeholder="@L["ReviewActions.ArchiveReasonPlaceholder"]"
                   value="@_rejectReason"
                   disabled="@_busy"
                   @oninput="OnRejectReasonChanged" />
            <button type="button"
                    data-testid="review-reject"
                    class="review-button reject"
                    disabled="@(_busy || string.IsNullOrWhiteSpace(_rejectReason))"
                    @onclick="ArchiveAsync">@L["ReviewActions.Archive"]</button>
        </div>
    </div>

    <details class="review-ignore-panel" data-testid="review-ignore-details">
        <summary>
            <span class="review-ignore-summary-main">
                <span class="review-ignore-chevron" aria-hidden="true">›</span>
                <span>@L["ReviewActions.IgnoreSimilarDirectories"]</span>
            </span>
            <span class="review-ignore-summary-meta">
                @if (_suggestedIgnorePatterns.Count > 0)
                {
                    <span class="review-ignore-summary-count" data-testid="review-ignore-summary-count">@L["ReviewActions.SuggestionCount", _suggestedIgnorePatterns.Count]</span>
                }
            </span>
        </summary>
        <div class="review-ignore-content">
            @if (_suggestedIgnorePatterns.Count > 0)
            {
                <div class="review-ignore-suggestions" data-testid="review-ignore-suggestions">
                    <span class="review-suggestions-label">@L["ReviewActions.Suggestions"]</span>
                    <div class="review-suggestion-list">
                        @foreach (var pattern in _suggestedIgnorePatterns)
                        {
                            <button type="button"
                                    class="@BuildSuggestionChipClass(pattern)"
                                    data-testid="review-ignore-suggestion"
                                    data-pattern="@pattern.Pattern"
                                    data-ignored="@pattern.IsAlreadyIgnored.ToString().ToLowerInvariant()"
                                    disabled="@(_busy || pattern.IsAlreadyIgnored)"
                                    @onclick="() => SelectIgnorePattern(pattern)">
                                <span class="review-suggestion-pattern">@pattern.Pattern</span>
                                <span class="review-suggestion-meta">@L["ReviewActions.MatchCount", pattern.MatchCount]</span>
                                @if (pattern.IgnoreState is not IgnorePatternState.Available)
                                {
                                    <span class="review-suggestion-state" data-testid="review-ignore-suggestion-state">@BuildSuggestionStateLabel(pattern.IgnoreState)</span>
                                }
                            </button>
                        }
                    </div>
                </div>
            }
            <label class="review-field-label" for="review-ignore-pattern">@L["ReviewActions.PathPattern"]</label>
            <div class="review-input-action">
                <input id="review-ignore-pattern"
                       type="text"
                       data-testid="review-ignore-pattern"
                       placeholder="@L["ReviewActions.PathPatternPlaceholder"]"
                       value="@_ignorePattern"
                       disabled="@_busy"
                       @oninput="OnIgnorePatternChanged" />
                <button type="button"
                        data-testid="review-ignore"
                        class="review-button ignore"
                        disabled="@(_busy || string.IsNullOrWhiteSpace(_ignorePattern))"
                        @onclick="IgnoreDirectoryAsync">@L["ReviewActions.AddToIgnoreList"]</button>
            </div>
        </div>
    </details>

    <details class="review-ignore-panel review-boost-panel" data-testid="review-boost-details">
        <summary>
            <span class="review-ignore-summary-main">
                <span class="review-ignore-chevron" aria-hidden="true">›</span>
                <span>@L["ReviewActions.BoostSimilarDirectories"]</span>
            </span>
            <span class="review-ignore-summary-meta">
                @if (_suggestedBoostPatterns.Count > 0)
                {
                    <span class="review-ignore-summary-count" data-testid="review-boost-summary-count">@L["ReviewActions.SuggestionCount", _suggestedBoostPatterns.Count]</span>
                }
            </span>
        </summary>
        <div class="review-ignore-content review-boost-content">
            @if (_suggestedBoostPatterns.Count > 0)
            {
                <div class="review-ignore-suggestions" data-testid="review-boost-suggestions">
                    <span class="review-suggestions-label">@L["ReviewActions.Suggestions"]</span>
                    <div class="review-suggestion-list">
                        @foreach (var pattern in _suggestedBoostPatterns)
                        {
                            <button type="button"
                                    class="@BuildBoostSuggestionChipClass(pattern)"
                                    data-testid="review-boost-suggestion"
                                    data-pattern="@pattern.Pattern"
                                    data-boosted="@pattern.IsAlreadyRegistered.ToString().ToLowerInvariant()"
                                    disabled="@(_busy || pattern.IsAlreadyRegistered)"
                                    @onclick="() => SelectBoostPattern(pattern.Pattern)">
                                <span class="review-suggestion-pattern">@pattern.Pattern</span>
                                <span class="review-suggestion-meta">@L["ReviewActions.MatchCount", pattern.MatchCount]</span>
                                @if (pattern.State is not BoostPatternState.Available)
                                {
                                    <span class="review-suggestion-state" data-testid="review-boost-suggestion-state">@BuildBoostSuggestionStateLabel(pattern)</span>
                                }
                            </button>
                        }
                    </div>
                </div>
            }
            <label class="review-field-label" for="review-boost-pattern">@L["ReviewActions.BoostPathPattern"]</label>
            <div class="review-input-action">
                <input id="review-boost-pattern"
                       type="text"
                       data-testid="review-boost-pattern"
                       placeholder="@L["ReviewActions.BoostPathPatternPlaceholder"]"
                       value="@_boostPattern"
                       disabled="@_busy"
                       @oninput="OnBoostPatternChanged" />
            </div>
            <div class="review-boost-options">
                <label class="review-boost-field" for="review-boost-delta">
                    <span>@L["ReviewActions.BoostDelta"]</span>
                    <input id="review-boost-delta"
                           type="text"
                           data-testid="review-boost-delta"
                           value="@_boostDelta"
                           disabled="@_busy"
                           @oninput="OnBoostDeltaChanged" />
                    <small data-testid="review-boost-delta-help">@L["ReviewActions.BoostScoreAdjustmentHelp"]</small>
                </label>
                <div class="review-boost-presets" data-testid="review-boost-delta-presets">
                    @foreach (var preset in BoostRuleDeltaPresets)
                    {
                        <button type="button"
                                class="toolbar-button compact secondary"
                                data-testid="review-boost-delta-preset"
                                disabled="@_busy"
                                @onclick="() => SelectBoostDeltaPreset(preset)">@FormatBoostDelta(preset)</button>
                    }
                </div>
                <label class="review-boost-field review-boost-reason" for="review-boost-reason">
                    <span>@L["ReviewActions.BoostReason"]</span>
                    <input id="review-boost-reason"
                           type="text"
                           data-testid="review-boost-reason"
                           placeholder="@L["ReviewActions.BoostReasonPlaceholder"]"
                           value="@_boostReason"
                           disabled="@_busy"
                           @oninput="OnBoostReasonChanged" />
                </label>
                <button type="button"
                        data-testid="review-boost"
                        class="review-button boost"
                        disabled="@(_busy || string.IsNullOrWhiteSpace(_boostPattern))"
                        @onclick="BoostDirectoryAsync">@L["ReviewActions.AddToBoostRules"]</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_boostError))
            {
                <p class="review-action-error" data-testid="review-boost-error">@_boostError</p>
            }
            @if (!string.IsNullOrWhiteSpace(_boostStatus))
            {
                <p class="review-action-status" data-testid="review-boost-status">@_boostStatus</p>
            }
        </div>
    </details>
</div>

@code {
    [CascadingParameter] public IServiceProvider Services { get; set; } = default!;

    [CascadingParameter] public string DisplayCulture { get; set; } = AppDisplayCulture.DefaultCultureName;

    private IStringLocalizer<SharedResource>? _localizer;
    private IStringLocalizer<SharedResource> L => _localizer ??= Services.GetRequiredService<IStringLocalizer<SharedResource>>();

    [Parameter] public string? Sha { get; set; }

    [Parameter] public ReviewStatus? CurrentStatus { get; set; }

    [Parameter] public string? CurrentReviewReason { get; set; }

    [Parameter] public IReadOnlyList<string> FilePaths { get; set; } = [];

    [Parameter] public EventCallback<ReviewStatus> Reviewed { get; set; }

    private const int MaxSuggestedIgnorePatterns = 6;
    private const int MaxSuggestedBoostPatterns = 6;
    private const string DefaultBoostRuleDeltaText = "1";
    private static readonly double[] BoostRuleDeltaPresets = [1, 2, 3, 0.5, -1];
    private static readonly IReadOnlyList<RejectReasonPreset> RejectReasonPresets =
    [
        new("ReviewActions.Reason.OutOfScope"),
        new("ReviewActions.Reason.AlreadyReviewed"),
        new("ReviewActions.Reason.ExistingInformationOnly"),
        new("ReviewActions.Reason.Duplicate"),
        new("ReviewActions.Reason.MinorWordingChange"),
        new("ReviewActions.Reason.GeneratedDiff"),
        new("ReviewActions.Reason.NoFollowUpNeeded"),
    ];
    private string _rejectReason = string.Empty;
    private string _ignorePattern = string.Empty;
    private List<IgnorePatternSuggestion> _suggestedIgnorePatterns = [];
    private IReadOnlyList<string> _existingIgnorePatterns = [];
    private string _boostPattern = string.Empty;
    private string _boostDelta = DefaultBoostRuleDeltaText;
    private string _boostReason = string.Empty;
    private string? _boostError;
    private string? _boostStatus;
    private List<BoostPatternSuggestion> _suggestedBoostPatterns = [];
    private IReadOnlyList<string> _existingBoostPatterns = [];
    private bool _busy;
    private bool HasArchivedReason => CurrentStatus == ReviewStatus.Archived && !string.IsNullOrWhiteSpace(CurrentReviewReason);
    private string ArchivedReason => CurrentReviewReason?.Trim() ?? string.Empty;

    private void ApplyDisplayCultureForRender()
        => AppDisplayCulture.Apply(DisplayCulture);

    protected override async Task OnInitializedAsync()
    {
        await LoadExistingIgnorePatternsAsync();
        await LoadExistingBoostPatternsAsync();
    }

    protected override void OnParametersSet()
    {
        _suggestedIgnorePatterns = BuildIgnorePatternSuggestions(FilePaths, _existingIgnorePatterns);
        _suggestedBoostPatterns = BuildBoostPatternSuggestions(FilePaths, _existingBoostPatterns);
    }

    private async Task LoadExistingIgnorePatternsAsync()
    {
        try
        {
            var repo = Services.GetRequiredService<IRadarRepository>();
            var rulesTask = repo.GetIgnoreRulesAsync(CancellationToken.None);
            IReadOnlyList<IgnoreRule> rules = rulesTask is null
                ? Array.Empty<IgnoreRule>()
                : await rulesTask;
            _existingIgnorePatterns = rules
                .Select(static rule => NormalizePattern(rule.Pattern))
                .Where(static pattern => !string.IsNullOrEmpty(pattern))
                .Distinct(StringComparer.Ordinal)
                .ToArray();
            _suggestedIgnorePatterns = BuildIgnorePatternSuggestions(FilePaths, _existingIgnorePatterns);
        }
        catch
        {
            _existingIgnorePatterns = [];
        }
    }

    private void OnRejectReasonChanged(ChangeEventArgs e)
        => _rejectReason = e.Value as string ?? string.Empty;

    private void OnIgnorePatternChanged(ChangeEventArgs e)
        => _ignorePattern = e.Value as string ?? string.Empty;

    private void OnBoostPatternChanged(ChangeEventArgs e)
    {
        _boostPattern = e.Value as string ?? string.Empty;
        ClearBoostMessages();
    }

    private void OnBoostDeltaChanged(ChangeEventArgs e)
    {
        _boostDelta = e.Value as string ?? string.Empty;
        ClearBoostMessages();
    }

    private void OnBoostReasonChanged(ChangeEventArgs e)
    {
        _boostReason = e.Value as string ?? string.Empty;
        ClearBoostMessages();
    }

    private void SelectRejectReason(string reason)
        => _rejectReason = reason;

    private void SelectIgnorePattern(IgnorePatternSuggestion suggestion)
    {
        if (suggestion.IgnoreState is not IgnorePatternState.Available)
        {
            return;
        }

        _ignorePattern = suggestion.Pattern;
    }

    private void SelectBoostPattern(string pattern)
    {
        _boostPattern = pattern;
        ClearBoostMessages();
    }

    private void SelectBoostDeltaPreset(double delta)
    {
        _boostDelta = delta.ToString("0.###", CultureInfo.CurrentCulture);
        ClearBoostMessages();
    }

    private void ClearBoostMessages()
    {
        _boostError = null;
        _boostStatus = null;
    }

    private string BuildRejectReasonPresetClass(string reason)
        => string.Equals(_rejectReason, reason, StringComparison.Ordinal)
            ? "review-reason-chip active"
            : "review-reason-chip";

    private static string BuildSuggestionChipClass(IgnorePatternSuggestion suggestion)
        => suggestion.IsAlreadyIgnored
            ? "review-suggestion-chip already-ignored"
            : "review-suggestion-chip";

    private static string BuildBoostSuggestionChipClass(BoostPatternSuggestion suggestion)
        => suggestion.IsAlreadyRegistered
            ? "review-suggestion-chip already-ignored"
            : "review-suggestion-chip";

    private string BuildSuggestionStateLabel(IgnorePatternState state)
        => state switch
        {
            IgnorePatternState.Registered => L["ReviewActions.Suggestion.Registered"],
            IgnorePatternState.Covered => L["ReviewActions.Suggestion.Covered"],
            _ => string.Empty,
        };

    private string BuildBoostSuggestionStateLabel(BoostPatternSuggestion suggestion)
        => suggestion.State switch
        {
            BoostPatternState.Registered => L["ReviewActions.Suggestion.Registered"],
            BoostPatternState.BroaderRule => L["ReviewActions.Suggestion.BroaderBoostRule"],
            _ => string.Empty,
        };

    private async Task AdoptAsync()
        => await SetReviewAsync(ReviewStatus.Adopted, reason: null);

    private async Task ArchiveAsync()
    {
        if (string.IsNullOrWhiteSpace(_rejectReason)) return;
        await SetReviewAsync(ReviewStatus.Archived, _rejectReason);
        _rejectReason = string.Empty;
    }

    private async Task LaterAsync()
        => await SetReviewAsync(ReviewStatus.Later, reason: null);

    private async Task SetReviewAsync(ReviewStatus status, string? reason)
    {
        if (string.IsNullOrEmpty(Sha) || _busy) return;
        _busy = true;
        try
        {
            var repo = Services.GetRequiredService<IRadarRepository>();
            await repo.SetReviewAsync(Sha, status, reason);
            Services.GetRequiredService<IReviewBroadcaster>().Publish();
            await Reviewed.InvokeAsync(status);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task IgnoreDirectoryAsync()
    {
        var pattern = _ignorePattern.Trim();
        if (string.IsNullOrEmpty(pattern) || _busy) return;
        _busy = true;
        try
        {
            var repo = Services.GetRequiredService<IRadarRepository>();
            await repo.AddIgnoreRuleAsync(pattern, reason: "ignore-directory");
            var prefix = pattern.TrimEnd('*', '/');
            if (!string.IsNullOrEmpty(prefix))
            {
                await repo.BulkRejectByPathPrefixAsync(prefix, reason: "auto-ignored");
            }
            Services.GetRequiredService<IReviewBroadcaster>().Publish();
            _ignorePattern = string.Empty;
            await Reviewed.InvokeAsync(ReviewStatus.Rejected);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task BoostDirectoryAsync()
    {
        var pattern = _boostPattern.Trim();
        if (pattern.Length == 0 || _busy)
        {
            return;
        }

        if (!TryParseBoostDelta(_boostDelta, out var delta))
        {
            _boostError = L["Settings.BoostRules.Validation.DeltaInvalid"];
            _boostStatus = null;
            return;
        }

        if (!BoostRuleLimits.IsValidDelta(delta))
        {
            _boostError = L["Settings.BoostRules.Validation.DeltaRange", BoostRuleLimits.DeltaMin, BoostRuleLimits.DeltaMax];
            _boostStatus = null;
            return;
        }

        _busy = true;
        _boostError = null;
        _boostStatus = null;
        try
        {
            var reason = string.IsNullOrWhiteSpace(_boostReason) ? null : _boostReason.Trim();
            var repo = Services.GetRequiredService<IRadarRepository>();
            var added = await repo.AddBoostRuleAsync(pattern, delta, reason, CancellationToken.None);
            if (!added)
            {
                _boostError = L["Settings.BoostRules.Validation.Duplicate", pattern];
                return;
            }

            await LoadExistingBoostPatternsAsync();
            _boostPattern = string.Empty;
            _boostDelta = DefaultBoostRuleDeltaText;
            _boostReason = string.Empty;
            _boostStatus = L["ReviewActions.BoostRuleAdded", pattern];
        }
        catch (Exception ex)
        {
            _boostError = $"{L["Settings.BoostRules.AddFailed"]}: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private static List<IgnorePatternSuggestion> BuildIgnorePatternSuggestions(
        IReadOnlyList<string> filePaths,
        IReadOnlyList<string> existingIgnorePatterns)
    {
        var normalizedPaths = filePaths
            .Select(NormalizePath)
            .Where(static path => !string.IsNullOrEmpty(path))
            .Distinct(StringComparer.Ordinal)
            .ToArray();
        var suggestions = new HashSet<string>(StringComparer.Ordinal);

        foreach (var normalized in normalizedPaths)
        {
            AddSuggestionsForPath(suggestions, normalized);
        }

        return suggestions
            .Select(pattern => new IgnorePatternSuggestion(
                pattern,
                CountMatchingPaths(pattern, normalizedPaths),
                GetIgnorePatternState(pattern, existingIgnorePatterns)))
            .Where(static suggestion => suggestion.MatchCount > 0)
            .OrderBy(static suggestion => suggestion.IsAlreadyIgnored)
            .ThenByDescending(static suggestion => suggestion.MatchCount)
            .ThenByDescending(static suggestion => CountPathSegments(suggestion.Pattern))
            .ThenBy(static suggestion => suggestion.Pattern, StringComparer.Ordinal)
            .Take(MaxSuggestedIgnorePatterns)
            .ToList();
    }

    private static List<BoostPatternSuggestion> BuildBoostPatternSuggestions(
        IReadOnlyList<string> filePaths,
        IReadOnlyList<string> existingBoostPatterns)
    {
        var normalizedPaths = filePaths
            .Select(NormalizePath)
            .Where(static path => !string.IsNullOrEmpty(path))
            .Distinct(StringComparer.Ordinal)
            .ToArray();
        var suggestions = new HashSet<string>(StringComparer.Ordinal);

        foreach (var normalized in normalizedPaths)
        {
            AddSuggestionsForPath(suggestions, normalized);
        }

        return suggestions
            .Select(pattern => new BoostPatternSuggestion(
                pattern,
                CountMatchingPaths(pattern, normalizedPaths),
                GetBoostPatternState(pattern, existingBoostPatterns)))
            .Where(static suggestion => suggestion.MatchCount > 0)
            .OrderBy(static suggestion => suggestion.IsAlreadyRegistered)
            .ThenByDescending(static suggestion => suggestion.MatchCount)
            .ThenByDescending(static suggestion => CountPathSegments(suggestion.Pattern))
            .ThenBy(static suggestion => suggestion.Pattern, StringComparer.Ordinal)
            .Take(MaxSuggestedBoostPatterns)
            .ToList();
    }

    private static void AddSuggestionsForPath(HashSet<string> suggestions, string normalized)
    {
        var parts = normalized.Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length < 2)
        {
            return;
        }

        var directoryParts = parts[..^1];
        AddSuggestion(suggestions, string.Join("/", directoryParts) + "/**");

        if (directoryParts.Length >= 3)
        {
            AddSuggestion(suggestions, string.Join("/", directoryParts[..3]) + "/**");
        }

        if (directoryParts.Length >= 2)
        {
            AddSuggestion(suggestions, string.Join("/", directoryParts[..2]) + "/**");
        }
    }

    private static int CountMatchingPaths(string pattern, IReadOnlyList<string> normalizedPaths)
    {
        var prefix = pattern.TrimEnd('*', '/');
        return normalizedPaths.Count(path => path.Equals(prefix, StringComparison.Ordinal)
            || path.StartsWith(prefix + "/", StringComparison.Ordinal));
    }

    private static int CountPathSegments(string pattern)
        => pattern.Split('/', StringSplitOptions.RemoveEmptyEntries).Length;

    private static string NormalizePath(string path)
        => path.Replace('\\', '/').Trim().Trim('/');

    private static string NormalizePattern(string pattern)
        => pattern.Replace('\\', '/').Trim().Trim('/');

    private static IgnorePatternState GetIgnorePatternState(
        string candidatePattern,
        IReadOnlyList<string> existingIgnorePatterns)
    {
        var normalizedCandidate = NormalizePattern(candidatePattern);
        if (existingIgnorePatterns.Contains(normalizedCandidate, StringComparer.Ordinal))
        {
            return IgnorePatternState.Registered;
        }

        var candidatePrefix = GetRulePrefix(normalizedCandidate);
        if (string.IsNullOrEmpty(candidatePrefix))
        {
            return IgnorePatternState.Available;
        }

        foreach (var existingPattern in existingIgnorePatterns)
        {
            var existingPrefix = GetRulePrefix(existingPattern);
            if (string.IsNullOrEmpty(existingPrefix))
            {
                continue;
            }

            if (candidatePrefix.StartsWith(existingPrefix + "/", StringComparison.Ordinal))
            {
                return IgnorePatternState.Covered;
            }
        }

        return IgnorePatternState.Available;
    }

    private static BoostPatternState GetBoostPatternState(
        string candidatePattern,
        IReadOnlyList<string> existingBoostPatterns)
    {
        var normalizedCandidate = NormalizePattern(candidatePattern);
        if (existingBoostPatterns.Contains(normalizedCandidate, StringComparer.Ordinal))
        {
            return BoostPatternState.Registered;
        }

        var candidatePrefix = GetRulePrefix(normalizedCandidate);
        if (string.IsNullOrEmpty(candidatePrefix))
        {
            return BoostPatternState.Available;
        }

        foreach (var existingPattern in existingBoostPatterns)
        {
            var existingPrefix = GetRulePrefix(existingPattern);
            if (string.IsNullOrEmpty(existingPrefix))
            {
                continue;
            }

            if (candidatePrefix.StartsWith(existingPrefix + "/", StringComparison.Ordinal))
            {
                return BoostPatternState.BroaderRule;
            }
        }

        return BoostPatternState.Available;
    }

    private async Task LoadExistingBoostPatternsAsync()
    {
        try
        {
            var repo = Services.GetRequiredService<IRadarRepository>();
            var rulesTask = repo.GetBoostRulesAsync(CancellationToken.None);
            IReadOnlyList<BoostRule> rules = rulesTask is null
                ? Array.Empty<BoostRule>()
                : await rulesTask;
            _existingBoostPatterns = rules
                .Select(static rule => NormalizePattern(rule.Pattern))
                .Where(static pattern => !string.IsNullOrEmpty(pattern))
                .Distinct(StringComparer.Ordinal)
                .ToArray();
            _suggestedBoostPatterns = BuildBoostPatternSuggestions(FilePaths, _existingBoostPatterns);
        }
        catch
        {
            _existingBoostPatterns = [];
        }
    }

    private static bool TryParseBoostDelta(string value, out double delta)
        => double.TryParse(
            value.Trim(),
            NumberStyles.Float,
            CultureInfo.CurrentCulture,
            out delta)
        || double.TryParse(
            value.Trim(),
            NumberStyles.Float,
            CultureInfo.InvariantCulture,
            out delta);

    private static string FormatBoostDelta(double delta)
        => delta > 0
            ? string.Create(CultureInfo.CurrentCulture, $"+{delta:0.###}")
            : delta.ToString("0.###", CultureInfo.CurrentCulture);

    private static string GetRulePrefix(string pattern)
        => NormalizePattern(pattern).TrimEnd('*', '/');

    private static void AddSuggestion(HashSet<string> suggestions, string pattern)
    {
        if (!string.IsNullOrWhiteSpace(pattern))
        {
            suggestions.Add(pattern);
        }
    }

    private enum IgnorePatternState
    {
        Available,
        Registered,
        Covered,
    }

    private enum BoostPatternState
    {
        Available,
        Registered,
        BroaderRule,
    }

    private sealed record IgnorePatternSuggestion(string Pattern, int MatchCount, IgnorePatternState IgnoreState)
    {
        public bool IsAlreadyIgnored => IgnoreState is not IgnorePatternState.Available;
    }

    private sealed record BoostPatternSuggestion(string Pattern, int MatchCount, BoostPatternState State)
    {
        public bool IsAlreadyRegistered => State is BoostPatternState.Registered;
    }

    private sealed record RejectReasonPreset(string ResourceKey);
}
