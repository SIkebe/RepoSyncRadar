@* Ask Palette — a Ctrl+K powered natural-language query box that forwards questions
   to <see cref="AskSession"/> via <see cref="ICopilotAgent.AskAsync"/>. Renders the
   Markdown result in a read-only pane. IMPLEMENTATION_PLAN.md §Step 18. *@

@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.DependencyInjection
@using RepoSyncRadar.App.Copilot
@using RepoSyncRadar.Core.Services

@inject IServiceProvider Services

<div class="ask-palette" data-testid="ask-palette">
    <div class="ask-palette-input">
        <input type="text"
               value="@_question"
               @oninput="OnQuestionChanged"
               @onkeydown="OnKeyDown"
               placeholder="@L["AskPalette.Placeholder"]"
               data-testid="ask-palette-input" />
        <button type="button"
                disabled="@(_busy || string.IsNullOrWhiteSpace(_question))"
                data-testid="ask-palette-submit"
                @onclick="SubmitAsync">@L["Common.Run"]</button>
        <label>
            <input type="checkbox" checked="@_debug" @onchange="ToggleDebug" data-testid="ask-palette-debug" />
            <span>@L["AskPalette.ShowSql"]</span>
        </label>
    </div>
    @if (_busy)
    {
        <p class="ask-palette-busy" data-testid="ask-palette-busy">@L["AskPalette.Busy"]</p>
    }
    @if (!string.IsNullOrEmpty(_result))
    {
        <pre class="ask-palette-result" data-testid="ask-palette-result">@_result</pre>
    }
</div>

@code {
    private IStringLocalizer<SharedResource>? _localizer;
    private IStringLocalizer<SharedResource> L => _localizer ??= Services.GetRequiredService<IStringLocalizer<SharedResource>>();

    private string _question = string.Empty;
    private string _result = string.Empty;
    private bool _busy;
    private bool _debug;

    private void OnQuestionChanged(ChangeEventArgs e) => _question = e.Value?.ToString() ?? string.Empty;

    private void ToggleDebug(ChangeEventArgs e) => _debug = e.Value is bool b && b;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey && string.Equals(e.Key, "Enter", StringComparison.Ordinal))
        {
            await SubmitAsync();
        }
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_question) || _busy)
        {
            return;
        }
        var ask = Services.GetService<AskSession>();
        if (ask is null)
        {
            _result = L["AskPalette.SessionNotRegistered"];
            return;
        }
        _busy = true;
        _result = string.Empty;
        StateHasChanged();
        try
        {
            _result = await ask.AskAsync(_question, debug: _debug);
        }
        catch (Exception ex)
        {
            _result = $"{L["Common.Error"]}: {ex.Message}";
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }
}
