@using Microsoft.Extensions.DependencyInjection
@using RepoSyncRadar.App.Settings
@inherits LocalizedComponentBase

<section class="settings-section local-appsettings-section" data-testid="settings-local-appsettings">
    <header class="settings-subheader">
        <div>
            <h3>@L["LocalSettings.Title"]</h3>
            @if (!string.IsNullOrWhiteSpace(_settingsPath))
            {
                <p class="settings-muted" data-testid="settings-local-appsettings-path">@_settingsPath</p>
            }
        </div>
        <div class="settings-actions">
            <button type="button"
                    class="toolbar-button compact secondary"
                    data-testid="settings-local-appsettings-reload"
                    disabled="@(_loading || _saving)"
                    @onclick="LoadAsync">@L["Common.Reload"]</button>
            <button type="button"
                    class="toolbar-button compact primary"
                    data-testid="settings-local-appsettings-save"
                    disabled="@(_loading || _saving)"
                    @onclick="SaveAsync">@L["Common.Save"]</button>
        </div>
    </header>

    @if (_loading)
    {
        <p class="settings-muted" data-testid="settings-local-appsettings-loading">@L["Common.Loading"]</p>
    }
    else if (_settings is { } settings)
    {
        <p class="settings-muted">@L["LocalSettings.RestartHint"]</p>

        @if (!string.IsNullOrWhiteSpace(_status))
        {
            <p class="settings-muted" data-testid="settings-local-appsettings-status">@_status</p>
        }
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <p class="settings-error" data-testid="settings-local-appsettings-error">@_error</p>
        }

        <div class="local-settings-grid">
            <fieldset class="local-settings-group local-settings-group-github" data-testid="settings-local-github">
                <legend>@L["LocalSettings.Section.GitHub"]</legend>
                <label class="local-settings-field">
                    <span>@L["LocalSettings.Label.Owner"]</span>
                    <input data-testid="settings-github-owner" value="@settings.GitHub.Owner" disabled="@_saving" @oninput="e => settings.GitHub.Owner = StringValue(e)" />
                </label>
                <label class="local-settings-field">
                    <span>@L["LocalSettings.Label.Repo"]</span>
                    <input data-testid="settings-github-repo" value="@settings.GitHub.Repo" disabled="@_saving" @oninput="e => settings.GitHub.Repo = StringValue(e)" />
                </label>
                <label class="local-settings-field">
                    <span>@L["LocalSettings.Label.PullRequestTitleFilter"]</span>
                    <input data-testid="settings-github-pr-title-filter" value="@settings.GitHub.PullRequestTitleFilter" disabled="@_saving" @oninput="e => settings.GitHub.PullRequestTitleFilter = StringValue(e)" />
                </label>
                <label class="local-settings-field">
                    <span>@L["LocalSettings.Label.MaxPullRequests"]</span>
                    <input type="number" min="1" max="100" data-testid="settings-github-max-prs" value="@settings.GitHub.MaxPullRequests" disabled="@_saving" @oninput="e => settings.GitHub.MaxPullRequests = IntValue(e)" />
                </label>
                <label class="local-settings-field wide">
                    <span>@L["LocalSettings.Label.PullRequestCreatedAtOrAfter"]</span>
                    <input data-testid="settings-github-created-after" placeholder="2026-05-15T00:00:00Z" value="@settings.GitHub.PullRequestCreatedAtOrAfter" disabled="@_saving" @oninput="e => settings.GitHub.PullRequestCreatedAtOrAfter = NullableStringValue(e)" />
                </label>
            </fieldset>

            <fieldset class="local-settings-group local-settings-group-docs-api" data-testid="settings-local-docs-api">
                <legend>@L["LocalSettings.Section.DocsApi"]</legend>
                <label class="local-settings-field wide">
                    <span>@L["LocalSettings.Label.BaseAddress"]</span>
                    <input data-testid="settings-docsapi-base-address" value="@settings.DocsApi.BaseAddress" disabled="@_saving" @oninput="e => settings.DocsApi.BaseAddress = StringValue(e)" />
                </label>
                <label class="local-settings-field">
                    <span>@L["LocalSettings.Label.ClientName"]</span>
                    <input data-testid="settings-docsapi-client-name" value="@settings.DocsApi.ClientName" disabled="@_saving" @oninput="e => settings.DocsApi.ClientName = StringValue(e)" />
                </label>
                <label class="local-settings-field">
                    <span>@L["LocalSettings.Label.PageListCacheSeconds"]</span>
                    <input type="number" min="1" data-testid="settings-docsapi-cache-seconds" value="@settings.DocsApi.PageListCacheSeconds" disabled="@_saving" @oninput="e => settings.DocsApi.PageListCacheSeconds = IntValue(e)" />
                </label>
            </fieldset>

            <fieldset class="local-settings-group local-settings-group-copilot" data-testid="settings-local-copilot">
                <legend>@L["LocalSettings.Section.Copilot"]</legend>
                <label class="local-settings-field">
                    <span>@L["LocalSettings.Label.DefaultModel"]</span>
                    <input data-testid="settings-copilot-model" value="@settings.Copilot.DefaultModel" disabled="@_saving" @oninput="e => settings.Copilot.DefaultModel = StringValue(e)" />
                </label>
                <label class="local-settings-check">
                    <input type="checkbox" data-testid="settings-copilot-streaming" checked="@settings.Copilot.Streaming" disabled="@_saving" @onchange="e => settings.Copilot.Streaming = BoolValue(e)" />
                    <span>@L["LocalSettings.Label.Streaming"]</span>
                </label>
                <label class="local-settings-field">
                    <span>@L["LocalSettings.Label.ContextTier"]</span>
                    <select class="context-tier-select" data-testid="settings-copilot-context-tier" @bind:get="settings.Copilot.ContextTier" @bind:set="value => settings.Copilot.ContextTier = NullableStringValue(value)" disabled="@_saving">
                        <option value="">@L["LocalSettings.Option.SdkDefault"]</option>
                        <option value="default">@L["LocalSettings.Option.Default"]</option>
                        <option value="long_context">@L["LocalSettings.Option.LongContext"]</option>
                    </select>
                </label>
                <label class="local-settings-field">
                    <span>@L["LocalSettings.Label.LogLevel"]</span>
                    <input data-testid="settings-copilot-log-level" value="@settings.Copilot.LogLevel" disabled="@_saving" @oninput="e => settings.Copilot.LogLevel = StringValue(e)" />
                </label>
                <label class="local-settings-field">
                    <span>@L["LocalSettings.Label.SessionIdleTimeoutSeconds"]</span>
                    <input type="number" min="0" data-testid="settings-copilot-idle-timeout" value="@settings.Copilot.SessionIdleTimeoutSeconds" disabled="@_saving" @oninput="e => settings.Copilot.SessionIdleTimeoutSeconds = NullableIntValue(e)" />
                </label>
                <label class="local-settings-field wide">
                    <span>@L["LocalSettings.Label.CopilotHome"]</span>
                    <input data-testid="settings-copilot-home" value="@settings.Copilot.CopilotHome" disabled="@_saving" @oninput="e => settings.Copilot.CopilotHome = NullableStringValue(e)" />
                </label>
                <label class="local-settings-field wide">
                    <span>@L["LocalSettings.Label.TelemetryFilePath"]</span>
                    <input data-testid="settings-copilot-telemetry-file" value="@settings.Copilot.TelemetryFilePath" disabled="@_saving" @oninput="e => settings.Copilot.TelemetryFilePath = NullableStringValue(e)" />
                </label>
                <label class="local-settings-check">
                    <input type="checkbox" data-testid="settings-copilot-capture-content" checked="@settings.Copilot.CaptureContent" disabled="@_saving" @onchange="e => settings.Copilot.CaptureContent = BoolValue(e)" />
                    <span>@L["LocalSettings.Label.CaptureContent"]</span>
                </label>
                <label class="local-settings-check">
                    <input type="checkbox" data-testid="settings-copilot-enable-remote-sessions" checked="@settings.Copilot.EnableRemoteSessions" disabled="@_saving" @onchange="e => settings.Copilot.EnableRemoteSessions = BoolValue(e)" />
                    <span>@L["LocalSettings.Label.EnableRemoteSessions"]</span>
                </label>
                <label class="local-settings-check">
                    <input type="checkbox" data-testid="settings-copilot-enable-session-telemetry" checked="@settings.Copilot.EnableSessionTelemetry" disabled="@_saving" @onchange="e => settings.Copilot.EnableSessionTelemetry = BoolValue(e)" />
                    <span>@L["LocalSettings.Label.EnableSessionTelemetry"]</span>
                </label>
                <label class="local-settings-field wide">
                    <span>@L["LocalSettings.Label.OAuthClientId"]</span>
                    <input data-testid="settings-copilot-oauth-client-id" value="@settings.Copilot.OAuthClientId" disabled="@_saving" @oninput="e => settings.Copilot.OAuthClientId = NullableStringValue(e)" />
                    <small class="settings-muted">@L["LocalSettings.OAuthClientIdHint"]</small>
                </label>
                <label class="local-settings-field wide">
                    <span>@L["LocalSettings.Label.AllowedUrlHosts"]</span>
                    <textarea rows="3" data-testid="settings-copilot-allowed-hosts" disabled="@_saving" @bind="_allowedHostsText" @bind:event="oninput"></textarea>
                </label>
                <label class="local-settings-field wide">
                    <span>@L["LocalSettings.Label.OAuthScopes"]</span>
                    <textarea rows="2" data-testid="settings-copilot-oauth-scopes" disabled="@_saving" @bind="_oauthScopesText" @bind:event="oninput"></textarea>
                </label>
            </fieldset>

            <fieldset class="local-settings-group local-settings-group-webview" data-testid="settings-local-webview">
                <legend>@L["LocalSettings.Section.WebView"]</legend>
                <label class="local-settings-field wide">
                    <span>@L["LocalSettings.Label.AllowedUrlHosts"]</span>
                    <textarea rows="4" data-testid="settings-webview-allowed-hosts" disabled="@_saving" @bind="_webViewAllowedHostsText" @bind:event="oninput"></textarea>
                </label>
            </fieldset>

            <fieldset class="local-settings-group local-settings-group-docs-repository" data-testid="settings-local-docs-repository">
                <legend>@L["LocalSettings.Section.DocsRepository"]</legend>
                <label class="local-settings-field wide">
                    <span>@L["LocalSettings.Label.BareCloneDir"]</span>
                    <input data-testid="settings-docsrepo-bare-clone-dir" value="@settings.DocsRepository.BareCloneDir" disabled="@_saving" @oninput="e => settings.DocsRepository.BareCloneDir = StringValue(e)" />
                </label>
                <label class="local-settings-field wide">
                    <span>@L["LocalSettings.Label.CloneUrl"]</span>
                    <input data-testid="settings-docsrepo-clone-url" value="@settings.DocsRepository.CloneUrl" disabled="@_saving" @oninput="e => settings.DocsRepository.CloneUrl = StringValue(e)" />
                </label>
                <label class="local-settings-field wide">
                    <span>@L["LocalSettings.Label.WorktreeRoot"]</span>
                    <input data-testid="settings-docsrepo-worktree-root" value="@settings.DocsRepository.WorktreeRoot" disabled="@_saving" @oninput="e => settings.DocsRepository.WorktreeRoot = StringValue(e)" />
                </label>
                <label class="local-settings-check">
                    <input type="checkbox" data-testid="settings-docsrepo-prewarm-on-startup" checked="@settings.DocsRepository.PrewarmOnStartup" disabled="@_saving" @onchange="e => settings.DocsRepository.PrewarmOnStartup = BoolValue(e)" />
                    <span>@L["LocalSettings.Label.PrewarmOnStartup"]</span>
                </label>
                <label class="local-settings-field">
                    <span>@L["LocalSettings.Label.PreviewBasePort"]</span>
                    <input type="number" min="1024" max="65535" data-testid="settings-docsrepo-preview-base-port" value="@settings.DocsRepository.PreviewBasePort" disabled="@_saving" @oninput="e => settings.DocsRepository.PreviewBasePort = IntValue(e)" />
                </label>
                <label class="local-settings-field">
                    <span>@L["LocalSettings.Label.PreviewReadyTimeoutSeconds"]</span>
                    <input type="number" min="5" max="1800" data-testid="settings-docsrepo-preview-timeout" value="@settings.DocsRepository.PreviewReadyTimeoutSeconds" disabled="@_saving" @oninput="e => settings.DocsRepository.PreviewReadyTimeoutSeconds = IntValue(e)" />
                </label>
            </fieldset>

            <fieldset class="local-settings-group local-settings-group-logging" data-testid="settings-local-logging">
                <legend>@L["LocalSettings.Section.Logging"]</legend>
                <label class="local-settings-field">
                    <span>@L["LocalSettings.Label.Default"]</span>
                    <input data-testid="settings-logging-default" value="@settings.Logging.DefaultLogLevel" disabled="@_saving" @oninput="e => settings.Logging.DefaultLogLevel = StringValue(e)" />
                </label>
                <label class="local-settings-field">
                    <span>@L["LocalSettings.Label.Microsoft"]</span>
                    <input data-testid="settings-logging-microsoft" value="@settings.Logging.MicrosoftLogLevel" disabled="@_saving" @oninput="e => settings.Logging.MicrosoftLogLevel = StringValue(e)" />
                </label>
            </fieldset>

            <fieldset class="local-settings-group local-settings-group-updates" data-testid="settings-local-updates">
                <legend>@L["LocalSettings.Section.Updates"]</legend>
                <label class="local-settings-check">
                    <input type="checkbox" data-testid="settings-updates-enabled" checked="@settings.Updates.Enabled" disabled="@_saving" @onchange="e => settings.Updates.Enabled = BoolValue(e)" />
                    <span>@L["LocalSettings.Label.Enabled"]</span>
                </label>
                <label class="local-settings-check">
                    <input type="checkbox" data-testid="settings-updates-check-on-startup" checked="@settings.Updates.CheckOnStartup" disabled="@_saving" @onchange="e => settings.Updates.CheckOnStartup = BoolValue(e)" />
                    <span>@L["LocalSettings.Label.CheckOnStartup"]</span>
                </label>
                <label class="local-settings-field wide">
                    <span>@L["LocalSettings.Label.FeedUrl"]</span>
                    <input data-testid="settings-updates-feed-url" placeholder="https://github.com/owner/repo" value="@settings.Updates.FeedUrl" disabled="@_saving" @oninput="e => settings.Updates.FeedUrl = StringValue(e)" />
                </label>
                <label class="local-settings-field">
                    <span>@L["LocalSettings.Label.Channel"]</span>
                    <input data-testid="settings-updates-channel" placeholder="win-x64-stable" value="@settings.Updates.Channel" disabled="@_saving" @oninput="e => settings.Updates.Channel = NullableStringValue(e)" />
                </label>
                <label class="local-settings-field">
                    <span>@L["LocalSettings.Label.CheckTimeoutSeconds"]</span>
                    <input type="number" min="5" max="1800" data-testid="settings-updates-timeout" value="@settings.Updates.CheckTimeoutSeconds" disabled="@_saving" @oninput="e => settings.Updates.CheckTimeoutSeconds = IntValue(e)" />
                </label>
            </fieldset>
        </div>
    }
</section>

@code {
    [CascadingParameter] public IServiceProvider Services { get; set; } = default!;

    private IStringLocalizer<SharedResource>? _localizer;
    private IStringLocalizer<SharedResource> L => _localizer ??= Services.GetRequiredService<IStringLocalizer<SharedResource>>();

    private LocalAppSettings? _settings;
    private string? _settingsPath;
    private bool _loading = true;
    private bool _saving;
    private string? _status;
    private string? _error;
    private string _allowedHostsText = string.Empty;
    private string _webViewAllowedHostsText = string.Empty;
    private string _oauthScopesText = string.Empty;

    protected override async Task OnInitializedAsync()
        => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _status = null;
        _error = null;
        try
        {
            var store = Services.GetRequiredService<ILocalAppSettingsStore>();
            _settingsPath = store.SettingsPath;
            _settings = await store.LoadAsync(CancellationToken.None);
            UpdateTextFields(_settings);
        }
        catch (Exception ex)
        {
            _settings = null;
            _error = $"{L["LocalSettings.LoadFailed"]}: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_settings is null || _saving)
        {
            return;
        }

        _saving = true;
        _status = null;
        _error = null;
        try
        {
            var next = _settings.Clone();
            next.Copilot.AllowedUrlHosts = SplitLines(_allowedHostsText);
            next.WebView.AllowedUrlHosts = SplitLines(_webViewAllowedHostsText);
            next.Copilot.OAuthScopes = SplitLines(_oauthScopesText);
            var store = Services.GetRequiredService<ILocalAppSettingsStore>();
            await store.SaveAsync(next, CancellationToken.None);
            _settings = store.Current.Clone();
            UpdateTextFields(_settings);
            _status = L["LocalSettings.Saved"];
        }
        catch (LocalAppSettingsValidationException ex)
        {
            _error = string.Join(" ", ex.Errors);
        }
        catch (FormatException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = $"{L["LocalSettings.SaveFailed"]}: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private void UpdateTextFields(LocalAppSettings settings)
    {
        _allowedHostsText = JoinLines(settings.Copilot.AllowedUrlHosts);
        _webViewAllowedHostsText = JoinLines(settings.WebView.AllowedUrlHosts);
        _oauthScopesText = JoinLines(settings.Copilot.OAuthScopes);
    }

    private static string StringValue(ChangeEventArgs e)
        => e.Value?.ToString() ?? string.Empty;

    private static string? NullableStringValue(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        return NullableStringValue(value);
    }

    private static string? NullableStringValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? null : value;
    }

    private static int IntValue(ChangeEventArgs e)
        => int.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var value)
            ? value
            : 0;

    private static int? NullableIntValue(ChangeEventArgs e)
        => int.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var value)
            ? value
            : null;

    private static bool BoolValue(ChangeEventArgs e)
        => e.Value is bool value && value;

    private static string JoinLines(IEnumerable<string> values)
        => string.Join(Environment.NewLine, values);

    private static List<string> SplitLines(string value)
        => value
            .Split(["\r\n", "\n"], StringSplitOptions.None)
            .Select(static line => line.Trim())
            .Where(static line => line.Length > 0)
            .Distinct(StringComparer.Ordinal)
            .ToList();

}