    private void OnAppUpdateActivityChanged()
    {
        if (_updateService is null)
        {
            return;
        }

        _appUpdateActivity = _updateService.CurrentActivity;
        if (_appUpdateActivity?.Status != AppUpdateActivityStatus.Downloaded)
        {
            _dismissedDownloadedUpdateVersion = null;
        }

        if (_appUpdateActivity?.Status != AppUpdateActivityStatus.Failed)
        {
            _dismissedFailedUpdateKey = null;
        }

        _ = InvokeAsync(StateHasChanged);
