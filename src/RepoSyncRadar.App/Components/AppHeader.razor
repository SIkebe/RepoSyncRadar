@using Microsoft.Extensions.DependencyInjection
@using RepoSyncRadar.App.Auth
@using RepoSyncRadar.App.Copilot
@using RepoSyncRadar.App.Settings
@using RepoSyncRadar.App.Updates
@using RepoSyncRadar.Core.Services
@implements IDisposable

@{ ApplyDisplayCultureForRender(); }

@*
    AppHeader — top bar shown at the top of Workbench. Surfaces activity status and
    the Triage trigger that runs ICopilotAgent. Auth and settings entry points live
    in the sidebar footer so account/setup management stays anchored at the lower left.
    Without this header the app launches into an entirely empty inbox with no
    visible action, which is what motivated this component.
*@

<MudPaper Elevation="1"
          Class="app-header pa-3 mb-2"
          data-testid="app-header">
    <header style="display:flex; gap:12px; align-items:center; justify-content:space-between; flex-wrap:wrap;">
        <div class="app-header-spacer" aria-hidden="true"></div>

    <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
        @if (_lastReport is { } report)
        {
            <span data-testid="app-header-last-sync" style="font-size:0.85em; opacity:0.8;">
                @L["AppHeader.LastTriage", report.Total, report.Inserted, report.Skipped]
            </span>
        }
        @if (_lastError is not null)
        {
            <span data-testid="app-header-error" style="color:#ef4444; font-size:0.85em;">@_lastError</span>
        }
        @if (ShouldShowHeaderUpdateActivity(_appUpdateActivity))
        {
            <span class="app-header-update-status"
                  data-testid="app-header-update-status"
                  aria-label="@FormatHeaderUpdateActivity(_appUpdateActivity)">
                <span data-testid="app-header-update-message">@FormatHeaderUpdateActivity(_appUpdateActivity)</span>
                @if (_appUpdateActivity?.Status == AppUpdateActivityStatus.Downloaded)
                {
                    <button type="button"
                            class="toolbar-button compact primary"
                            data-testid="app-header-update-restart"
                            disabled="@_appUpdateRestartBusy"
                                @onclick="RestartForUpdateAsync">@(_appUpdateRestartBusy ? L["AppHeader.Update.Restarting"] : L["AppHeader.Update.RestartNow"])</button>
                    <button type="button"
                            class="toolbar-button compact secondary"
                            data-testid="app-header-update-later"
                            disabled="@_appUpdateRestartBusy"
                                @onclick="DismissUpdatePrompt">@L["AppHeader.Update.Later"]</button>
                }
            </span>
        }
        @if (!string.IsNullOrWhiteSpace(_appUpdateRestartError))
        {
            <span data-testid="app-header-update-error" style="color:#ef4444; font-size:0.85em;">@_appUpdateRestartError</span>
        }
        @if (_triageStatus is not null)
        {
            @if (BuildTriageProgressView(_triageStatus) is { } triageProgress)
            {
                <span data-testid="app-header-triage-status"
                      class="progress-metric-list app-header-triage-progress"
                      aria-label="@triageProgress.AriaLabel">
                    <span class="progress-metric progress-metric-current" data-testid="app-header-triage-current">
                        <span class="progress-metric-label">@L["Common.Work"]</span>
                        <span class="progress-metric-value">@triageProgress.CurrentWork</span>
                    </span>
                    <span class="progress-metric progress-metric-elapsed" data-testid="app-header-triage-elapsed">
                        <span class="progress-metric-label">@L["Common.Elapsed"]</span>
                        <span class="progress-metric-value">@FormatElapsed(_triageElapsed)</span>
                    </span>
                    @foreach (var metric in triageProgress.Metrics)
                    {
                        <span class="progress-metric" data-testid="app-header-triage-@metric.TestIdSuffix">
                            <span class="progress-metric-label">@metric.Label</span>
                            <span class="progress-metric-value">@metric.Value</span>
                        </span>
                    }
                </span>
            }
            else
            {
                <span data-testid="app-header-triage-status" style="font-size:0.85em; opacity:0.85;">
                    @FormatTriageStatus(_triageStatus)
                </span>
            }
        }
        @if (_copilotUsage.TurnCount > 0)
        {
            <span data-testid="app-header-copilot-usage" style="font-size:0.85em; opacity:0.85;">
                Copilot @FormatAiCreditsOrTokens(_copilotUsage)
            </span>
        }
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="OnTriageAsync"
                   Disabled="@(_busy || _state != GitHubAuthState.SignedIn)"
                   data-testid="app-header-sync">
            @(_busy ? L["AppHeader.Triaging"] : "Triage")
        </MudButton>
        <span data-testid="app-header-version"
              title="@_appVersion"
              style="font-size:0.8em; opacity:0.7; font-variant-numeric:tabular-nums;">v@_appVersion</span>
    </div>
    </header>

    @if (_settingsOpen)
    {
        <section class="app-settings-panel" data-testid="settings-panel">
            <header class="app-settings-header">
                <div>
                    <h2>@L["Common.Settings"]</h2>
                    <p>@L["Settings.Description"]</p>
                </div>
            </header>

            <section class="settings-section" data-testid="settings-display-language-section">
                <h3>@L["Settings.DisplayLanguage"]</h3>
                <div class="settings-theme-options" data-testid="settings-display-language" role="group" aria-label="@DisplayLanguageLabel">
                    @foreach (var culture in AppDisplayCulture.SupportedCultures)
                    {
                        <button type="button"
                                class="@BuildDisplayCultureOptionClass(culture.CultureName)"
                                data-testid="settings-display-language-@culture.CultureName"
                                aria-pressed="@BuildDisplayCultureOptionPressed(culture.CultureName)"
                                disabled="@_settingsDisplayCultureSaving"
                                @onclick="() => SaveDisplayCultureAsync(culture.CultureName)">@culture.NativeLabel</button>
                    }
                </div>
                @if (!string.IsNullOrEmpty(_settingsDisplayCultureStatus))
                {
                    <p class="settings-muted" data-testid="settings-display-language-status">@_settingsDisplayCultureStatus</p>
                }
                @if (!string.IsNullOrEmpty(_settingsDisplayCultureError))
                {
                    <p class="settings-error" data-testid="settings-display-language-error">@_settingsDisplayCultureError</p>
                }
            </section>

            <section class="settings-section" data-testid="settings-default-theme-section">
                <h3>@L["Settings.DefaultTheme"]</h3>
                <div class="settings-theme-options" data-testid="settings-default-theme" role="group" aria-label="@DefaultThemeLabel">
                    <button type="button"
                            class="@BuildThemeOptionClass(DocsThemeMode.Dark)"
                            data-testid="settings-default-theme-dark"
                            aria-pressed="@BuildThemeOptionPressed(DocsThemeMode.Dark)"
                            disabled="@_settingsThemeSaving"
                            @onclick="() => SaveDefaultDocsThemeAsync(DocsThemeMode.Dark)">@L["Settings.Theme.Dark"]</button>
                    <button type="button"
                            class="@BuildThemeOptionClass(DocsThemeMode.Light)"
                            data-testid="settings-default-theme-light"
                            aria-pressed="@BuildThemeOptionPressed(DocsThemeMode.Light)"
                            disabled="@_settingsThemeSaving"
                            @onclick="() => SaveDefaultDocsThemeAsync(DocsThemeMode.Light)">@L["Settings.Theme.Light"]</button>
                </div>
                @if (!string.IsNullOrEmpty(_settingsThemeStatus))
                {
                    <p class="settings-muted" data-testid="settings-default-theme-status">@_settingsThemeStatus</p>
                }
                @if (!string.IsNullOrEmpty(_settingsThemeError))
                {
                    <p class="settings-error" data-testid="settings-default-theme-error">@_settingsThemeError</p>
                }
            </section>

            <LocalAppSettingsEditor />

            <section class="settings-section" data-testid="settings-update-check">
                <header class="settings-subheader">
                    <div>
                        <h3>@L["AppHeader.Update.Title"]</h3>
                        <p class="settings-muted">@L["AppHeader.Update.Description"]</p>
                    </div>
                    <button type="button"
                            class="toolbar-button compact secondary"
                            data-testid="settings-check-updates"
                            disabled="@_settingsUpdateBusy"
                            @onclick="CheckForUpdatesNowAsync">@(_settingsUpdateBusy ? L["AppHeader.Update.CheckingButton"] : L["AppHeader.Update.CheckButton"])</button>
                </header>
                @if (_settingsUpdateProgress is { } updateProgress)
                {
                    <p class="settings-muted" data-testid="settings-update-progress">@L["AppHeader.Update.DownloadingPercent", updateProgress]</p>
                }
                @if (!string.IsNullOrWhiteSpace(_settingsUpdateStatus))
                {
                    <p class="settings-muted" data-testid="settings-update-status">@_settingsUpdateStatus</p>
                }
                @if (!string.IsNullOrWhiteSpace(_settingsUpdateError))
                {
                    <p class="settings-error" data-testid="settings-update-error">@_settingsUpdateError</p>
                }
            </section>

            <section class="settings-section" data-testid="settings-copilot-usage">
                <h3>@L["Settings.CopilotUsage"]</h3>
                @if (!HasCopilotUsage(_copilotUsage))
                {
                    <p class="settings-muted" data-testid="settings-copilot-usage-empty">@L["Settings.CopilotUsage.Empty"]</p>
                }
                else
                {
                    <div class="settings-usage-grid" data-testid="settings-copilot-usage-summary">
                        <div><span>@L["CopilotUsage.Label.AiCredits"]</span><strong>@FormatSnapshotAiCreditsWithUnit(_copilotUsage)</strong></div>
                        <div><span>@L["CopilotUsage.Label.PremiumRequestCost"]</span><strong>@FormatNullablePremiumRequestCost(_copilotUsage.Cost)</strong></div>
                        <div><span>@L["CopilotUsage.Label.PremiumRequests"]</span><strong>@FormatPremiumRequests(_copilotUsage)</strong></div>
                        <div><span>@L["Common.Total"]</span><strong>@FormatTokensWithUnit(_copilotUsage.TotalTokens)</strong></div>
                        <div><span>@L["Common.Input"]</span><strong>@FormatTokensWithUnit(_copilotUsage.InputTokens)</strong></div>
                        <div><span>@L["Common.Output"]</span><strong>@FormatTokensWithUnit(_copilotUsage.OutputTokens)</strong></div>
                        <div><span>@L["Common.Reasoning"]</span><strong>@FormatTokensWithUnit(_copilotUsage.ReasoningTokens)</strong></div>
                        <div><span>@L["Common.CacheRead"]</span><strong>@FormatTokensWithUnit(_copilotUsage.CacheReadTokens)</strong></div>
                        <div><span>@L["Common.CacheWrite"]</span><strong>@FormatTokensWithUnit(_copilotUsage.CacheWriteTokens)</strong></div>
                    </div>
                    @if (_copilotUsage.LastTurn is { } lastTurn)
                    {
                        <p class="settings-muted" data-testid="settings-copilot-usage-last">
                            @L["Common.Last"]: @FormatCreatedAt(lastTurn.RecordedAt.LocalDateTime) / @lastTurn.Purpose / @(lastTurn.Model ?? "model unknown") / @FormatTurnAiCreditsWithUnit(lastTurn) / @FormatTokensWithUnit(lastTurn.TotalTokens())
                        </p>
                    }
                    @if (_copilotUsage.SessionMetrics.FirstOrDefault() is { } sessionMetrics)
                    {
                        <p class="settings-muted" data-testid="settings-copilot-usage-session-metrics">
                            @L["Settings.CopilotUsage.SessionMetrics", sessionMetrics.CurrentModel ?? "model unknown", FormatNumber(sessionMetrics.TotalUserRequests), FormatTokensWithUnit(sessionMetrics.LastCallInputTokens), FormatTokensWithUnit(sessionMetrics.LastCallOutputTokens)]
                        </p>
                    }
                    @if (_copilotUsage.TotalNanoAiu is { } totalNanoAiu)
                    {
                        <p class="settings-muted" data-testid="settings-copilot-usage-aiu">@FormatBillingSource(_copilotUsage.BillingSource) / @FormatNumber(totalNanoAiu) nano AIU</p>
                    }
                    <button type="button"
                            class="toolbar-button compact secondary"
                            data-testid="settings-copilot-usage-reset"
                            @onclick="ResetCopilotUsage">@L["Common.Reset"]</button>
                }
                <p class="settings-muted" data-testid="settings-copilot-usage-privacy">@L["Settings.CopilotUsage.Privacy"]</p>
            </section>

            <ThirdPartyNoticesPanel />

            <section class="settings-section" data-testid="settings-ignore-rules">
                <header class="settings-subheader">
                    <h3>@L["Settings.IgnoreList"]</h3>
                    <button type="button"
                            class="toolbar-button compact secondary"
                            data-testid="settings-refresh-ignore-rules"
                            disabled="@_settingsLoading"
                            @onclick="LoadIgnoreRulesAsync">@L["Settings.IgnoreList.Refresh"]</button>
                </header>
                @if (_settingsLoading)
                {
                    <p class="settings-muted" data-testid="settings-ignore-rules-loading">@L["Common.Loading"]</p>
                }
                else if (!string.IsNullOrEmpty(_settingsError))
                {
                    <p class="settings-error" data-testid="settings-ignore-rules-error">@_settingsError</p>
                }
                else if (_ignoreRules.Count == 0)
                {
                    <p class="settings-muted" data-testid="settings-ignore-rules-empty">@L["Settings.IgnoreList.Empty"]</p>
                }
                else
                {
                    <div class="ignore-rule-toolbar" data-testid="settings-ignore-rules-toolbar">
                        <button type="button"
                                class="toolbar-button compact secondary"
                                data-testid="settings-ignore-rules-select-all"
                                disabled="@_settingsDeleteBusy"
                                @onclick="ToggleAllIgnoreRulesAsync">@BuildIgnoreRuleSelectAllLabel()</button>
                        <span class="settings-muted" data-testid="settings-ignore-rules-selected-count">@L["Common.SelectedCount", _selectedIgnoreRulePatterns.Count]</span>
                        <button type="button"
                                class="toolbar-button compact danger"
                                data-testid="settings-delete-selected-ignore-rules"
                                disabled="@IsDeleteSelectedIgnoreRulesDisabled()"
                                @onclick="DeleteSelectedIgnoreRulesAsync">@L["Common.DeleteSelected"]</button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_settingsDeleteStatus))
                    {
                        <p class="settings-muted" data-testid="settings-ignore-rules-delete-status">@_settingsDeleteStatus</p>
                    }
                    <div class="ignore-rule-list" data-testid="settings-ignore-rules-list">
                        @foreach (var rule in _ignoreRules)
                        {
                            <article class="ignore-rule-row" data-testid="settings-ignore-rule">
                                <label class="ignore-rule-pattern-select">
                                    <input type="checkbox"
                                           data-testid="settings-ignore-rule-select"
                                           checked="@IsIgnoreRuleSelected(rule.Pattern)"
                                           disabled="@_settingsDeleteBusy"
                                           @onchange="() => ToggleIgnoreRuleSelection(rule.Pattern)" />
                                    <code data-testid="settings-ignore-rule-pattern">@rule.Pattern</code>
                                </label>
                                <div class="ignore-rule-meta">
                                    @if (!string.IsNullOrWhiteSpace(rule.Reason))
                                    {
                                        <span data-testid="settings-ignore-rule-reason">@rule.Reason</span>
                                    }
                                    <time datetime="@rule.CreatedAt.ToString("O", System.Globalization.CultureInfo.InvariantCulture)"
                                          data-testid="settings-ignore-rule-created">@FormatCreatedAt(rule.CreatedAt)</time>
                                    <button type="button"
                                            class="toolbar-button compact danger"
                                            data-testid="settings-delete-ignore-rule"
                                            disabled="@_settingsDeleteBusy"
                                            @onclick="() => DeleteIgnoreRulesAsync([rule.Pattern])">@L["Common.Delete"]</button>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        </section>
    }
</MudPaper>

@code {
    [CascadingParameter] public IServiceProvider Services { get; set; } = default!;

    [CascadingParameter] public string DisplayCulture { get; set; } = AppDisplayCulture.DefaultCultureName;

    [Parameter] public EventCallback<string> DisplayCultureChanged { get; set; }

    [Parameter] public bool SettingsOpen { get; set; }

    [Parameter] public int AuthStateVersion { get; set; }

    private IStringLocalizer<SharedResource>? _localizer;
    private IStringLocalizer<SharedResource> L => _localizer ??= Services.GetRequiredService<IStringLocalizer<SharedResource>>();

    private GitHubAuthState _state = GitHubAuthState.NotSignedIn;
    private bool _busy;
    private IngestionReport? _lastReport;
    private string? _lastError;
    private string? _triageStatus;
    private DateTimeOffset? _triageStartedAt;
    private TimeSpan _triageElapsed;
    private CancellationTokenSource? _triageTimerCts;
    private IReviewBroadcaster? _broadcaster;
    private ICopilotUsageTracker? _usageTracker;
    private CopilotUsageSnapshot _copilotUsage = EmptyCopilotUsage;
    private bool _settingsOpen;
    private bool _settingsLoading;
    private string? _settingsError;
    private DocsThemeMode _defaultDocsTheme = DocsThemeMode.Dark;
    private string _displayCulture = AppUserSettings.Default.DisplayCulture;
    private bool _settingsThemeSaving;
    private string? _settingsThemeError;
    private string? _settingsThemeStatus;
    private bool _settingsDisplayCultureSaving;
    private string? _settingsDisplayCultureError;
    private string? _settingsDisplayCultureStatus;
    private IReadOnlyList<IgnoreRule> _ignoreRules = [];
    private readonly HashSet<string> _selectedIgnoreRulePatterns = new(StringComparer.Ordinal);
    private bool _settingsDeleteBusy;
    private string? _settingsDeleteStatus;
    private bool _settingsUpdateBusy;
    private int? _settingsUpdateProgress;
    private string? _settingsUpdateStatus;
    private string? _settingsUpdateError;
    private IAppUpdateService? _updateService;
    private AppUpdateActivity? _appUpdateActivity;
    private bool _appUpdateRestartBusy;
    private string? _appUpdateRestartError;
    private string? _dismissedDownloadedUpdateVersion;
    private int _observedAuthStateVersion;

    private string _appVersion = "0.0.0";

    protected override async Task OnInitializedAsync()
    {
        _broadcaster = Services.GetService<IReviewBroadcaster>();
        _usageTracker = Services.GetService<ICopilotUsageTracker>();
        _updateService = Services.GetService<IAppUpdateService>();
        _displayCulture = AppDisplayCulture.Apply(DisplayCulture).Name;
        if (_usageTracker is not null)
        {
            _copilotUsage = _usageTracker.GetSnapshot();
            _usageTracker.Changed += OnCopilotUsageChanged;
        }

        if (_updateService is not null)
        {
            _appUpdateActivity = _updateService.CurrentActivity;
            _updateService.ActivityChanged += OnAppUpdateActivityChanged;
        }

        if (Services.GetService<IAppVersionProvider>() is { } versionProvider)
        {
            _appVersion = versionProvider.DisplayVersion;
        }

        _observedAuthStateVersion = AuthStateVersion;
        await RefreshStateAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var displayCulture = AppDisplayCulture.NormalizeCultureName(DisplayCulture);
        if (!_settingsDisplayCultureSaving && !string.Equals(_displayCulture, displayCulture, StringComparison.OrdinalIgnoreCase))
        {
            _displayCulture = displayCulture;
        }

        if (SettingsOpen != _settingsOpen)
        {
            _settingsOpen = SettingsOpen;
            if (_settingsOpen)
            {
                await LoadSettingsPanelAsync();
            }
            else
            {
                _selectedIgnoreRulePatterns.Clear();
                _settingsDeleteStatus = null;
            }
        }

        if (_observedAuthStateVersion != AuthStateVersion)
        {
            _observedAuthStateVersion = AuthStateVersion;
            await RefreshStateAsync();
        }
    }

    private void ApplyDisplayCultureForRender()
        => AppDisplayCulture.Apply(_displayCulture);

    private static CopilotUsageSnapshot EmptyCopilotUsage { get; } = new(
        0,
        0,
        0,
        0,
        0,
        0,
        0,
        null,
        null,
        null,
        [],
        []);

    private void OnCopilotUsageChanged()
    {
        if (_usageTracker is null)
        {
            return;
        }

        _copilotUsage = _usageTracker.GetSnapshot();
        _ = InvokeAsync(StateHasChanged);
    }

    private void ResetCopilotUsage()
        => _usageTracker?.Reset();

    private void OnAppUpdateActivityChanged()
    {
        if (_updateService is null)
        {
            return;
        }

        _appUpdateActivity = _updateService.CurrentActivity;
        if (_appUpdateActivity?.Status != AppUpdateActivityStatus.Downloaded)
        {
            _dismissedDownloadedUpdateVersion = null;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private async Task RefreshStateAsync()
    {
        var session = Services.GetRequiredService<IGitHubAuthSession>();
        _state = await session.GetStateAsync(CancellationToken.None);
    }

    private async Task OnTriageAsync()
    {
        _busy = true;
        _lastError = null;
        _lastReport = null;
        _triageStartedAt = DateTimeOffset.UtcNow;
        _triageElapsed = TimeSpan.Zero;
        _triageStatus = L["AppHeader.TriageStarting"];
        StartTriageTimer();
        StateHasChanged();
        try
        {
            var agent = Services.GetRequiredService<ICopilotAgent>();
            var progress = new Progress<string>(message =>
            {
                _triageStatus = message;
                _ = InvokeAsync(StateHasChanged);
            });
            _lastReport = await agent.RunMorningTriageAsync(progress, CancellationToken.None);
            // Reuse the review broadcaster so Sidebar/CommitList re-query their
            // data the moment Triage finishes. The broadcaster is a no-op
            // pub/sub so we can publish freely without coupling to a triage-specific bus.
            _broadcaster?.Publish();
            _triageStatus = L["AppHeader.TriageCompleted"];
        }
        catch (Exception ex)
        {
            _lastError = $"{L["AppHeader.TriageFailed"]}: {ex.Message}";
            _triageStatus = L["AppHeader.TriageFailedStatus"];
        }
        finally
        {
            _busy = false;
            StopTriageTimer();
        }
    }

    private async Task LoadSettingsPanelAsync()
    {
        await LoadUserSettingsAsync();
        await LoadIgnoreRulesAsync();
    }

    private async Task LoadUserSettingsAsync()
    {
        _settingsThemeError = null;
        _settingsThemeStatus = null;
        _settingsDisplayCultureError = null;
        _settingsDisplayCultureStatus = null;
        try
        {
            var store = Services.GetRequiredService<IAppUserSettingsStore>();
            var settings = await store.LoadAsync(CancellationToken.None);
            _defaultDocsTheme = settings.DefaultDocsTheme;
            _displayCulture = AppDisplayCulture.Apply(settings.DisplayCulture).Name;
        }
        catch (Exception ex)
        {
            _settingsThemeError = $"{L["Settings.Theme.LoadFailed"]}: {ex.Message}";
        }
    }

    private async Task SaveDisplayCultureAsync(string cultureName)
    {
        if (_settingsDisplayCultureSaving)
        {
            return;
        }

        var normalizedCulture = AppDisplayCulture.NormalizeCultureName(cultureName);
        _settingsDisplayCultureSaving = true;
        _settingsDisplayCultureError = null;
        _displayCulture = AppDisplayCulture.Apply(normalizedCulture).Name;
        _settingsDisplayCultureStatus = L["Settings.DisplayLanguage.Applying"];
        StateHasChanged();
        try
        {
            var store = Services.GetRequiredService<IAppUserSettingsStore>();
            await store.SaveDisplayCultureAsync(normalizedCulture, CancellationToken.None);
            _displayCulture = AppDisplayCulture.Apply(normalizedCulture).Name;
            await DisplayCultureChanged.InvokeAsync(_displayCulture);
            _settingsDisplayCultureStatus = L["Settings.DisplayLanguage.Saved", GetDisplayCultureLabel(normalizedCulture)];
        }
        catch (Exception ex)
        {
            _settingsDisplayCultureError = $"{L["Settings.DisplayLanguage.SaveFailed"]}: {ex.Message}";
        }
        finally
        {
            _settingsDisplayCultureSaving = false;
        }
    }

    private async Task SaveDefaultDocsThemeAsync(DocsThemeMode theme)
    {
        if (_settingsThemeSaving)
        {
            return;
        }

        _settingsThemeSaving = true;
        _settingsThemeError = null;
        _settingsThemeStatus = null;
        StateHasChanged();
        try
        {
            var store = Services.GetRequiredService<IAppUserSettingsStore>();
            await store.SaveDefaultDocsThemeAsync(theme, CancellationToken.None);
            _defaultDocsTheme = theme;
            _settingsThemeStatus = L["Common.Saved"];
        }
        catch (Exception ex)
        {
            _settingsThemeError = $"{L["Settings.Theme.SaveFailed"]}: {ex.Message}";
        }
        finally
        {
            _settingsThemeSaving = false;
        }
    }

    private async Task CheckForUpdatesNowAsync()
    {
        if (_settingsUpdateBusy)
        {
            return;
        }

        _settingsUpdateBusy = true;
        _settingsUpdateProgress = null;
        _settingsUpdateStatus = L["AppHeader.Update.Checking"];
        _settingsUpdateError = null;
        StateHasChanged();
        try
        {
            var updateService = Services.GetRequiredService<IAppUpdateService>();
            var progress = new Progress<int>(value =>
            {
                _settingsUpdateProgress = value;
                _ = InvokeAsync(StateHasChanged);
            });
            var result = await updateService.CheckAndDownloadAsync(progress, ignoreCheckOnStartup: true, CancellationToken.None);
            _settingsUpdateStatus = FormatUpdateResult(result);
            _settingsUpdateProgress = result.Status == AppUpdateStatus.Downloaded ? 100 : null;
        }
        catch (Exception ex)
        {
            _settingsUpdateStatus = null;
            _settingsUpdateProgress = null;
            _settingsUpdateError = L["AppHeader.Update.CheckFailedWithMessage", ex.Message];
        }
        finally
        {
            _settingsUpdateBusy = false;
        }
    }

    private string FormatUpdateResult(AppUpdateResult result)
        => result.Status switch
        {
            AppUpdateStatus.Disabled => L["AppHeader.Update.Disabled"],
            AppUpdateStatus.FeedNotConfigured => string.IsNullOrWhiteSpace(result.Message)
                ? L["AppHeader.Update.FeedNotConfigured"]
                : result.Message,
            AppUpdateStatus.NotInstalled => L["AppHeader.Update.NotInstalled"],
            AppUpdateStatus.NoUpdate => string.IsNullOrWhiteSpace(result.CurrentVersion)
                ? L["AppHeader.Update.NoUpdate"]
                : L["AppHeader.Update.NoUpdateWithVersion", result.CurrentVersion],
            AppUpdateStatus.Downloaded => string.IsNullOrWhiteSpace(result.AvailableVersion)
                ? L["AppHeader.Update.Downloaded"]
                : L["AppHeader.Update.DownloadedWithVersion", result.AvailableVersion],
            _ => result.Message ?? result.Status.ToString(),
        };

    private bool ShouldShowHeaderUpdateActivity(AppUpdateActivity? activity)
    {
        if (activity is null)
        {
            return false;
        }

        if (activity.Status != AppUpdateActivityStatus.Downloaded)
        {
            return true;
        }

        return !string.Equals(
            _dismissedDownloadedUpdateVersion,
            BuildDownloadedUpdateDismissKey(activity),
            StringComparison.Ordinal);
    }

    private string FormatHeaderUpdateActivity(AppUpdateActivity? activity)
        => activity?.Status switch
        {
            AppUpdateActivityStatus.Checking => L["AppHeader.Update.Checking"],
            AppUpdateActivityStatus.Downloading => activity.Progress is { } progress
                ? L["AppHeader.Update.DownloadingPercent", progress]
                : L["AppHeader.Update.Downloading"],
            AppUpdateActivityStatus.Downloaded => string.IsNullOrWhiteSpace(activity.AvailableVersion)
                ? L["AppHeader.Update.ReadyToRestart"]
                : L["AppHeader.Update.ReadyToRestartWithVersion", activity.AvailableVersion],
            AppUpdateActivityStatus.Failed => string.IsNullOrWhiteSpace(activity.Message)
                ? L["AppHeader.Update.CheckFailed"]
                : L["AppHeader.Update.CheckFailedWithMessage", activity.Message],
            _ => string.Empty,
        };

    private async Task RestartForUpdateAsync()
    {
        if (_appUpdateRestartBusy || _updateService is null)
        {
            return;
        }

        _appUpdateRestartBusy = true;
        _appUpdateRestartError = null;
        StateHasChanged();
        try
        {
            await Task.Yield();
            if (!_updateService.TryApplyDownloadedUpdateAndRestart())
            {
                _appUpdateRestartError = L["AppHeader.Update.NotReadyToApply"];
            }
        }
        catch (Exception ex)
        {
            _appUpdateRestartError = L["AppHeader.Update.RestartFailed", ex.Message];
        }
        finally
        {
            _appUpdateRestartBusy = false;
        }
    }

    private void DismissUpdatePrompt()
    {
        if (_appUpdateActivity is not null)
        {
            _dismissedDownloadedUpdateVersion = BuildDownloadedUpdateDismissKey(_appUpdateActivity);
        }

        _appUpdateRestartError = null;
    }

    private static string BuildDownloadedUpdateDismissKey(AppUpdateActivity activity)
        => activity.AvailableVersion ?? activity.Message ?? activity.Status.ToString();

    private async Task LoadIgnoreRulesAsync()
    {
        _settingsLoading = true;
        _settingsError = null;
        _settingsDeleteStatus = null;
        StateHasChanged();
        try
        {
            var repo = Services.GetRequiredService<IRadarRepository>();
            _ignoreRules = await repo.GetIgnoreRulesAsync(CancellationToken.None);
            RemoveSelectionsNotInIgnoreRules();
        }
        catch (Exception ex)
        {
            _ignoreRules = [];
            _selectedIgnoreRulePatterns.Clear();
            _settingsError = $"{L["Settings.IgnoreList.LoadFailed"]}: {ex.Message}";
        }
        finally
        {
            _settingsLoading = false;
        }
    }

    private Task ToggleAllIgnoreRulesAsync()
    {
        if (_settingsDeleteBusy || _ignoreRules.Count == 0)
        {
            return Task.CompletedTask;
        }

        if (_selectedIgnoreRulePatterns.Count == _ignoreRules.Count)
        {
            _selectedIgnoreRulePatterns.Clear();
        }
        else
        {
            _selectedIgnoreRulePatterns.Clear();
            foreach (var rule in _ignoreRules)
            {
                _selectedIgnoreRulePatterns.Add(rule.Pattern);
            }
        }

        _settingsDeleteStatus = null;
        return Task.CompletedTask;
    }

    private void ToggleIgnoreRuleSelection(string pattern)
    {
        if (_settingsDeleteBusy)
        {
            return;
        }

        if (!_selectedIgnoreRulePatterns.Add(pattern))
        {
            _selectedIgnoreRulePatterns.Remove(pattern);
        }
        _settingsDeleteStatus = null;
    }

    private async Task DeleteSelectedIgnoreRulesAsync()
    {
        if (IsDeleteSelectedIgnoreRulesDisabled())
        {
            return;
        }

        await DeleteIgnoreRulesAsync(_selectedIgnoreRulePatterns.ToArray());
    }

    private async Task DeleteIgnoreRulesAsync(IReadOnlyList<string> patterns)
    {
        if (_settingsDeleteBusy || patterns.Count == 0)
        {
            return;
        }

        _settingsDeleteBusy = true;
        _settingsError = null;
        _settingsDeleteStatus = null;
        StateHasChanged();
        try
        {
            var repo = Services.GetRequiredService<IRadarRepository>();
            var deleted = await repo.DeleteIgnoreRulesAsync(patterns, CancellationToken.None);
            _ignoreRules = await repo.GetIgnoreRulesAsync(CancellationToken.None);
            RemoveSelectionsNotInIgnoreRules();
            _settingsDeleteStatus = L["Settings.IgnoreList.Deleted", deleted];
        }
        catch (Exception ex)
        {
            _settingsError = $"{L["Settings.IgnoreList.DeleteFailed"]}: {ex.Message}";
        }
        finally
        {
            _settingsDeleteBusy = false;
        }
    }

    private void RemoveSelectionsNotInIgnoreRules()
    {
        var currentPatterns = _ignoreRules.Select(static rule => rule.Pattern).ToHashSet(StringComparer.Ordinal);
        _selectedIgnoreRulePatterns.RemoveWhere(pattern => !currentPatterns.Contains(pattern));
    }

    private bool IsIgnoreRuleSelected(string pattern)
        => _selectedIgnoreRulePatterns.Contains(pattern);

    private bool IsDeleteSelectedIgnoreRulesDisabled()
        => _settingsDeleteBusy || _selectedIgnoreRulePatterns.Count == 0;

    private string BuildIgnoreRuleSelectAllLabel()
        => _ignoreRules.Count > 0 && _selectedIgnoreRulePatterns.Count == _ignoreRules.Count
            ? L["Common.ClearAll"]
            : L["Common.SelectAll"];

    private void StartTriageTimer()
    {
        StopTriageTimer();
        var cts = new CancellationTokenSource();
        _triageTimerCts = cts;
        _ = UpdateTriageElapsedAsync(cts.Token);
    }

    private void StopTriageTimer()
    {
        if (_triageTimerCts is null)
        {
            return;
        }

        _triageTimerCts.Cancel();
        _triageTimerCts.Dispose();
        _triageTimerCts = null;
    }

    private async Task UpdateTriageElapsedAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (_triageStartedAt is { } startedAt)
                {
                    _triageElapsed = ProgressElapsedDisplay.Advance(_triageElapsed, startedAt, DateTimeOffset.UtcNow);
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private static string FormatElapsed(TimeSpan elapsed)
    {
        return elapsed.TotalHours >= 1
            ? $"{(int)elapsed.TotalHours}:{elapsed.Minutes:D2}:{elapsed.Seconds:D2}"
            : $"{elapsed.Minutes:D2}:{elapsed.Seconds:D2}";
    }

    private string FormatTriageStatus(string status)
    {
        return status;
    }

    private TriageProgressView? BuildTriageProgressView(string status)
    {
        if (!_busy)
        {
            return null;
        }

        if (BuildTriageIngestionProgressView(status) is { } ingestionProgress)
        {
            return ingestionProgress;
        }

        if (BuildTriageScoringProgressView(status) is { } scoringProgress)
        {
            return scoringProgress;
        }

        return BuildTriageGenericProgressView(status);
    }

    private TriageProgressView? BuildTriageScoringProgressView(string status)
    {
        if (!TryReadCountAfter(status, "対象", out var targetCount) ||
            !TryReadProgressAfter(status, "分析", out var analyzedCount, out var analyzedTotalCount) ||
            !TryReadProgressAfter(status, "スコア保存", out var savedCount, out var savedTotalCount))
        {
            return null;
        }

        var totalCount = Math.Max(Math.Max(targetCount, analyzedTotalCount), savedTotalCount);
        var sourcePhase = ExtractTriagePhase(status);
        var currentWork = BuildScoringCurrentWork(sourcePhase, analyzedCount, savedCount, totalCount);
        var metrics = new List<TriageProgressMetric>
        {
            new("target", L["TriageProgress.Target"], FormatCount(targetCount)),
            new("analyzed", L["TriageProgress.Analyzed"], FormatProgressCount(analyzedCount, totalCount)),
            new("saved", L["TriageProgress.Saved"], FormatProgressCount(savedCount, totalCount)),
        };
        AddReferenceMetricIfPresent(metrics, status);

        return new TriageProgressView(
            currentWork,
            metrics,
            L["TriageProgress.AriaWithMetrics", currentWork, BuildMetricAriaText(metrics), FormatElapsed(_triageElapsed)]);
    }

    private TriageProgressView? BuildTriageIngestionProgressView(string status)
    {
        if (!TryReadCountAfter(status, "新規", out var insertedCount) ||
            !TryReadCountAfter(status, "取得", out var fetchedCount))
        {
            return null;
        }

        var sourcePhase = ExtractTriagePhase(status);
        var currentWork = BuildTriageCurrentWork(sourcePhase);
        var metrics = new List<TriageProgressMetric>
        {
            new("inserted", L["TriageProgress.Inserted"], FormatCount(insertedCount)),
            new("fetched", L["TriageProgress.Fetched"], FormatCount(fetchedCount)),
        };
        AddCountMetricIfPresent(metrics, status, "skipped", "スキップ", L["TriageProgress.Skipped"]);
        AddReferenceMetricIfPresent(metrics, status);
        return new TriageProgressView(
            currentWork,
            metrics,
            L["TriageProgress.AriaWithMetrics", currentWork, BuildMetricAriaText(metrics), FormatElapsed(_triageElapsed)]);
    }

    private TriageProgressView BuildTriageGenericProgressView(string status)
    {
        var sourcePhase = ExtractTriagePhase(status);
        var metrics = new List<TriageProgressMetric>();
        AddCountMetricIfPresent(metrics, status, "fetched", "取得", L["TriageProgress.Fetched"]);
        AddCountMetricIfPresent(metrics, status, "inserted", "新規", L["TriageProgress.Inserted"]);
        AddCountMetricIfPresent(metrics, status, "skipped", "スキップ", L["TriageProgress.Skipped"]);
        AddReferenceMetricIfPresent(metrics, status);

        return new TriageProgressView(
            BuildTriageCurrentWork(sourcePhase),
            metrics,
            metrics.Count == 0
                ? L["TriageProgress.AriaWithoutMetrics", BuildTriageCurrentWork(sourcePhase), FormatElapsed(_triageElapsed)]
                : L["TriageProgress.AriaWithMetrics", BuildTriageCurrentWork(sourcePhase), BuildMetricAriaText(metrics), FormatElapsed(_triageElapsed)]);
    }

    private void AddCountMetricIfPresent(List<TriageProgressMetric> metrics, string status, string testIdSuffix, string sourceLabel, string displayLabel)
    {
        if (TryReadCountAfter(status, sourceLabel, out var count))
        {
            metrics.Add(new TriageProgressMetric(testIdSuffix, displayLabel, FormatCount(count)));
        }
    }

    private void AddReferenceMetricIfPresent(List<TriageProgressMetric> metrics, string status)
    {
        if (TryReadTrailingParenthesizedValue(status, out var reference))
        {
            metrics.Add(new TriageProgressMetric("reference", L["TriageProgress.Commit"], reference));
        }
    }

    private static bool TryReadTrailingParenthesizedValue(string status, out string value)
    {
        value = string.Empty;
        var endIndex = status.LastIndexOf(')');
        if (endIndex != status.Length - 1)
        {
            return false;
        }

        var startIndex = status.LastIndexOf('(');
        if (startIndex < 0 || startIndex >= endIndex - 1)
        {
            return false;
        }

        value = status[(startIndex + 1)..endIndex].Trim();
        return value.Length > 0;
    }

    private string BuildMetricAriaText(IReadOnlyList<TriageProgressMetric> metrics)
        => string.Join(L["Common.ListSeparator"], metrics.Select(static metric => $"{metric.Label} {metric.Value}"));

    private string BuildScoringCurrentWork(string sourcePhase, int analyzedCount, int savedCount, int totalCount)
    {
        if (sourcePhase.Contains("分析", StringComparison.Ordinal))
        {
            var currentCount = Math.Max(1, Math.Min(analyzedCount, Math.Max(totalCount, 1)));
            return L["TriageProgress.CurrentAnalyzing", currentCount, totalCount];
        }

        if (sourcePhase.Contains("完了", StringComparison.Ordinal))
        {
            return L["TriageProgress.CurrentApplyingScores"];
        }

        if (savedCount < analyzedCount)
        {
            return L["TriageProgress.CurrentSavingScores"];
        }

        return L["TriageProgress.CurrentScoring"];
    }

    private string BuildTriageCurrentWork(string sourcePhase)
    {
        if (sourcePhase.Contains("スコアリング", StringComparison.Ordinal))
        {
            return L["TriageProgress.CurrentScoring"];
        }

        if (sourcePhase.Contains("取り込み", StringComparison.Ordinal))
        {
            return L["TriageProgress.CurrentIngesting"];
        }

        if (sourcePhase.Contains("Repo sync PR", StringComparison.Ordinal) &&
            sourcePhase.Contains("取得", StringComparison.Ordinal))
        {
            return L["TriageProgress.CurrentFetching"];
        }

        if (sourcePhase.Contains("Copilot セッション", StringComparison.Ordinal))
        {
            return L["TriageProgress.CurrentPreparingCopilot"];
        }

        if (sourcePhase.Contains("スコアリングを開始", StringComparison.Ordinal))
        {
            return L["TriageProgress.CurrentStartingScoring"];
        }

        return LocalizeKnownTriagePhase(sourcePhase);
    }

    private string LocalizeKnownTriagePhase(string sourcePhase)
        => sourcePhase switch
        {
            "Triage を開始しています…" => L["AppHeader.TriageStarting"],
            "Triage 完了" => L["AppHeader.TriageCompleted"],
            _ => sourcePhase,
        };

    private static string ExtractTriagePhase(string status)
    {
        var separatorIndex = status.IndexOf(':', StringComparison.Ordinal);
        return separatorIndex > 0
            ? status[..separatorIndex].Trim()
            : status.Trim();
    }

    private static bool TryReadCountAfter(string status, string label, out int count)
    {
        count = 0;
        foreach (var startIndex in FindValueStarts(status, label))
        {
            if (TryReadInt(status, startIndex, out count, out _))
            {
                return true;
            }
        }

        return false;
    }

    private static bool TryReadProgressAfter(string status, string label, out int currentCount, out int totalCount)
    {
        currentCount = 0;
        totalCount = 0;

        foreach (var startIndex in FindValueStarts(status, label))
        {
            if (!TryReadInt(status, startIndex, out currentCount, out var afterCurrentIndex))
            {
                continue;
            }

            var separatorIndex = status.IndexOf('/', afterCurrentIndex);
            if (separatorIndex >= 0 && TryReadInt(status, separatorIndex + 1, out totalCount, out _))
            {
                return true;
            }
        }

        return false;
    }

    private static IEnumerable<int> FindValueStarts(string status, string label)
    {
        var searchIndex = 0;
        while (searchIndex < status.Length)
        {
            var labelIndex = status.IndexOf(label, searchIndex, StringComparison.Ordinal);
            if (labelIndex < 0)
            {
                yield break;
            }

            var valueIndex = labelIndex + label.Length;
            while (valueIndex < status.Length && char.IsWhiteSpace(status[valueIndex]))
            {
                valueIndex++;
            }

            yield return valueIndex;
            searchIndex = labelIndex + label.Length;
        }
    }

    private static bool TryReadInt(string text, int startIndex, out int value, out int nextIndex)
    {
        value = 0;
        nextIndex = startIndex;
        while (nextIndex < text.Length && char.IsWhiteSpace(text[nextIndex]))
        {
            nextIndex++;
        }

        var digitStartIndex = nextIndex;
        while (nextIndex < text.Length && char.IsDigit(text[nextIndex]))
        {
            nextIndex++;
        }

        return nextIndex > digitStartIndex &&
            int.TryParse(text.AsSpan(digitStartIndex, nextIndex - digitStartIndex), System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out value);
    }

