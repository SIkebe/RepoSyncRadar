    protected override async Task OnParametersSetAsync()
    {
        var displayCulture = AppDisplayCulture.NormalizeCultureName(DisplayCulture);
        if (!_settingsDisplayCultureSaving && !string.Equals(_displayCulture, displayCulture, StringComparison.OrdinalIgnoreCase))
        {
            _displayCulture = displayCulture;
        }

        if (SettingsOpen != _settingsOpen)
        {
            _settingsOpen = SettingsOpen;
            if (_settingsOpen)
            {
                _activeSettingsSection = SettingsSection.General;
                await LoadSettingsPanelAsync();
            }
            else
            {
                _selectedIgnoreRulePatterns.Clear();
                _selectedBoostRulePatterns.Clear();
                _settingsDeleteStatus = null;
                _settingsBoostStatus = null;
                _settingsBoostDeleteStatus = null;
                _settingsBoostError = null;
