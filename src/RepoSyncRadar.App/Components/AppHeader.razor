@using Microsoft.Extensions.DependencyInjection
@using RepoSyncRadar.App.Auth
@using RepoSyncRadar.App.Copilot
@using RepoSyncRadar.App.Settings
@using RepoSyncRadar.Core.Services
@implements IDisposable

@*
    AppHeader — top bar shown at the top of Workbench. Surfaces the current GitHub
    auth state (Not configured / Not signed in / Signed in), exposes Sign in / Sign
    out buttons, and the Triage trigger that runs ICopilotAgent.
    Without this header the app launches into an entirely empty inbox with no
    visible action, which is what motivated this component.
*@

<MudPaper Elevation="1"
          Class="app-header pa-3 mb-2"
          data-testid="app-header">
    <header style="display:flex; gap:12px; align-items:center; justify-content:space-between; flex-wrap:wrap;">
        <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
        @switch (_state)
        {
            case GitHubAuthState.SignedIn:
                <span data-testid="app-header-state"
                      data-state="SignedIn"
                      style="color:#22c55e; font-weight:600;">● サインイン済み</span>
                @if (!string.IsNullOrEmpty(_login))
                {
                    <span data-testid="app-header-login"
                          style="font-weight:600; opacity:0.9;">@($"@{_login}")</span>
                }
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           OnClick="OnSignOutAsync"
                           Disabled="@_busy"
                           data-testid="app-header-signout">Sign out</MudButton>
                break;
            case GitHubAuthState.NotSignedIn:
                <span data-testid="app-header-state"
                      data-state="NotSignedIn"
                      style="color:#fbbf24; font-weight:600;">○ 未サインイン</span>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           OnClick="OnSignInAsync"
                           Disabled="@_busy"
                           data-testid="app-header-signin">Sign in</MudButton>
                break;
            case GitHubAuthState.NotConfigured:
                <span data-testid="app-header-state"
                      data-state="NotConfigured"
                      style="color:#ef4444; font-weight:600;">⚠ OAuth Client Id 未設定</span>
                <span data-testid="app-header-config-hint"
                        style="font-size:0.85em; opacity:0.8;">設定画面または appsettings.local.json で Copilot.OAuthClientId を設定 (docs/USAGE.md)</span>
                break;
        }
    </div>

    <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
        @if (_lastReport is { } report)
        {
            <span data-testid="app-header-last-sync" style="font-size:0.85em; opacity:0.8;">
                直近 Triage: 取得 @report.Total / 新規 @report.Inserted / スキップ @report.Skipped
            </span>
        }
        @if (_lastError is not null)
        {
            <span data-testid="app-header-error" style="color:#ef4444; font-size:0.85em;">@_lastError</span>
        }
        @if (_triageStatus is not null)
        {
            <span data-testid="app-header-triage-status" style="font-size:0.85em; opacity:0.85;">
                @FormatTriageStatus(_triageStatus)
                @if (_busy)
                {
                    <span>（経過 @FormatElapsed(_triageElapsed)）</span>
                }
            </span>
        }
        @if (_copilotUsage.TurnCount > 0)
        {
            <span data-testid="app-header-copilot-usage" style="font-size:0.85em; opacity:0.85;">
                Copilot @FormatAiCreditsOrTokens(_copilotUsage)
            </span>
        }
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="OnTriageAsync"
                   Disabled="@(_busy || _state != GitHubAuthState.SignedIn)"
                   data-testid="app-header-sync">
            @(_busy ? "Triage 中…" : "Triage")
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Size="Size.Small"
                   OnClick="ToggleSettingsAsync"
                   data-testid="app-header-settings">設定</MudButton>
    </div>
    </header>

    @if (_settingsOpen)
    {
        <section class="app-settings-panel" data-testid="settings-panel">
            <header class="app-settings-header">
                <div>
                    <h2>設定</h2>
                    <p>既定テーマ、アプリ設定、ライセンス、無視リストを確認できます。</p>
                </div>
                <button type="button"
                        class="toolbar-button compact secondary"
                        data-testid="settings-refresh-ignore-rules"
                        disabled="@_settingsLoading"
                        @onclick="LoadIgnoreRulesAsync">更新</button>
            </header>

            <section class="settings-section" data-testid="settings-default-theme-section">
                <h3>既定テーマ</h3>
                <div class="settings-theme-options" data-testid="settings-default-theme" role="group" aria-label="既定テーマ">
                    <button type="button"
                            class="@BuildThemeOptionClass(DocsThemeMode.Dark)"
                            data-testid="settings-default-theme-dark"
                            aria-pressed="@BuildThemeOptionPressed(DocsThemeMode.Dark)"
                            disabled="@_settingsThemeSaving"
                            @onclick="() => SaveDefaultDocsThemeAsync(DocsThemeMode.Dark)">ダーク</button>
                    <button type="button"
                            class="@BuildThemeOptionClass(DocsThemeMode.Light)"
                            data-testid="settings-default-theme-light"
                            aria-pressed="@BuildThemeOptionPressed(DocsThemeMode.Light)"
                            disabled="@_settingsThemeSaving"
                            @onclick="() => SaveDefaultDocsThemeAsync(DocsThemeMode.Light)">ライト</button>
                </div>
                @if (!string.IsNullOrEmpty(_settingsThemeStatus))
                {
                    <p class="settings-muted" data-testid="settings-default-theme-status">@_settingsThemeStatus</p>
                }
                @if (!string.IsNullOrEmpty(_settingsThemeError))
                {
                    <p class="settings-error" data-testid="settings-default-theme-error">@_settingsThemeError</p>
                }
            </section>

            <LocalAppSettingsEditor />

            <section class="settings-section" data-testid="settings-copilot-usage">
                <h3>Copilot 使用量</h3>
                @if (!HasCopilotUsage(_copilotUsage))
                {
                    <p class="settings-muted" data-testid="settings-copilot-usage-empty">まだ Copilot SDK の使用量は記録されていません。</p>
                }
                else
                {
                    <div class="settings-usage-grid" data-testid="settings-copilot-usage-summary">
                        <div><span>AI Credits</span><strong>@FormatNullableAiCredits(_copilotUsage.AiCredits())</strong></div>
                        <div><span>推定コスト</span><strong>@FormatNullableCost(_copilotUsage.Cost)</strong></div>
                        <div><span>Premium Requests</span><strong>@FormatPremiumRequests(_copilotUsage)</strong></div>
                        <div><span>合計 tokens</span><strong>@FormatTokens(_copilotUsage.TotalTokens)</strong></div>
                        <div><span>入力</span><strong>@FormatTokens(_copilotUsage.InputTokens)</strong></div>
                        <div><span>出力</span><strong>@FormatTokens(_copilotUsage.OutputTokens)</strong></div>
                        <div><span>推論</span><strong>@FormatTokens(_copilotUsage.ReasoningTokens)</strong></div>
                        <div><span>キャッシュ読込</span><strong>@FormatTokens(_copilotUsage.CacheReadTokens)</strong></div>
                        <div><span>キャッシュ書込</span><strong>@FormatTokens(_copilotUsage.CacheWriteTokens)</strong></div>
                    </div>
                    @if (_copilotUsage.LastTurn is { } lastTurn)
                    {
                        <p class="settings-muted" data-testid="settings-copilot-usage-last">
                            直近: @FormatCreatedAt(lastTurn.RecordedAt.LocalDateTime) / @lastTurn.Purpose / @(lastTurn.Model ?? "model unknown") / @FormatNullableAiCredits(lastTurn.AiCredits()) / @FormatTokens(lastTurn.TotalTokens()) tokens
                        </p>
                    }
                    @if (_copilotUsage.SessionMetrics.FirstOrDefault() is { } sessionMetrics)
                    {
                        <p class="settings-muted" data-testid="settings-copilot-usage-session-metrics">
                            セッション metrics: @(sessionMetrics.CurrentModel ?? "model unknown") / requests @FormatNumber(sessionMetrics.TotalUserRequests) / last call @FormatTokens(sessionMetrics.LastCallInputTokens) in, @FormatTokens(sessionMetrics.LastCallOutputTokens) out
                        </p>
                    }
                    @if (_copilotUsage.TotalNanoAiu is { } totalNanoAiu)
                    {
                        <p class="settings-muted" data-testid="settings-copilot-usage-aiu">@FormatBillingSource(_copilotUsage.BillingSource): @FormatNumber(totalNanoAiu) nano AIU</p>
                    }
                    <button type="button"
                            class="toolbar-button compact secondary"
                            data-testid="settings-copilot-usage-reset"
                            @onclick="ResetCopilotUsage">リセット</button>
                }
                <p class="settings-muted" data-testid="settings-copilot-usage-privacy">AI Credits と Cost は SDK の usage event / session metrics を優先し、SDK が AI Credits を返さない場合は GitHub Docs のモデル別価格表から概算します。プロンプト本文は保存しません。</p>
            </section>

            <ThirdPartyNoticesPanel />

            <section class="settings-section" data-testid="settings-ignore-rules">
                <h3>無視リスト</h3>
                @if (_settingsLoading)
                {
                    <p class="settings-muted" data-testid="settings-ignore-rules-loading">読み込み中…</p>
                }
                else if (!string.IsNullOrEmpty(_settingsError))
                {
                    <p class="settings-error" data-testid="settings-ignore-rules-error">@_settingsError</p>
                }
                else if (_ignoreRules.Count == 0)
                {
                    <p class="settings-muted" data-testid="settings-ignore-rules-empty">無視リストはまだ設定されていません。</p>
                }
                else
                {
                    <div class="ignore-rule-toolbar" data-testid="settings-ignore-rules-toolbar">
                        <button type="button"
                                class="toolbar-button compact secondary"
                                data-testid="settings-ignore-rules-select-all"
                                disabled="@_settingsDeleteBusy"
                                @onclick="ToggleAllIgnoreRulesAsync">@BuildIgnoreRuleSelectAllLabel()</button>
                        <span class="settings-muted" data-testid="settings-ignore-rules-selected-count">@_selectedIgnoreRulePatterns.Count 件選択中</span>
                        <button type="button"
                                class="toolbar-button compact danger"
                                data-testid="settings-delete-selected-ignore-rules"
                                disabled="@IsDeleteSelectedIgnoreRulesDisabled()"
                                @onclick="DeleteSelectedIgnoreRulesAsync">選択を削除</button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_settingsDeleteStatus))
                    {
                        <p class="settings-muted" data-testid="settings-ignore-rules-delete-status">@_settingsDeleteStatus</p>
                    }
                    <div class="ignore-rule-list" data-testid="settings-ignore-rules-list">
                        @foreach (var rule in _ignoreRules)
                        {
                            <article class="ignore-rule-row" data-testid="settings-ignore-rule">
                                <label class="ignore-rule-pattern-select">
                                    <input type="checkbox"
                                           data-testid="settings-ignore-rule-select"
                                           checked="@IsIgnoreRuleSelected(rule.Pattern)"
                                           disabled="@_settingsDeleteBusy"
                                           @onchange="() => ToggleIgnoreRuleSelection(rule.Pattern)" />
                                    <code data-testid="settings-ignore-rule-pattern">@rule.Pattern</code>
                                </label>
                                <div class="ignore-rule-meta">
                                    @if (!string.IsNullOrWhiteSpace(rule.Reason))
                                    {
                                        <span data-testid="settings-ignore-rule-reason">@rule.Reason</span>
                                    }
                                    <time datetime="@rule.CreatedAt.ToString("O", System.Globalization.CultureInfo.InvariantCulture)"
                                          data-testid="settings-ignore-rule-created">@FormatCreatedAt(rule.CreatedAt)</time>
                                    <button type="button"
                                            class="toolbar-button compact danger"
                                            data-testid="settings-delete-ignore-rule"
                                            disabled="@_settingsDeleteBusy"
                                            @onclick="() => DeleteIgnoreRulesAsync([rule.Pattern])">削除</button>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        </section>
    }
</MudPaper>

@code {
    [CascadingParameter] public IServiceProvider Services { get; set; } = default!;

    private GitHubAuthState _state = GitHubAuthState.NotSignedIn;
    private string? _login;
    private bool _busy;
    private IngestionReport? _lastReport;
    private string? _lastError;
    private string? _triageStatus;
    private DateTimeOffset? _triageStartedAt;
    private TimeSpan _triageElapsed;
    private CancellationTokenSource? _triageTimerCts;
    private IReviewBroadcaster? _broadcaster;
    private ICopilotUsageTracker? _usageTracker;
    private CopilotUsageSnapshot _copilotUsage = EmptyCopilotUsage;
    private bool _settingsOpen;
    private bool _settingsLoading;
    private string? _settingsError;
    private DocsThemeMode _defaultDocsTheme = DocsThemeMode.Dark;
    private bool _settingsThemeSaving;
    private string? _settingsThemeError;
    private string? _settingsThemeStatus;
    private IReadOnlyList<IgnoreRule> _ignoreRules = [];
    private readonly HashSet<string> _selectedIgnoreRulePatterns = new(StringComparer.Ordinal);
    private bool _settingsDeleteBusy;
    private string? _settingsDeleteStatus;

    protected override async Task OnInitializedAsync()
    {
        _broadcaster = Services.GetService<IReviewBroadcaster>();
        _usageTracker = Services.GetService<ICopilotUsageTracker>();
        if (_usageTracker is not null)
        {
            _copilotUsage = _usageTracker.GetSnapshot();
            _usageTracker.Changed += OnCopilotUsageChanged;
        }

        await RefreshStateAsync();
    }

    private static CopilotUsageSnapshot EmptyCopilotUsage { get; } = new(
        0,
        0,
        0,
        0,
        0,
        0,
        0,
        null,
        null,
        null,
        [],
        []);

    private void OnCopilotUsageChanged()
    {
        if (_usageTracker is null)
        {
            return;
        }

        _copilotUsage = _usageTracker.GetSnapshot();
        _ = InvokeAsync(StateHasChanged);
    }

    private void ResetCopilotUsage()
        => _usageTracker?.Reset();

    private async Task RefreshStateAsync()
    {
        var session = Services.GetRequiredService<IGitHubAuthSession>();
        _state = await session.GetStateAsync(CancellationToken.None);
        if (_state == GitHubAuthState.SignedIn)
        {
            // Cached inside the session so we can call this on every refresh; failure
            // returns null and we just hide the @login chip.
            _login = await session.GetCurrentLoginAsync(CancellationToken.None);
        }
        else
        {
            _login = null;
        }
    }

    private async Task OnSignInAsync()
    {
        _busy = true;
        _lastError = null;
        StateHasChanged();
        try
        {
            var session = Services.GetRequiredService<IGitHubAuthSession>();
            await session.SignInAsync(CancellationToken.None);
            await RefreshStateAsync();
        }
        catch (Exception ex)
        {
            _lastError = $"サインイン失敗: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnSignOutAsync()
    {
        _busy = true;
        _lastError = null;
        StateHasChanged();
        try
        {
            var session = Services.GetRequiredService<IGitHubAuthSession>();
            await session.SignOutAsync(CancellationToken.None);
            await RefreshStateAsync();
        }
        catch (Exception ex)
        {
            _lastError = $"サインアウト失敗: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnTriageAsync()
    {
        _busy = true;
        _lastError = null;
        _lastReport = null;
        _triageStartedAt = DateTimeOffset.UtcNow;
        _triageElapsed = TimeSpan.Zero;
        _triageStatus = "Triage を開始しています…";
        StartTriageTimer();
        StateHasChanged();
        try
        {
            var agent = Services.GetRequiredService<ICopilotAgent>();
            var progress = new Progress<string>(message =>
            {
                _triageStatus = message;
                _ = InvokeAsync(StateHasChanged);
            });
            _lastReport = await agent.RunMorningTriageAsync(progress, CancellationToken.None);
            // Reuse the review broadcaster so Sidebar/CommitList re-query their
            // data the moment Triage finishes. The broadcaster is a no-op
            // pub/sub so we can publish freely without coupling to a triage-specific bus.
            _broadcaster?.Publish();
            _triageStatus = "Triage 完了";
        }
        catch (Exception ex)
        {
            _lastError = $"Triage 失敗: {ex.Message}";
            _triageStatus = "Triage は失敗しました。詳細はエラーを確認してください。";
        }
        finally
        {
            _busy = false;
            StopTriageTimer();
        }
    }

    private async Task ToggleSettingsAsync()
    {
        _settingsOpen = !_settingsOpen;
        if (_settingsOpen)
        {
            await LoadUserSettingsAsync();
            await LoadIgnoreRulesAsync();
        }
    }

    private async Task LoadUserSettingsAsync()
    {
        _settingsThemeError = null;
        _settingsThemeStatus = null;
        try
        {
            var store = Services.GetRequiredService<IAppUserSettingsStore>();
            var settings = await store.LoadAsync(CancellationToken.None);
            _defaultDocsTheme = settings.DefaultDocsTheme;
        }
        catch (Exception ex)
        {
            _settingsThemeError = $"テーマ設定の読み込みに失敗しました: {ex.Message}";
        }
    }

    private async Task SaveDefaultDocsThemeAsync(DocsThemeMode theme)
    {
        if (_settingsThemeSaving)
        {
            return;
        }

        _settingsThemeSaving = true;
        _settingsThemeError = null;
        _settingsThemeStatus = null;
        StateHasChanged();
        try
        {
            var store = Services.GetRequiredService<IAppUserSettingsStore>();
            await store.SaveDefaultDocsThemeAsync(theme, CancellationToken.None);
            _defaultDocsTheme = theme;
            _settingsThemeStatus = "保存しました";
        }
        catch (Exception ex)
        {
            _settingsThemeError = $"テーマ設定の保存に失敗しました: {ex.Message}";
        }
        finally
        {
            _settingsThemeSaving = false;
        }
    }

    private async Task LoadIgnoreRulesAsync()
    {
        _settingsLoading = true;
        _settingsError = null;
        _settingsDeleteStatus = null;
        StateHasChanged();
        try
        {
            var repo = Services.GetRequiredService<IRadarRepository>();
            _ignoreRules = await repo.GetIgnoreRulesAsync(CancellationToken.None);
            RemoveSelectionsNotInIgnoreRules();
        }
        catch (Exception ex)
        {
            _ignoreRules = [];
            _selectedIgnoreRulePatterns.Clear();
            _settingsError = $"無視リストの読み込みに失敗しました: {ex.Message}";
        }
        finally
        {
            _settingsLoading = false;
        }
    }

    private Task ToggleAllIgnoreRulesAsync()
    {
        if (_settingsDeleteBusy || _ignoreRules.Count == 0)
        {
            return Task.CompletedTask;
        }

        if (_selectedIgnoreRulePatterns.Count == _ignoreRules.Count)
        {
            _selectedIgnoreRulePatterns.Clear();
        }
        else
        {
            _selectedIgnoreRulePatterns.Clear();
            foreach (var rule in _ignoreRules)
            {
                _selectedIgnoreRulePatterns.Add(rule.Pattern);
            }
        }

        _settingsDeleteStatus = null;
        return Task.CompletedTask;
    }

    private void ToggleIgnoreRuleSelection(string pattern)
    {
        if (_settingsDeleteBusy)
        {
            return;
        }

        if (!_selectedIgnoreRulePatterns.Add(pattern))
        {
            _selectedIgnoreRulePatterns.Remove(pattern);
        }
        _settingsDeleteStatus = null;
    }

    private async Task DeleteSelectedIgnoreRulesAsync()
    {
        if (IsDeleteSelectedIgnoreRulesDisabled())
        {
            return;
        }

        await DeleteIgnoreRulesAsync(_selectedIgnoreRulePatterns.ToArray());
    }

    private async Task DeleteIgnoreRulesAsync(IReadOnlyList<string> patterns)
    {
        if (_settingsDeleteBusy || patterns.Count == 0)
        {
            return;
        }

        _settingsDeleteBusy = true;
        _settingsError = null;
        _settingsDeleteStatus = null;
        StateHasChanged();
        try
        {
            var repo = Services.GetRequiredService<IRadarRepository>();
            var deleted = await repo.DeleteIgnoreRulesAsync(patterns, CancellationToken.None);
            _ignoreRules = await repo.GetIgnoreRulesAsync(CancellationToken.None);
            RemoveSelectionsNotInIgnoreRules();
            _settingsDeleteStatus = string.Create(
                System.Globalization.CultureInfo.InvariantCulture,
                $"{deleted} 件の無視リストを削除しました");
        }
        catch (Exception ex)
        {
            _settingsError = $"無視リストの削除に失敗しました: {ex.Message}";
        }
        finally
        {
            _settingsDeleteBusy = false;
        }
    }

    private void RemoveSelectionsNotInIgnoreRules()
    {
        var currentPatterns = _ignoreRules.Select(static rule => rule.Pattern).ToHashSet(StringComparer.Ordinal);
        _selectedIgnoreRulePatterns.RemoveWhere(pattern => !currentPatterns.Contains(pattern));
    }

    private bool IsIgnoreRuleSelected(string pattern)
        => _selectedIgnoreRulePatterns.Contains(pattern);

    private bool IsDeleteSelectedIgnoreRulesDisabled()
        => _settingsDeleteBusy || _selectedIgnoreRulePatterns.Count == 0;

    private string BuildIgnoreRuleSelectAllLabel()
        => _ignoreRules.Count > 0 && _selectedIgnoreRulePatterns.Count == _ignoreRules.Count
            ? "全解除"
            : "全選択";

    private void StartTriageTimer()
    {
        StopTriageTimer();
        var cts = new CancellationTokenSource();
        _triageTimerCts = cts;
        _ = UpdateTriageElapsedAsync(cts.Token);
    }

    private void StopTriageTimer()
    {
        if (_triageTimerCts is null)
        {
            return;
        }

        _triageTimerCts.Cancel();
        _triageTimerCts.Dispose();
        _triageTimerCts = null;
    }

    private async Task UpdateTriageElapsedAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (_triageStartedAt is { } startedAt)
                {
                    _triageElapsed = DateTimeOffset.UtcNow - startedAt;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private static string FormatElapsed(TimeSpan elapsed)
    {
        return elapsed.TotalHours >= 1
            ? $"{(int)elapsed.TotalHours}:{elapsed.Minutes:D2}:{elapsed.Seconds:D2}"
            : $"{elapsed.Minutes:D2}:{elapsed.Seconds:D2}";
    }

    private string FormatTriageStatus(string status)
    {
        if (!_busy || !status.Contains("保存済み", StringComparison.Ordinal))
        {
            return status;
        }

        var dots = ((int)_triageElapsed.TotalSeconds % 3) + 1;
        return $"{status} / Copilot 分析中{new string('.', dots)}";
    }

    private static string FormatCreatedAt(DateTime createdAt)
        => createdAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm", System.Globalization.CultureInfo.CurrentCulture);

    private static string FormatTokens(double tokens)
        => FormatNumber(Math.Round(tokens));

    private static string FormatNumber(double value)
        => value.ToString("N0", System.Globalization.CultureInfo.CurrentCulture);

    private static string FormatAiCreditsOrTokens(CopilotUsageSnapshot usage)
        => usage.AiCredits() is { } aiCredits
            ? $"{FormatAiCredits(aiCredits)} credits{FormatHeaderBillingSuffix(usage.BillingSource)}"
            : $"credits 未報告 / {FormatTokens(usage.TotalTokens)} tokens";

    private static string FormatHeaderBillingSuffix(CopilotUsageBillingSource source)
        => source is CopilotUsageBillingSource.OfficialPricingTable or CopilotUsageBillingSource.Mixed
            ? " 推定"
            : string.Empty;

    private static string FormatBillingSource(CopilotUsageBillingSource source)
        => source switch
        {
            CopilotUsageBillingSource.SdkReported => "SDK reported",
            CopilotUsageBillingSource.SdkTokenDetails => "SDK token detail estimate",
            CopilotUsageBillingSource.OfficialPricingTable => "GitHub Docs pricing estimate",
            CopilotUsageBillingSource.Mixed => "Mixed estimate",
            _ => "AIU estimate",
        };

    private static bool HasCopilotUsage(CopilotUsageSnapshot usage)
        => usage.TurnCount > 0 || usage.SessionMetrics.Count > 0;

    private static string FormatPremiumRequests(CopilotUsageSnapshot usage)
    {
        var requests = usage.SessionMetrics.Sum(static metrics => metrics.TotalUserRequests);
        return requests > 0 ? FormatNumber(requests) : "未報告";
    }

    private static string FormatNullableAiCredits(double? aiCredits)
        => aiCredits is { } value ? FormatAiCredits(value) : "未報告";

    private static string FormatAiCredits(double aiCredits)
        => aiCredits switch
        {
            >= 1 => aiCredits.ToString("N2", System.Globalization.CultureInfo.CurrentCulture),
            >= 0.01 => aiCredits.ToString("N4", System.Globalization.CultureInfo.CurrentCulture),
            _ => aiCredits.ToString("N9", System.Globalization.CultureInfo.CurrentCulture),
        };

    private static string FormatNullableCost(double? cost)
        => cost is { } value ? FormatCost(value) : "未報告";

    private static string FormatCost(double cost)
        => cost switch
        {
            >= 1 => cost.ToString("N2", System.Globalization.CultureInfo.CurrentCulture),
            >= 0.01 => cost.ToString("N4", System.Globalization.CultureInfo.CurrentCulture),
            _ => cost.ToString("N6", System.Globalization.CultureInfo.CurrentCulture),
        };

    private string BuildThemeOptionClass(DocsThemeMode theme)
        => _defaultDocsTheme == theme
            ? "settings-theme-option active"
            : "settings-theme-option";

    private string BuildThemeOptionPressed(DocsThemeMode theme)
        => _defaultDocsTheme == theme ? "true" : "false";

    public void Dispose()
    {
        if (_usageTracker is not null)
        {
            _usageTracker.Changed -= OnCopilotUsageChanged;
        }

        StopTriageTimer();
    }
}
