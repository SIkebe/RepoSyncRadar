        {
            CopilotUsageBillingSource.SdkReported => L["CopilotUsage.BillingSource.SdkReported"],
            CopilotUsageBillingSource.Mixed => L["CopilotUsage.BillingSource.Mixed"],
            _ => L["CopilotUsage.BillingSource.Unknown"],
