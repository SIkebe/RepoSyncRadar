    private static string FormatCreatedAt(DateTime createdAt)
        => createdAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm", System.Globalization.CultureInfo.CurrentCulture);

    private string FormatCreatedAfter(DateTimeOffset? createdAfter)
        => createdAfter is { } value
            ? value.ToLocalTime().ToString("yyyy/MM/dd HH:mm zzz", System.Globalization.CultureInfo.CurrentCulture)
            : L["TriagePreflight.NotSet"];

