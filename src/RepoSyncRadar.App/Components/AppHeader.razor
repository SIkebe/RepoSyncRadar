    private async Task CheckForUpdatesNowAsync()
    {
        if (_settingsUpdateBusy)
        {
            return;
        }

        _settingsUpdateBusy = true;
        _settingsUpdateProgress = null;
        _settingsUpdateStatus = L["AppHeader.Update.Checking"];
        _settingsUpdateError = null;
        try
        {
            var updateService = Services.GetRequiredService<IAppUpdateService>();
            var progress = new Progress<int>(value =>
            {
                _settingsUpdateProgress = value;
                _ = InvokeAsync(StateHasChanged);
            });
            var result = await updateService.CheckAndDownloadAsync(progress, ignoreCheckOnStartup: true, CancellationToken.None);
            _settingsUpdateStatus = FormatUpdateResult(result);
            _settingsUpdateProgress = result.Status == AppUpdateStatus.Downloaded ? 100 : null;
        }
        catch (Exception ex)
        {
            _settingsUpdateStatus = null;
            _settingsUpdateProgress = null;
            _settingsUpdateError = L["AppHeader.Update.CheckFailedWithMessage", ex.Message];
        }
        finally
        {
            _settingsUpdateBusy = false;
        }
