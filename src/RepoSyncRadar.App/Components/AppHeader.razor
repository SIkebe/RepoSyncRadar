        => summary.HasIgnoreRules
            ? L["TriagePreflight.IgnoreRulesActive", summary.IgnoreRuleCount]
            : L["TriagePreflight.IgnoreRulesEmpty"];

    private string FormatReviewCounts(TriagePreflightSummary summary)
    {
        var counts = summary.ReviewCounts;
        return string.Join(
            L["Common.ListSeparator"],
            [
                L["TriagePreflight.ReviewStatus.Unseen", GetReviewCount(counts, ReviewStatus.Unseen)],
                L["TriagePreflight.ReviewStatus.Adopted", GetReviewCount(counts, ReviewStatus.Adopted)],
                L["TriagePreflight.ReviewStatus.Later", GetReviewCount(counts, ReviewStatus.Later)],
                L["TriagePreflight.ReviewStatus.Rejected", GetReviewCount(counts, ReviewStatus.Rejected)],
                L["TriagePreflight.ReviewStatus.Archived", GetReviewCount(counts, ReviewStatus.Archived)],
            ]);
    }
    private static int GetReviewCount(IReadOnlyDictionary<ReviewStatus, int> counts, ReviewStatus status)
        => counts.TryGetValue(status, out var count) ? count : 0;

