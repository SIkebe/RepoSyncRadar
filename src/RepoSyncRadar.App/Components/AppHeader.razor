            : L["Common.Unreported"];

    private string FormatTurnAiCreditsWithUnit(CopilotUsageRecord usage)
        => usage.AiCredits() is { } value
            ? $"{FormatAiCredits(value)} credits"
            : L["Common.Unreported"];

