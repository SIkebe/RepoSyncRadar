            CopilotUsageBillingSource.Mixed => L["CopilotUsage.BillingSource.Mixed"],
            _ => L["CopilotUsage.BillingSource.Unknown"],
        };

    private static bool HasCopilotUsage(CopilotUsageSnapshot usage)
        => usage.TurnCount > 0 || usage.SessionMetrics.Count > 0;

    private string FormatPremiumRequests(CopilotUsageSnapshot usage)
    {
        var requests = usage.SessionMetrics.Sum(static metrics => metrics.TotalUserRequests);
        return requests > 0 ? $"{FormatNumber(requests)} requests" : L["Common.Unreported"];
    }

    private string FormatSnapshotAiCreditsWithUnit(CopilotUsageSnapshot usage)
        => usage.AiCredits() is { } value
            ? $"{FormatAiCredits(value)} credits"
            : L["Common.Unreported"];

    private string FormatTurnAiCreditsWithUnit(CopilotUsageRecord usage)
        => usage.AiCredits() is { } value
            ? $"{FormatAiCredits(value)} credits"
            : L["Common.Unreported"];

    private static string FormatAiCredits(double aiCredits)
        => aiCredits switch
        {
            >= 1 => aiCredits.ToString("N2", System.Globalization.CultureInfo.CurrentCulture),
            >= 0.01 => aiCredits.ToString("N4", System.Globalization.CultureInfo.CurrentCulture),
            _ => aiCredits.ToString("N9", System.Globalization.CultureInfo.CurrentCulture),
        };

    private string FormatNullableCost(double? cost)
