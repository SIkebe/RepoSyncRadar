@using Microsoft.Extensions.DependencyInjection
@using RepoSyncRadar.App.Auth
@using RepoSyncRadar.App.Copilot
@using RepoSyncRadar.App.Settings
@using RepoSyncRadar.App.Updates
@using RepoSyncRadar.Core.Services
@implements IDisposable

@{ ApplyDisplayCultureForRender(); }

@*
    AppHeader — top bar shown at the top of Workbench. Surfaces activity status and
    the Triage trigger that runs ICopilotAgent. Auth and settings entry points live
    in the sidebar footer so account/setup management stays anchored at the lower left.
    Without this header the app launches into an entirely empty inbox with no
    visible action, which is what motivated this component.
*@

<MudPaper Elevation="1"
          Class="app-header pa-3 mb-2"
          data-testid="app-header">
    <header class="app-header-row">
        <div class="app-header-spacer" aria-hidden="true"></div>

    <div class="app-header-content">
        @if (!_settingsOpen)
        {
            @if (_lastReport is { } report)
            {
                <span class="app-header-secondary-text" data-testid="app-header-last-sync">
                    @L["AppHeader.LastTriage", report.Total, report.Inserted, report.Skipped]
                </span>
            }
            @if (_lastError is not null)
            {
                <span class="app-header-error-text" data-testid="app-header-error" role="alert">@_lastError</span>
            }
        }
        @if (ShouldShowHeaderUpdateActivity(_appUpdateActivity))
        {
            <span class="app-header-update-status"
                  data-testid="app-header-update-status"
                  role="status"
                  aria-live="polite"
                  aria-atomic="true"
                  aria-label="@FormatHeaderUpdateActivity(_appUpdateActivity)">
                <span data-testid="app-header-update-message">@FormatHeaderUpdateActivity(_appUpdateActivity)</span>
                @if (_appUpdateActivity?.Status == AppUpdateActivityStatus.Downloaded)
                {
                    <button type="button"
                            class="toolbar-button compact primary"
                            data-testid="app-header-update-restart"
                            disabled="@_appUpdateRestartBusy"
                                @onclick="RestartForUpdateAsync">@(_appUpdateRestartBusy ? L["AppHeader.Update.Restarting"] : L["AppHeader.Update.RestartNow"])</button>
                    <button type="button"
                            class="toolbar-button compact secondary"
                            data-testid="app-header-update-later"
                            disabled="@_appUpdateRestartBusy"
                                @onclick="DismissUpdatePrompt">@L["AppHeader.Update.Later"]</button>
                }
                else if (_appUpdateActivity?.Status == AppUpdateActivityStatus.Failed)
                {
                    <button type="button"
                            class="toolbar-button compact secondary icon-only"
                            data-testid="app-header-update-dismiss"
                            aria-label="@L["AppHeader.Update.Dismiss"]"
                            title="@L["AppHeader.Update.Dismiss"]"
                            @onclick="DismissFailedUpdate"><span aria-hidden="true">&times;</span></button>
                }
            </span>
        }
        @if (!string.IsNullOrWhiteSpace(_appUpdateRestartError))
        {
            <span class="app-header-error-text" data-testid="app-header-update-error" role="alert">@_appUpdateRestartError</span>
        }
        @if (!_settingsOpen && _triageStatus is not null)
        {
            @if (BuildTriageProgressView(_triageStatus) is { } triageProgress)
            {
                <span data-testid="app-header-triage-status"
                      class="progress-metric-list app-header-triage-progress"
                      role="status"
                      aria-live="polite"
                      aria-atomic="true"
                      aria-label="@triageProgress.AriaLabel">
                    <span class="progress-metric progress-metric-current" data-testid="app-header-triage-current">
                        <span class="progress-metric-label">@L["Common.Work"]</span>
                        <span class="progress-metric-value">@triageProgress.CurrentWork</span>
                    </span>
                    <span class="progress-metric progress-metric-elapsed" data-testid="app-header-triage-elapsed">
                        <span class="progress-metric-label">@L["Common.Elapsed"]</span>
                        <span class="progress-metric-value">@FormatElapsed(_triageElapsed)</span>
                    </span>
                    @foreach (var metric in triageProgress.Metrics)
                    {
                        <span class="progress-metric" data-testid="app-header-triage-@metric.TestIdSuffix">
                            <span class="progress-metric-label">@metric.Label</span>
                            <span class="progress-metric-value">@metric.Value</span>
                        </span>
                    }
                </span>
            }
            else
            {
                <span data-testid="app-header-triage-status"
                      class="@(_lastReport?.RemainingUnscoredCommitCount is > 0 ? "app-header-warning-text" : "app-header-secondary-text")"
                      role="status"
                      aria-live="polite"
                      aria-atomic="true">
                    @FormatTriageStatus(_triageStatus)
                </span>
            }
        }
        @if (!_settingsOpen && _copilotUsage.TurnCount > 0)
        {
            <span class="app-header-secondary-text" data-testid="app-header-copilot-usage">
                Copilot @FormatAiCreditsOrTokens(_copilotUsage)
            </span>
        }
        @if (!_settingsOpen)
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       OnClick="OnPreflightAsync"
                       Disabled="@(_busy || _preflightBusy)"
                       data-testid="app-header-triage-preflight">
                @(_preflightBusy ? L["TriagePreflight.Estimating"] : L["TriagePreflight.Button"])
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="OnTriageAsync"
                       Disabled="@(_busy || _preflightBusy || _state != GitHubAuthState.SignedIn)"
                       data-testid="app-header-sync">
                @(_busy ? L["AppHeader.Triaging"] : L["Common.Triage"])
            </MudButton>
        }
        <span data-testid="app-header-version"
              title="@_appVersion"
              class="app-header-version">v@_appVersion</span>
    </div>
    </header>

    @if (!_settingsOpen && _preflightOpen)
    {
        <section class="triage-preflight-panel" data-testid="app-header-triage-preflight-panel">
            <header class="triage-preflight-header">
                <div>
                    <h2>@L["TriagePreflight.Title"]</h2>
                    <p>@L["TriagePreflight.Description"]</p>
                </div>
                <button type="button"
                        class="toolbar-button compact secondary"
                        data-testid="app-header-triage-preflight-close"
                        @onclick="CloseTriagePreflight">@L["TriagePreflight.Close"]</button>
            </header>

            @if (_preflightBusy)
            {
                <p class="settings-muted"
                   data-testid="app-header-triage-preflight-loading"
                   role="status"
                   aria-live="polite">@L["Common.Loading"]</p>
            }
            else if (!string.IsNullOrWhiteSpace(_preflightError))
            {
                <p class="settings-error" data-testid="app-header-triage-preflight-error" role="alert">@_preflightError</p>
            }
            else if (_preflightSummary is { } preflight)
            {
                <div class="triage-preflight-grid" data-testid="app-header-triage-preflight-summary">
                    <div class="triage-preflight-section" data-testid="app-header-triage-preflight-github-settings">
                        <h3>@L["TriagePreflight.GitHubSettings"]</h3>
                        <dl>
                            <div><dt>@L["TriagePreflight.Repository"]</dt><dd>@preflight.GitHubSettings.Owner/@preflight.GitHubSettings.Repo</dd></div>
                            <div><dt>@L["TriagePreflight.TitleFilter"]</dt><dd>@preflight.GitHubSettings.PullRequestTitleFilter</dd></div>
                            <div><dt>@L["TriagePreflight.MaxPullRequests"]</dt><dd>@FormatCount(preflight.GitHubSettings.MaxPullRequests)</dd></div>
                            <div><dt>@L["TriagePreflight.CreatedAfter"]</dt><dd>@FormatCreatedAfter(preflight.GitHubSettings.PullRequestCreatedAtOrAfter)</dd></div>
                        </dl>
                    </div>

                    <div class="triage-preflight-section" data-testid="app-header-triage-preflight-external">
                        <h3>@L["TriagePreflight.ExternalEstimate"]</h3>
                        @if (preflight.GitHubEstimateStatus == TriagePreflightGitHubEstimateStatus.Succeeded)
                        {
                            <dl>
                                <div><dt>@L["TriagePreflight.CandidatePullRequests"]</dt><dd data-testid="app-header-triage-preflight-candidate-prs">@FormatCount(preflight.CandidatePullRequestCount.GetValueOrDefault())</dd></div>
                                <div><dt>@L["TriagePreflight.NewUnseenCommits"]</dt><dd data-testid="app-header-triage-preflight-new-commits">@FormatCount(preflight.NewUnseenCommitCount.GetValueOrDefault())</dd></div>
                            </dl>
                        }
                        else if (preflight.GitHubEstimateStatus == TriagePreflightGitHubEstimateStatus.Skipped)
                        {
                            <p class="settings-muted" data-testid="app-header-triage-preflight-external-skipped">@L["TriagePreflight.ExternalSkipped"]</p>
                        }
                        else
                        {
                            <p class="settings-error" data-testid="app-header-triage-preflight-external-failed" role="alert">@L["TriagePreflight.ExternalFailed", preflight.GitHubEstimateUnavailableReason ?? L["Common.Unreported"]]</p>
                        }
                    </div>

                    <div class="triage-preflight-section" data-testid="app-header-triage-preflight-local">
                        <h3>@L["TriagePreflight.LocalState"]</h3>
                        <dl>
                            <div><dt>@L["TriagePreflight.EstimatedScoringTargets"]</dt><dd data-testid="app-header-triage-preflight-scoring-targets">@L["Common.ProgressItemCount", preflight.EstimatedScoringTargetCount, preflight.PerRunScoringLimit]</dd></div>
                            <div><dt>@L["TriagePreflight.UnscoredUnreviewed"]</dt><dd data-testid="app-header-triage-preflight-unscored">@FormatCount(preflight.UnscoredUnreviewedCommitCount)</dd></div>
                            <div><dt>@L["TriagePreflight.IgnoreRules"]</dt><dd data-testid="app-header-triage-preflight-ignore-rules">@FormatIgnoreRuleCount(preflight)</dd></div>
                            <div><dt>@L["TriagePreflight.ReviewCounts"]</dt><dd data-testid="app-header-triage-preflight-review-counts">@FormatReviewCounts(preflight)</dd></div>
                        </dl>
                    </div>

                    <div class="triage-preflight-section" data-testid="app-header-triage-preflight-last-report">
                        <h3>@L["TriagePreflight.LastTriage"]</h3>
                        @if (_lastReport is { } lastReport)
                        {
                            <p>@L["AppHeader.LastTriage", lastReport.Total, lastReport.Inserted, lastReport.Skipped]</p>
                        }
                        else
                        {
                            <p class="settings-muted">@L["TriagePreflight.LastTriageEmpty"]</p>
                        }
                    </div>
                </div>

                <div class="triage-preflight-actions">
                    <button type="button"
                            class="toolbar-button primary"
                            data-testid="app-header-triage-preflight-run"
                            disabled="@(_busy || _preflightBusy || _state != GitHubAuthState.SignedIn)"
                            @onclick="RunTriageFromPreflightAsync">@L["TriagePreflight.Run"]</button>
                    <button type="button"
                            class="toolbar-button secondary"
                            data-testid="app-header-triage-preflight-dismiss"
                            @onclick="CloseTriagePreflight">@L["TriagePreflight.Close"]</button>
                </div>
            }
        </section>
    }

    @if (_settingsOpen)
    {
        <section class="app-settings-panel" data-testid="settings-panel">
            <header class="app-settings-header">
                <div>
                    <h2>@L["Common.Settings"]</h2>
                    <p>@L["Settings.Description"]</p>
                </div>
            </header>

            <nav class="settings-section-nav"
                 data-testid="settings-section-nav"
                 aria-label="@L["Settings.Section.Navigation"]">
                <button type="button"
                        class="@BuildSettingsSectionButtonClass(SettingsSection.General)"
                        data-testid="settings-section-nav-general"
                        aria-current="@BuildSettingsSectionAriaCurrent(SettingsSection.General)"
                        @onclick="() => SelectSettingsSection(SettingsSection.General)">@L["Settings.Section.General"]</button>
                <button type="button"
                        class="@BuildSettingsSectionButtonClass(SettingsSection.AppSettings)"
                        data-testid="settings-section-nav-app-settings"
                        aria-current="@BuildSettingsSectionAriaCurrent(SettingsSection.AppSettings)"
                        @onclick="() => SelectSettingsSection(SettingsSection.AppSettings)">@L["Settings.Section.AppSettings"]</button>
                <button type="button"
                        class="@BuildSettingsSectionButtonClass(SettingsSection.Automation)"
                        data-testid="settings-section-nav-automation"
                        aria-current="@BuildSettingsSectionAriaCurrent(SettingsSection.Automation)"
                        @onclick="() => SelectSettingsSection(SettingsSection.Automation)">@L["Settings.Section.Automation"]</button>
                <button type="button"
                        class="@BuildSettingsSectionButtonClass(SettingsSection.LegalAbout)"
                        data-testid="settings-section-nav-legal-about"
                        aria-current="@BuildSettingsSectionAriaCurrent(SettingsSection.LegalAbout)"
                        @onclick="() => SelectSettingsSection(SettingsSection.LegalAbout)">@L["Settings.Section.LegalAbout"]</button>
            </nav>

            <div class="settings-section-content" data-testid="settings-section-content">
                @if (_activeSettingsSection == SettingsSection.General)
                {
                    <section class="settings-section" data-testid="settings-display-language-section">
                        <h3>@L["Settings.DisplayLanguage"]</h3>
                        <div class="settings-theme-options" data-testid="settings-display-language" role="group" aria-label="@DisplayLanguageLabel">
                            @foreach (var culture in AppDisplayCulture.SupportedCultures)
                            {
                                <button type="button"
                                        class="@BuildDisplayCultureOptionClass(culture.CultureName)"
                                        data-testid="settings-display-language-@culture.CultureName"
                                        aria-pressed="@BuildDisplayCultureOptionPressed(culture.CultureName)"
                                        disabled="@_settingsDisplayCultureSaving"
                                        @onclick="() => SaveDisplayCultureAsync(culture.CultureName)">@culture.NativeLabel</button>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(_settingsDisplayCultureStatus))
                        {
                            <p class="settings-muted" data-testid="settings-display-language-status">@_settingsDisplayCultureStatus</p>
                        }
                        @if (!string.IsNullOrEmpty(_settingsDisplayCultureError))
                        {
                            <p class="settings-error" data-testid="settings-display-language-error">@_settingsDisplayCultureError</p>
                        }
                    </section>

                    <section class="settings-section" data-testid="settings-default-theme-section">
                        <h3>@L["Settings.DefaultTheme"]</h3>
                        <div class="settings-theme-options" data-testid="settings-default-theme" role="group" aria-label="@DefaultThemeLabel">
                            <button type="button"
                                    class="@BuildThemeOptionClass(DocsThemeMode.Dark)"
                                    data-testid="settings-default-theme-dark"
                                    aria-pressed="@BuildThemeOptionPressed(DocsThemeMode.Dark)"
                                    disabled="@_settingsThemeSaving"
                                    @onclick="() => SaveDefaultDocsThemeAsync(DocsThemeMode.Dark)">@L["Settings.Theme.Dark"]</button>
                            <button type="button"
                                    class="@BuildThemeOptionClass(DocsThemeMode.Light)"
                                    data-testid="settings-default-theme-light"
                                    aria-pressed="@BuildThemeOptionPressed(DocsThemeMode.Light)"
                                    disabled="@_settingsThemeSaving"
                                    @onclick="() => SaveDefaultDocsThemeAsync(DocsThemeMode.Light)">@L["Settings.Theme.Light"]</button>
                        </div>
                        @if (!string.IsNullOrEmpty(_settingsThemeStatus))
                        {
                            <p class="settings-muted" data-testid="settings-default-theme-status">@_settingsThemeStatus</p>
                        }
                        @if (!string.IsNullOrEmpty(_settingsThemeError))
                        {
                            <p class="settings-error" data-testid="settings-default-theme-error">@_settingsThemeError</p>
                        }
                    </section>
                }
                else if (_activeSettingsSection == SettingsSection.AppSettings)
                {
                    <LocalAppSettingsEditor />
                }
                else if (_activeSettingsSection == SettingsSection.Automation)
                {
                    <section class="settings-section" data-testid="settings-update-check">
                        <header class="settings-subheader">
                            <div>
                                <h3>@L["AppHeader.Update.Title"]</h3>
                                <p class="settings-muted">@L["AppHeader.Update.Description"]</p>
                            </div>
                            <button type="button"
                                    class="toolbar-button compact secondary"
                                    data-testid="settings-check-updates"
                                    disabled="@_settingsUpdateBusy"
                                    @onclick="CheckForUpdatesNowAsync">@(_settingsUpdateBusy ? L["AppHeader.Update.CheckingButton"] : L["AppHeader.Update.CheckButton"])</button>
                        </header>
                        @if (_settingsUpdateProgress is { } updateProgress)
                        {
                            <p class="settings-muted" data-testid="settings-update-progress">@L["AppHeader.Update.DownloadingPercent", updateProgress]</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(_settingsUpdateStatus))
                        {
                            <p class="settings-muted" data-testid="settings-update-status">@_settingsUpdateStatus</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(_settingsUpdateError))
                        {
                            <p class="settings-error" data-testid="settings-update-error">@_settingsUpdateError</p>
                        }
                    </section>

                    <section class="settings-section" data-testid="settings-copilot-usage">
                        <h3>@L["Settings.CopilotUsage"]</h3>
                        @if (!HasCopilotUsage(_copilotUsage))
                        {
                            <p class="settings-muted" data-testid="settings-copilot-usage-empty">@L["Settings.CopilotUsage.Empty"]</p>
                        }
                        else
                        {
                            <div class="settings-usage-grid" data-testid="settings-copilot-usage-summary">
                                <div><span>@L["CopilotUsage.Label.AiCredits"]</span><strong>@FormatSnapshotAiCreditsWithUnit(_copilotUsage)</strong></div>
                                <div><span>@L["CopilotUsage.Label.PremiumRequestCost"]</span><strong>@FormatNullablePremiumRequestCost(_copilotUsage.Cost)</strong></div>
                                <div><span>@L["CopilotUsage.Label.PremiumRequests"]</span><strong>@FormatPremiumRequests(_copilotUsage)</strong></div>
                                <div><span>@L["Common.Total"]</span><strong>@FormatTokensWithUnit(_copilotUsage.TotalTokens)</strong></div>
                                <div><span>@L["Common.Input"]</span><strong>@FormatTokensWithUnit(_copilotUsage.InputTokens)</strong></div>
                                <div><span>@L["Common.Output"]</span><strong>@FormatTokensWithUnit(_copilotUsage.OutputTokens)</strong></div>
                                <div><span>@L["Common.Reasoning"]</span><strong>@FormatTokensWithUnit(_copilotUsage.ReasoningTokens)</strong></div>
                                <div><span>@L["Common.CacheRead"]</span><strong>@FormatTokensWithUnit(_copilotUsage.CacheReadTokens)</strong></div>
                                <div><span>@L["Common.CacheWrite"]</span><strong>@FormatTokensWithUnit(_copilotUsage.CacheWriteTokens)</strong></div>
                            </div>
                            @if (_copilotUsage.LastTurn is { } lastTurn)
                            {
                                <p class="settings-muted" data-testid="settings-copilot-usage-last">
                                    @L["Common.Last"]: @FormatCreatedAt(lastTurn.RecordedAt.LocalDateTime) / @lastTurn.Purpose / @(lastTurn.Model ?? L["CopilotUsage.ModelUnknown"]) / @FormatTurnAiCreditsWithUnit(lastTurn) / @FormatTokensWithUnit(lastTurn.TotalTokens())
                                </p>
                            }
                            @if (_copilotUsage.SessionMetrics.FirstOrDefault() is { } sessionMetrics)
                            {
                                <p class="settings-muted" data-testid="settings-copilot-usage-session-metrics">
                                    @L["Settings.CopilotUsage.SessionMetrics", sessionMetrics.CurrentModel ?? L["CopilotUsage.ModelUnknown"], FormatNumber(sessionMetrics.TotalUserRequests), FormatTokensWithUnit(sessionMetrics.LastCallInputTokens), FormatTokensWithUnit(sessionMetrics.LastCallOutputTokens)]
                                </p>
                            }
                            @if (_copilotUsage.TotalNanoAiu is { } totalNanoAiu)
                            {
                                <p class="settings-muted" data-testid="settings-copilot-usage-aiu">@FormatBillingSource(_copilotUsage.BillingSource) / @FormatNumber(totalNanoAiu) nano AIU</p>
                            }
                            <button type="button"
                                    class="toolbar-button compact secondary"
                                    data-testid="settings-copilot-usage-reset"
                                    @onclick="ResetCopilotUsage">@L["Common.Reset"]</button>
                        }
                        <p class="settings-muted" data-testid="settings-copilot-usage-privacy">@L["Settings.CopilotUsage.Privacy"]</p>
                    </section>
                    <section class="settings-section" data-testid="settings-boost-rules">
                        <header class="settings-subheader">
                            <div>
                                <h3>@L["Settings.BoostRules"]</h3>
                                <p class="settings-muted">@L["Settings.BoostRules.Description"]</p>
                            </div>
                            <button type="button"
                                    class="toolbar-button compact secondary"
                                    data-testid="settings-refresh-boost-rules"
                                    disabled="@_settingsBoostLoading"
                                    @onclick="LoadBoostRulesAsync">@L["Settings.BoostRules.Refresh"]</button>
                        </header>
                        @if (!string.IsNullOrWhiteSpace(_settingsBoostStatus))
                        {
                            <p class="settings-muted" data-testid="settings-boost-rules-status">@_settingsBoostStatus</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(_settingsBoostError))
                        {
                            <p class="settings-error" data-testid="settings-boost-rules-error">@_settingsBoostError</p>
                        }
                        @if (_settingsBoostLoading)
                        {
                            <p class="settings-muted" data-testid="settings-boost-rules-loading">@L["Common.Loading"]</p>
                        }
                        else if (_boostRules.Count == 0)
                        {
                            <p class="settings-muted" data-testid="settings-boost-rules-empty">@L["Settings.BoostRules.Empty"]</p>
                        }
                        else
                        {
                            <div class="ignore-rule-toolbar" data-testid="settings-boost-rules-toolbar">
                                <button type="button"
                                        class="toolbar-button compact secondary"
                                        data-testid="settings-boost-rules-select-all"
                                        disabled="@_settingsBoostDeleteBusy"
                                        @onclick="ToggleAllBoostRulesAsync">@BuildBoostRuleSelectAllLabel()</button>
                                <span class="settings-muted" data-testid="settings-boost-rules-selected-count">@L["Common.SelectedCount", _selectedBoostRulePatterns.Count]</span>
                                <button type="button"
                                        class="toolbar-button compact danger"
                                        data-testid="settings-delete-selected-boost-rules"
                                        disabled="@IsDeleteSelectedBoostRulesDisabled()"
                                        @onclick="DeleteSelectedBoostRulesAsync">@L["Common.DeleteSelected"]</button>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_settingsBoostDeleteStatus))
                            {
                                <p class="settings-muted" data-testid="settings-boost-rules-delete-status">@_settingsBoostDeleteStatus</p>
                            }
                            <div class="ignore-rule-list" data-testid="settings-boost-rules-list">
                                @foreach (var rule in _boostRules)
                                {
                                    <article class="ignore-rule-row boost-rule-row" data-testid="settings-boost-rule">
                                        <label class="ignore-rule-pattern-select">
                                            <input type="checkbox"
                                                   data-testid="settings-boost-rule-select"
                                                   checked="@IsBoostRuleSelected(rule.Pattern)"
                                                   disabled="@_settingsBoostDeleteBusy"
                                                   @onchange="() => ToggleBoostRuleSelection(rule.Pattern)" />
                                            <code data-testid="settings-boost-rule-pattern">@rule.Pattern</code>
                                        </label>
                                        <div class="ignore-rule-meta">
                                            <strong data-testid="settings-boost-rule-delta">@FormatBoostDelta(rule.Delta)</strong>
                                            @if (!string.IsNullOrWhiteSpace(rule.Reason))
                                            {
                                                <span data-testid="settings-boost-rule-reason">@rule.Reason</span>
                                            }
                                            <time datetime="@rule.CreatedAt.ToString("O", System.Globalization.CultureInfo.InvariantCulture)"
                                                  data-testid="settings-boost-rule-created">@FormatCreatedAt(rule.CreatedAt)</time>
                                            <button type="button"
                                                    class="toolbar-button compact danger"
                                                    data-testid="settings-delete-boost-rule"
                                                    disabled="@_settingsBoostDeleteBusy"
                                                    @onclick="() => DeleteBoostRulesAsync([rule.Pattern])">@L["Common.Delete"]</button>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </section>
                    <section class="settings-section" data-testid="settings-ignore-rules">
                        <header class="settings-subheader">
                            <h3>@L["Settings.IgnoreList"]</h3>
                            <button type="button"
                                    class="toolbar-button compact secondary"
                                    data-testid="settings-refresh-ignore-rules"
                                    disabled="@_settingsLoading"
                                    @onclick="LoadIgnoreRulesAsync">@L["Settings.IgnoreList.Refresh"]</button>
                        </header>
                        @if (_settingsLoading)
                        {
                            <p class="settings-muted" data-testid="settings-ignore-rules-loading">@L["Common.Loading"]</p>
                        }
                        else if (!string.IsNullOrEmpty(_settingsError))
                        {
                            <p class="settings-error" data-testid="settings-ignore-rules-error">@_settingsError</p>
                        }
                        else if (_ignoreRules.Count == 0)
                        {
                            <p class="settings-muted" data-testid="settings-ignore-rules-empty">@L["Settings.IgnoreList.Empty"]</p>
                        }
                        else
                        {
                            <div class="ignore-rule-toolbar" data-testid="settings-ignore-rules-toolbar">
                                <button type="button"
                                        class="toolbar-button compact secondary"
                                        data-testid="settings-ignore-rules-select-all"
                                        disabled="@_settingsDeleteBusy"
                                        @onclick="ToggleAllIgnoreRulesAsync">@BuildIgnoreRuleSelectAllLabel()</button>
                                <span class="settings-muted" data-testid="settings-ignore-rules-selected-count">@L["Common.SelectedCount", _selectedIgnoreRulePatterns.Count]</span>
                                <button type="button"
                                        class="toolbar-button compact danger"
