    private async Task RefreshStateAsync()
    {
        var session = Services.GetRequiredService<IGitHubAuthSession>();
        _state = await session.GetStateAsync(CancellationToken.None);
    }

    private async Task OnTriageAsync()
    {
        CloseTriagePreflight();
        await RefreshStateAsync();
        if (_state != GitHubAuthState.SignedIn)
        {
            _lastError = L["TriagePreflight.SignInRequiredToRun"];
            StateHasChanged();
            return;
        }

        _busy = true;
        _lastError = null;
        _lastReport = null;
        _triageStartedAt = DateTimeOffset.UtcNow;
        _triageElapsed = TimeSpan.Zero;
        _triageStatus = L["AppHeader.TriageStarting"];
        StartTriageTimer();
        StateHasChanged();
        try
        {
            var agent = Services.GetRequiredService<ICopilotAgent>();
            var progress = new Progress<string>(message =>
            {
                _triageStatus = message;
                _ = InvokeAsync(StateHasChanged);
            });
            _lastReport = await agent.RunMorningTriageAsync(progress, CancellationToken.None);
            // Reuse the review broadcaster so Sidebar/CommitList re-query their
            // data the moment Triage finishes. The broadcaster is a no-op
            // pub/sub so we can publish freely without coupling to a triage-specific bus.
            _broadcaster?.Publish();
            _triageStatus = _lastReport.RemainingUnscoredCommitCount is > 0
                ? L["AppHeader.TriageCompletedWithRemaining", _lastReport.RemainingUnscoredCommitCount]
                : L["AppHeader.TriageCompleted"];
        }
        catch (Exception ex)
        {
            _lastError = $"{L["AppHeader.TriageFailed"]}: {ex.Message}";
            _triageStatus = L["AppHeader.TriageFailedStatus"];
        }
        finally
        {
            _busy = false;
            StopTriageTimer();
        }
    }

    private async Task OnPreflightAsync()
    {
        if (_preflightBusy)
        {
            return;
        }

        await RefreshStateAsync();
        _preflightCts?.Cancel();
        _preflightCts?.Dispose();
        var cts = new CancellationTokenSource();
        _preflightCts = cts;
        _preflightOpen = true;
        _preflightBusy = true;
        _preflightSummary = null;
        _preflightError = null;
        StateHasChanged();

        try
        {
            var agent = Services.GetRequiredService<ICopilotAgent>();
            var includeGitHubEstimate = _state == GitHubAuthState.SignedIn;
            var summary = await agent.BuildMorningTriagePreflightAsync(includeGitHubEstimate, cts.Token);
            if (ReferenceEquals(_preflightCts, cts))
            {
                _preflightSummary = summary;
            }
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            if (ReferenceEquals(_preflightCts, cts))
            {
                _preflightError = $"{L["TriagePreflight.Failed"]}: {ex.Message}";
            }
        }
        finally
        {
            if (ReferenceEquals(_preflightCts, cts))
            {
                _preflightBusy = false;
                _preflightCts.Dispose();
                _preflightCts = null;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task RunTriageFromPreflightAsync()
    {
        if (_state != GitHubAuthState.SignedIn || _busy || _preflightBusy)
        {
            return;
        }

        CloseTriagePreflight();
        await OnTriageAsync();
    }

    private void CloseTriagePreflight()
    {
        _preflightCts?.Cancel();
        _preflightCts?.Dispose();
        _preflightCts = null;
        _preflightBusy = false;
        _preflightOpen = false;
        _preflightSummary = null;
        _preflightError = null;
    }

