        _updateService = Services.GetService<IAppUpdateService>();
        _displayCulture = AppDisplayCulture.Apply(DisplayCulture).Name;
        if (_usageTracker is not null)
        {
            _copilotUsage = _usageTracker.GetSnapshot();
            _usageTracker.Changed += OnCopilotUsageChanged;
        }

        if (_updateService is not null)
        {
            _appUpdateActivity = _updateService.CurrentActivity;
            _updateService.ActivityChanged += OnAppUpdateActivityChanged;
        }

