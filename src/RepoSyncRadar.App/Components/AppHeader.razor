        _triageTimerCts.Cancel();
        _triageTimerCts.Dispose();
        _triageTimerCts = null;
    }

    private async Task UpdateTriageElapsedAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (_triageStartedAt is { } startedAt)
                {
                    _triageElapsed = ProgressElapsedDisplay.Advance(_triageElapsed, startedAt, DateTimeOffset.UtcNow);
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private static string FormatElapsed(TimeSpan elapsed)
    {
        return elapsed.TotalHours >= 1
            ? $"{(int)elapsed.TotalHours}:{elapsed.Minutes:D2}:{elapsed.Seconds:D2}"
            : $"{elapsed.Minutes:D2}:{elapsed.Seconds:D2}";
    }

    private string FormatTriageStatus(string status)
    {
        return status;
    }

    private TriageProgressView? BuildTriageProgressView(string status)
    {
        if (!_busy)
        {
            return null;
        }

        if (BuildTriageIngestionProgressView(status) is { } ingestionProgress)
        {
            return ingestionProgress;
        }

        if (BuildTriageScoringProgressView(status) is { } scoringProgress)
        {
            return scoringProgress;
        }

        return BuildTriageGenericProgressView(status);
    }

    private TriageProgressView? BuildTriageScoringProgressView(string status)
    {
        if (!TryReadCountAfter(status, "対象", out var targetCount) ||
            !TryReadProgressAfter(status, "分析", out var analyzedCount, out var analyzedTotalCount) ||
            !TryReadProgressAfter(status, "スコア保存", out var savedCount, out var savedTotalCount))
        {
            return null;
        }

        var totalCount = Math.Max(Math.Max(targetCount, analyzedTotalCount), savedTotalCount);
        var sourcePhase = ExtractTriagePhase(status);
        var currentWork = BuildScoringCurrentWork(sourcePhase, analyzedCount, savedCount, totalCount);
        var metrics = new List<TriageProgressMetric>
        {
            new("target", L["TriageProgress.Target"], FormatCount(targetCount)),
            new("analyzed", L["TriageProgress.Analyzed"], FormatProgressCount(analyzedCount, totalCount)),
            new("saved", L["TriageProgress.Saved"], FormatProgressCount(savedCount, totalCount)),
        };
        AddReferenceMetricIfPresent(metrics, status);

        return new TriageProgressView(
            currentWork,
            metrics,
            L["TriageProgress.AriaWithMetrics", currentWork, BuildMetricAriaText(metrics), FormatElapsed(_triageElapsed)]);
    }

    private TriageProgressView? BuildTriageIngestionProgressView(string status)
    {
        if (!TryReadCountAfter(status, "新規", out var insertedCount) ||
            !TryReadCountAfter(status, "取得", out var fetchedCount))
        {
            return null;
        }

        var sourcePhase = ExtractTriagePhase(status);
        var currentWork = BuildTriageCurrentWork(sourcePhase);
        var metrics = new List<TriageProgressMetric>
        {
            new("inserted", L["TriageProgress.Inserted"], FormatCount(insertedCount)),
            new("fetched", L["TriageProgress.Fetched"], FormatCount(fetchedCount)),
        };
        AddCountMetricIfPresent(metrics, status, "skipped", "スキップ", L["TriageProgress.Skipped"]);
        AddReferenceMetricIfPresent(metrics, status);
        return new TriageProgressView(
            currentWork,
            metrics,
            L["TriageProgress.AriaWithMetrics", currentWork, BuildMetricAriaText(metrics), FormatElapsed(_triageElapsed)]);
    }

    private TriageProgressView BuildTriageGenericProgressView(string status)
    {
        var sourcePhase = ExtractTriagePhase(status);
        var metrics = new List<TriageProgressMetric>();
        AddCountMetricIfPresent(metrics, status, "fetched", "取得", L["TriageProgress.Fetched"]);
        AddCountMetricIfPresent(metrics, status, "inserted", "新規", L["TriageProgress.Inserted"]);
        AddCountMetricIfPresent(metrics, status, "skipped", "スキップ", L["TriageProgress.Skipped"]);
        AddReferenceMetricIfPresent(metrics, status);

        return new TriageProgressView(
            BuildTriageCurrentWork(sourcePhase),
            metrics,
            metrics.Count == 0
                ? L["TriageProgress.AriaWithoutMetrics", BuildTriageCurrentWork(sourcePhase), FormatElapsed(_triageElapsed)]
                : L["TriageProgress.AriaWithMetrics", BuildTriageCurrentWork(sourcePhase), BuildMetricAriaText(metrics), FormatElapsed(_triageElapsed)]);
    }

    private void AddCountMetricIfPresent(List<TriageProgressMetric> metrics, string status, string testIdSuffix, string sourceLabel, string displayLabel)
    {
        if (TryReadCountAfter(status, sourceLabel, out var count))
        {
            metrics.Add(new TriageProgressMetric(testIdSuffix, displayLabel, FormatCount(count)));
        }
    }

    private void AddReferenceMetricIfPresent(List<TriageProgressMetric> metrics, string status)
    {
        if (TryReadTrailingParenthesizedValue(status, out var reference))
        {
            metrics.Add(new TriageProgressMetric("reference", L["TriageProgress.Commit"], reference));
        }
    }

    private static bool TryReadTrailingParenthesizedValue(string status, out string value)
    {
        value = string.Empty;
        var endIndex = status.LastIndexOf(')');
        if (endIndex != status.Length - 1)
        {
            return false;
        }

        var startIndex = status.LastIndexOf('(');
        if (startIndex < 0 || startIndex >= endIndex - 1)
        {
            return false;
        }

        value = status[(startIndex + 1)..endIndex].Trim();
        return value.Length > 0;
    }

    private string BuildMetricAriaText(IReadOnlyList<TriageProgressMetric> metrics)
        => string.Join(L["Common.ListSeparator"], metrics.Select(static metric => $"{metric.Label} {metric.Value}"));

    private string BuildScoringCurrentWork(string sourcePhase, int analyzedCount, int savedCount, int totalCount)
    {
        if (sourcePhase.Contains("分析", StringComparison.Ordinal))
        {
            var currentCount = Math.Max(1, Math.Min(analyzedCount, Math.Max(totalCount, 1)));
            return L["TriageProgress.CurrentAnalyzing", currentCount, totalCount];
        }

        if (sourcePhase.Contains("完了", StringComparison.Ordinal))
        {
            return L["TriageProgress.CurrentApplyingScores"];
        }

        if (savedCount < analyzedCount)
        {
            return L["TriageProgress.CurrentSavingScores"];
        }

        return L["TriageProgress.CurrentScoring"];
    }

    private string BuildTriageCurrentWork(string sourcePhase)
    {
        if (sourcePhase.Contains("スコアリング", StringComparison.Ordinal))
        {
            return L["TriageProgress.CurrentScoring"];
        }

        if (sourcePhase.Contains("取り込み", StringComparison.Ordinal))
        {
            return L["TriageProgress.CurrentIngesting"];
        }

        if (sourcePhase.Contains("Repo sync PR", StringComparison.Ordinal) &&
            sourcePhase.Contains("取得", StringComparison.Ordinal))
        {
            return L["TriageProgress.CurrentFetching"];
        }

        if (sourcePhase.Contains("Copilot セッション", StringComparison.Ordinal))
        {
            return L["TriageProgress.CurrentPreparingCopilot"];
        }

        if (sourcePhase.Contains("スコアリングを開始", StringComparison.Ordinal))
        {
            return L["TriageProgress.CurrentStartingScoring"];
        }

        return LocalizeKnownTriagePhase(sourcePhase);
    }

    private string LocalizeKnownTriagePhase(string sourcePhase)
        => sourcePhase switch
        {
            "Triage を開始しています…" => L["AppHeader.TriageStarting"],
            "Triage 完了" => L["AppHeader.TriageCompleted"],
            _ => sourcePhase,
        };

    private static string ExtractTriagePhase(string status)
    {
        var separatorIndex = status.IndexOf(':', StringComparison.Ordinal);
        return separatorIndex > 0
            ? status[..separatorIndex].Trim()
            : status.Trim();
    }

    private static bool TryReadCountAfter(string status, string label, out int count)
    {
        count = 0;
        foreach (var startIndex in FindValueStarts(status, label))
        {
            if (TryReadInt(status, startIndex, out count, out _))
            {
                return true;
            }
        }

        return false;
    }

    private static bool TryReadProgressAfter(string status, string label, out int currentCount, out int totalCount)
    {
        currentCount = 0;
        totalCount = 0;

        foreach (var startIndex in FindValueStarts(status, label))
        {
            if (!TryReadInt(status, startIndex, out currentCount, out var afterCurrentIndex))
            {
                continue;
            }

            var separatorIndex = status.IndexOf('/', afterCurrentIndex);
            if (separatorIndex >= 0 && TryReadInt(status, separatorIndex + 1, out totalCount, out _))
            {
                return true;
            }
        }

        return false;
    }

    private static IEnumerable<int> FindValueStarts(string status, string label)
    {
        var searchIndex = 0;
        while (searchIndex < status.Length)
        {
            var labelIndex = status.IndexOf(label, searchIndex, StringComparison.Ordinal);
            if (labelIndex < 0)
            {
                yield break;
            }

            var valueIndex = labelIndex + label.Length;
            while (valueIndex < status.Length && char.IsWhiteSpace(status[valueIndex]))
            {
                valueIndex++;
            }

            yield return valueIndex;
            searchIndex = labelIndex + label.Length;
        }
    }

    private static bool TryReadInt(string text, int startIndex, out int value, out int nextIndex)
    {
        value = 0;
        nextIndex = startIndex;
        while (nextIndex < text.Length && char.IsWhiteSpace(text[nextIndex]))
        {
            nextIndex++;
        }

        var digitStartIndex = nextIndex;
        while (nextIndex < text.Length && char.IsDigit(text[nextIndex]))
        {
            nextIndex++;
        }

        return nextIndex > digitStartIndex &&
            int.TryParse(text.AsSpan(digitStartIndex, nextIndex - digitStartIndex), System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out value);
    }

