@* PreviewActions — selected commit preview controls. The main button opens a
    before/after comparison (first parent vs PR HEAD) so the view stays useful even
    after docs.github.com has already deployed the change. *@

@using System.Threading
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Options
@using RepoSyncRadar.Core.Models
@using RepoSyncRadar.Core.Options
@using RepoSyncRadar.Core.Services.Preview
@implements IDisposable

<div class="radar-preview-actions action-panel" data-testid="preview-actions">
    <header class="action-panel-header">
        <div>
            <h3>プレビュー</h3>
            <p>変更前と PR HEAD の docs 表示を右ペインで比較します。</p>
        </div>
    </header>

    @if (_busy)
    {
        @* P1: 起動中はスピナー + 経過秒 + ログ tail + 中止ボタンを表示。
           silent な 600 秒待ちを潰すため。
           P2: stdout / stderr を別 pre で表示。stderr の warning が連続すると
           stdout (Next.js の起動進捗) が押し出される問題を回避。PID も表示し、
           Task Manager / netstat で外部確認できるようにする。 *@
        <div class="preview-progress" data-testid="preview-progress">
            <div class="preview-progress-row">
                <span class="preview-spinner" aria-hidden="true"></span>
                <span class="preview-progress-text" data-testid="preview-progress-text">
                    @(_status ?? "起動中…")
                    <span class="preview-progress-elapsed" data-testid="preview-progress-elapsed">
                        ・ @_elapsedSec 秒経過 / 上限 @_timeoutSec 秒
                        @if (_pid is { } pid)
                        {
                            <span class="preview-progress-pid" data-testid="preview-progress-pid">・ PID @pid</span>
                        }
                    </span>
                </span>
                <button type="button"
                        data-testid="preview-cancel-button"
                        class="preview-cancel"
                        disabled="@_canceling"
                        @onclick="CancelAsync">@(_canceling ? "中止中…" : "中止")</button>
            </div>
            @if (_stdoutTail.Count > 0)
            {
                <pre class="preview-log-tail preview-log-stdout" data-testid="preview-log-stdout">@string.Join('\n', _stdoutTail)</pre>
            }
            @if (_stderrTail.Count > 0)
            {
                <pre class="preview-log-tail preview-log-stderr" data-testid="preview-log-stderr">@string.Join('\n', _stderrTail)</pre>
            }
        </div>
    }
    else
    {
        var previewFiles = GetPreviewableFiles(Commit);
        <div class="action-toolbar">
            <button type="button"
                data-testid="preview-button"
                class="toolbar-button primary preview"
                disabled="@(Commit is null)"
                @onclick="PreviewAsync">比較プレビューを開く</button>

            <button type="button"
                data-testid="preview-cleanup-button"
                class="toolbar-button secondary preview-cleanup"
                title="キャッシュされた docs worktree をすべて削除します"
                @onclick="CleanupAsync">キャッシュ削除</button>
        </div>

        @if (previewFiles.Count > 1)
        {
            <div class="preview-file-switcher" data-testid="preview-file-switcher">
                <div class="preview-file-switcher-header">
                    <span>ファイル</span>
                    <span>@previewFiles.Count 件</span>
                </div>
                <div class="preview-file-switcher-list">
                    @foreach (var previewFile in previewFiles)
                    {
                        <button type="button"
                                class="@BuildPreviewFileButtonClass(previewFile.Path)"
                                data-testid="preview-file-switch"
                                data-path="@previewFile.Path"
                                disabled="@_busy"
                                @onclick="() => PreviewFileAsync(previewFile.Path)">
                            <span class="preview-file-switch-index">@previewFile.Ordinal/@previewFile.Total</span>
                            <span class="preview-file-switch-path">@previewFile.Path</span>
                            @if (previewFile.IsMarkdownOnly)
                            {
                                <span class="preview-file-switch-kind">Markdown</span>
                            }
                        </button>
                    }
                </div>
            </div>
        }

        @if (_lastUrl is not null)
        {
            <a href="@_lastUrl.AbsoluteUri"
               data-testid="preview-url"
               target="_blank"
               rel="noopener">@_lastUrl.AbsoluteUri</a>
        }
        @if (!string.IsNullOrEmpty(_status))
        {
            <p class="action-status" data-testid="preview-status">@_status</p>
        }
        @if (!string.IsNullOrEmpty(_worktreePath))
        {
            <details class="preview-hint" data-testid="preview-worktree">
                <summary>プレビュー worktree</summary>
                <p>初回はアプリがこのディレクトリで <code>npm install</code> を自動実行します (5〜15 分・1〜2 GB)。失敗した場合だけ、同じコマンドを手元で再現できます。</p>
                <pre><code>cd "@_worktreePath"
npm install</code></pre>
                <p class="muted">node_modules を共有して高速化したい場合は <code>docs/USAGE.md §5.1</code> の案 B (junction) を参照してください。</p>
            </details>
        }
    }
</div>

@code {
    private const int MaxLogTailLines = 10;
    private static readonly TimeSpan PollInterval = TimeSpan.FromMilliseconds(500);

    [CascadingParameter] public IServiceProvider Services { get; set; } = default!;

    [Parameter] public Commit? Commit { get; set; }

    private bool _busy;
    private bool _canceling;
    private string? _status;
    private Uri? _lastUrl;
    private string? _worktreePath;
    private string? _activePreviewSha;
    private string? _activePreviewPath;
    private string _busyCancellationSubject = "プレビュー起動";
    private CancellationTokenSource? _cts;
    private DateTimeOffset _startedAt;
    private int _elapsedSec;
    private int _timeoutSec = 600;
    private List<string> _stdoutTail = new();
    private List<string> _stderrTail = new();
    private int? _pid;
    private Task? _pollTask;
    private CancellationTokenSource? _predictivePrewarmCts;

    protected override void OnParametersSet()
    {
        var sha = Commit?.Sha;
        if (string.Equals(_activePreviewSha, sha, StringComparison.Ordinal))
        {
            return;
        }

        _activePreviewSha = sha;
        _activePreviewPath = null;

        // Predictive prewarm: the moment the user selects a different PR/commit we
        // start the bare-clone+fetch in the background so the eventual
        // "ローカルプレビュー" click only pays the worktree-add + npm install +
        // dev server compile cost. Cancel any in-flight prewarm from the
        // previous selection — the new one supersedes it. Fire-and-forget; the
        // coordinator already swallows its own failures.
        try { _predictivePrewarmCts?.Cancel(); } catch (ObjectDisposedException) { }
        _predictivePrewarmCts?.Dispose();
        _predictivePrewarmCts = null;

        if (Commit is { PrNumber: > 0 } commit
            && !string.IsNullOrEmpty(sha)
            && Services.GetService<IPreviewCoordinator>() is { } coordinator)
        {
            var cts = new CancellationTokenSource();
            _predictivePrewarmCts = cts;
            var prNumber = commit.PrNumber;
            var capturedSha = sha;
            _ = Task.Run(
                () => coordinator.PredictivePrewarmAsync(prNumber, capturedSha, cts.Token),
                CancellationToken.None);
        }
    }

    private async Task PreviewAsync()
        => await PreviewFileAsync(filePath: null);

    private async Task PreviewFileAsync(string? filePath)
    {
        if (Commit is null || _busy)
        {
            return;
        }
        StartBusyOperation("リポジトリを準備中…", "プレビュー起動", clearWorktreePath: false);
        var token = _cts?.Token ?? throw new InvalidOperationException("Busy operation token was not initialized.");
        var host = Services.GetRequiredService<PreviewServerHost>();
        _pollTask = Task.Run(() => PollProgressAsync(host, includePreviewServerState: true, token), CancellationToken.None);
        try
        {
            var coordinator = Services.GetRequiredService<IPreviewCoordinator>();
            var progress = new Progress<string>(message =>
            {
                _ = InvokeAsync(() =>
                {
                    _status = message;
                    StateHasChanged();
                });
            });
            var targetFilePath = filePath ?? ChooseDefaultPreviewFilePath(Commit);
            if (targetFilePath is null)
            {
                _status = "このコミットには公開ドキュメント記事または Markdown ファイルがないため、ローカルプレビューで比較できません";
                _worktreePath = null;
                return;
            }

            if (PreviewPathMapper.Map(targetFilePath, "en") is not null)
            {
                await PreviewContentComparisonAsync(coordinator, targetFilePath, progress, token);
                return;
            }

            if (PreviewPathMapper.IsMarkdown(targetFilePath))
            {
                await PreviewMarkdownAsync(coordinator, targetFilePath, progress, token);
                return;
            }

            _status = "このファイルはプレビュー対象ではありません";
        }
        finally
        {
            // Stop the polling loop before clearing _busy so the UI does not
            // briefly show "起動中…" with a stale elapsed counter after success.
            await FinishBusyOperationAsync();
        }
    }

    private Task CancelAsync()
    {
        if (!_busy || _cts is null || _canceling)
        {
            return Task.CompletedTask;
        }
        _canceling = true;
        try { _cts.Cancel(); } catch (ObjectDisposedException) { }
        return Task.CompletedTask;
    }

    private void ArmPreviewTimeout(CancellationTokenSource cts)
    {
        if (_timeoutSec > 0)
        {
            cts.CancelAfter(TimeSpan.FromSeconds(_timeoutSec));
        }
    }

    private string BuildCancellationStatus()
        => _canceling
            ? $"{_busyCancellationSubject}を中止しました"
            : $"{_busyCancellationSubject}が上限 {_timeoutSec} 秒を超えたため中止しました";

    private void StartBusyOperation(string status, string cancellationSubject, bool clearWorktreePath)
    {
        _busy = true;
        _canceling = false;
        _busyCancellationSubject = cancellationSubject;
        _status = status;
        _lastUrl = null;
        if (clearWorktreePath)
        {
            _worktreePath = null;
        }
        _stdoutTail = new List<string>();
        _stderrTail = new List<string>();
        _pid = null;
        _startedAt = DateTimeOffset.UtcNow;
        _elapsedSec = 0;
        _timeoutSec = Services.GetRequiredService<IOptions<DocsRepositoryOptions>>().Value.PreviewReadyTimeoutSeconds;
        _cts = new CancellationTokenSource();
        ArmPreviewTimeout(_cts);
    }

    private async Task FinishBusyOperationAsync()
    {
        try { _cts?.Cancel(); } catch (ObjectDisposedException) { }
        if (_pollTask is not null)
        {
            try { await _pollTask.ConfigureAwait(false); }
            catch (OperationCanceledException) { /* expected */ }
            _pollTask = null;
        }
        _cts?.Dispose();
        _cts = null;
        _busy = false;
        _canceling = false;
    }

    /// <summary>
    /// 500 ms ごとに経過秒を読んで UI を再描画する。プレビュー起動時は
    /// PreviewServerHost のログ tail / PID も更新する。
    /// </summary>
    private async Task PollProgressAsync(PreviewServerHost? host, bool includePreviewServerState, CancellationToken token)
    {
        try
        {
            using var timer = new PeriodicTimer(PollInterval);
            while (await timer.WaitForNextTickAsync(token).ConfigureAwait(false))
            {
                var stdoutTail = includePreviewServerState && host is not null
                    ? TakeTail(host.RecentStdoutLines, MaxLogTailLines)
                    : _stdoutTail;
                var stderrTail = includePreviewServerState && host is not null
                    ? TakeTail(host.RecentStderrLines, MaxLogTailLines)
                    : _stderrTail;
                var pid = includePreviewServerState && host is not null
                    ? host.CurrentProcessId
                    : _pid;
                var elapsed = (int)(DateTimeOffset.UtcNow - _startedAt).TotalSeconds;
                await InvokeAsync(() =>
                {
                    _stdoutTail = stdoutTail;
                    _stderrTail = stderrTail;
                    _pid = pid;
                    _elapsedSec = elapsed;
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // expected: PreviewAsync's finally block cancels _cts to stop us.
        }
    }

    private static List<string> TakeTail(IReadOnlyList<string> source, int take)
    {
        if (source.Count <= take)
        {
            return new List<string>(source);
        }
        var result = new List<string>(take);
        for (var i = source.Count - take; i < source.Count; i++)
        {
            result.Add(source[i]);
        }
        return result;
    }

    private static string? ChooseDefaultPreviewFilePath(Commit commit)
    {
        foreach (var file in commit.Files)
        {
            if (IsPreviewableFile(file.Path))
            {
                return file.Path;
            }
        }
        return null;
    }

    private async Task PreviewMarkdownAsync(
        IPreviewCoordinator coordinator,
        string filePath,
        IProgress<string> progress,
        CancellationToken token)
    {
        PreviewComparisonLink? link;
        try
        {
            link = await coordinator.PrepareMarkdownComparisonPreviewAsync(
                Commit!.PrNumber,
                Commit.Sha,
                filePath,
                progress,
                token);
        }
        catch (OperationCanceledException)
        {
            _status = BuildCancellationStatus();
            _worktreePath = null;
            return;
        }
        catch (Exception ex)
        {
            _status = ex.Message;
            _worktreePath = null;
            return;
        }

        if (link is null)
        {
            _status = "プレビュー機能は無効です (DocsRepository 未設定)";
            _worktreePath = null;
            return;
        }

        _lastUrl = link.AfterUrl;
        _worktreePath = link.AfterWorktreePath;
        _activePreviewPath = filePath;
        var previewPosition = GetPreviewPosition(Commit!, filePath);
        Services.GetRequiredService<IPreviewNavigator>().PublishComparison(new PreviewComparisonRequest(
            link.BeforeUrl,
            link.AfterUrl,
            $"変更前 {ShortSha(link.BeforeSha)} Markdown",
            $"PR HEAD {ShortSha(link.AfterSha)} Markdown",
            filePath,
            previewPosition.Ordinal,
            previewPosition.Total));
        _status = $"{filePath} を Markdown として変更前 / PR HEAD で比較表示しました";
    }

    private async Task PreviewContentComparisonAsync(
        IPreviewCoordinator coordinator,
        string filePath,
        IProgress<string> progress,
        CancellationToken token)
    {
        PreviewComparisonLink? link;
        try
        {
            link = await coordinator.PrepareComparisonPreviewAsync(
                Commit!.PrNumber,
                Commit.Sha,
                filePath,
                progress,
                token);
        }
        catch (OperationCanceledException)
        {
            _status = BuildCancellationStatus();
            _worktreePath = null;
            return;
        }
        catch (Exception ex)
        {
            _status = ex.Message;
            _worktreePath = null;
            return;
        }

        if (link is null)
        {
            _status = "プレビュー機能は無効です (DocsRepository 未設定)";
            _worktreePath = null;
            return;
        }

        var previewPosition = GetPreviewPosition(Commit!, filePath);
        _lastUrl = link.AfterUrl;
        _worktreePath = link.AfterWorktreePath;
        _activePreviewPath = filePath;
        Services.GetRequiredService<IPreviewNavigator>().PublishComparison(new PreviewComparisonRequest(
            link.BeforeUrl,
            link.AfterUrl,
            $"変更前 {ShortSha(link.BeforeSha)} localhost",
            $"PR HEAD {ShortSha(link.AfterSha)} localhost",
            filePath,
            previewPosition.Ordinal,
            previewPosition.Total));
        _status = $"{filePath} を変更前 / PR HEAD で比較表示しました";
    }

    private static PreviewFilePosition GetPreviewPosition(Commit commit, string filePath)
    {
        var previewFiles = GetPreviewableFiles(commit);
        var match = previewFiles.FirstOrDefault(file => string.Equals(file.Path, filePath, StringComparison.Ordinal));
        return match is null
            ? default
            : new PreviewFilePosition(match.Ordinal, match.Total);
    }

    private static List<PreviewFileChoice> GetPreviewableFiles(Commit? commit)
    {
        var files = new List<PreviewFileChoice>();
        if (commit is null)
        {
            return files;
        }

        foreach (var file in commit.Files)
        {
            if (!IsPreviewableFile(file.Path))
            {
                continue;
            }
            files.Add(new PreviewFileChoice(
                files.Count + 1,
                Total: 0,
                file.Path,
                IsMarkdownOnly: PreviewPathMapper.Map(file.Path, "en") is null));
        }

        var total = files.Count;
        for (var index = 0; index < files.Count; index++)
        {
            files[index] = files[index] with { Total = total };
        }
        return files;
    }

    private static bool IsPreviewableFile(string filePath)
        => PreviewPathMapper.Map(filePath, "en") is not null || PreviewPathMapper.IsMarkdown(filePath);

    private string BuildPreviewFileButtonClass(string filePath)
        => string.Equals(_activePreviewPath, filePath, StringComparison.Ordinal)
            ? "preview-file-switch active"
            : "preview-file-switch";

    private static string ShortSha(string sha)
        => sha.Length <= 7 ? sha : sha[..7];

    private readonly record struct PreviewFilePosition(int Ordinal, int Total);

    private sealed record PreviewFileChoice(int Ordinal, int Total, string Path, bool IsMarkdownOnly);

    private async Task CleanupAsync()
    {
        if (_busy)
        {
            return;
        }
        StartBusyOperation("キャッシュをクリーンアップ中…", "キャッシュ削除", clearWorktreePath: true);
        var token = _cts?.Token ?? throw new InvalidOperationException("Busy operation token was not initialized.");
        _pollTask = Task.Run(() => PollProgressAsync(host: null, includePreviewServerState: false, token), CancellationToken.None);
        StateHasChanged();
        try
        {
            var coordinator = Services.GetRequiredService<IPreviewCoordinator>();
            var removed = await coordinator.CleanupCacheAsync(token);
            _status = $"{removed} 件の worktree を削除しました";
        }
        catch (OperationCanceledException)
        {
            _status = BuildCancellationStatus();
        }
        catch (Exception ex)
        {
            // Surface the error inline rather than letting it escape into the host
            // (same defense-in-depth as PreviewAsync).
            _status = ex.Message;
        }
        finally
        {
            await FinishBusyOperationAsync();
        }
    }

    public void Dispose()
    {
        try { _cts?.Cancel(); } catch (ObjectDisposedException) { }
        _cts?.Dispose();
        _cts = null;
        try { _predictivePrewarmCts?.Cancel(); } catch (ObjectDisposedException) { }
        _predictivePrewarmCts?.Dispose();
        _predictivePrewarmCts = null;
    }
}
