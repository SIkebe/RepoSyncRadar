@* Top-level Razor shell rendered inside the WPF BlazorWebView. Phase 1 wires the
    minimal review surface: Sidebar (status counters) + CommitList (filtered rows) +
    CommitDetail (files + canonical URLs). Diff / WebView2 / review actions land in
    later steps. *@

@inject IServiceProvider Services
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L
@implements IDisposable
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@using RepoSyncRadar.App.Settings

@{ ApplyDisplayCultureForRender(); }

<MudThemeProvider IsDarkMode="@(_theme == DocsThemeMode.Dark)" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingValue Value="Services" IsFixed="true">
<CascadingValue Value="_displayCulture">
    <div class="@BuildShellClass(_theme)" data-theme="@BuildThemeName(_theme)" data-testid="radar-shell">
        <aside class="radar-sidebar-pane">
            <MudText Typo="Typo.h6" Class="mb-2">@L["Workbench.Queues"]</MudText>
            <Sidebar Selected="_selectedStatus"
                     SelectedChanged="HandleStatusChanged"
                     SettingsOpen="_settingsOpen"
                     SettingsClicked="ToggleSettingsAsync"
                     AuthChanged="HandleAuthChangedAsync" />
        </aside>

        <div class="radar-sidebar-resizer"
             role="separator"
             aria-orientation="vertical"
             aria-label="@SidebarResizeLabel"
             tabindex="0"
             data-testid="radar-sidebar-resizer"></div>

        <main class="radar-workbench">
            <AppHeader DisplayCultureChanged="HandleDisplayCultureChanged"
                       SettingsOpen="_settingsOpen"
                       AuthRefreshToken="_authRefreshToken" />

            <MudPaper Elevation="0" Class="pa-2">
                <div class="commit-search-toolbar" data-testid="commit-search-toolbar">
                    <label class="commit-search-label" for="commit-hash-search">@L["Common.Search"]</label>
                    <input id="commit-hash-search"
                           class="commit-search-input"
                           data-testid="commit-hash-search"
                           type="search"
                           autocomplete="off"
                           spellcheck="false"
                           placeholder="@CommitSearchPlaceholder"
                           value="@_commitHashQuery"
                           @oninput="HandleCommitHashSearchChanged" />
                    <button type="button"
                            class="commit-search-clear"
                            data-testid="commit-hash-search-clear"
                            disabled="@string.IsNullOrWhiteSpace(_commitHashQuery)"
                            @onclick="ClearCommitHashSearchAsync">@L["Common.Clear"]</button>
                </div>
                @if (_selectedCommitShas.Count > 0 || !string.IsNullOrWhiteSpace(_bulkReviewStatus))
                {
                    <div class="bulk-review-toolbar" data-testid="bulk-review-toolbar">
                    @if (_selectedCommitShas.Count > 0)
                    {
                        <span class="bulk-review-count" data-testid="bulk-review-count">@L["Common.SelectedCount", _selectedCommitShas.Count]</span>
                        <span class="bulk-review-hint" data-testid="bulk-review-hint">@L["Workbench.BulkReviewHint"]</span>
                        <div class="bulk-review-buttons">
                        @if (CanShowBulkMoveButton(ReviewStatus.Adopted))
                        {
                        <button type="button"
                            class="bulk-review-button adopt"
                            data-testid="bulk-review-adopted"
                            disabled="@IsBulkMoveDisabled(ReviewStatus.Adopted)"
                            @onclick="() => MoveSelectedCommitsAsync(ReviewStatus.Adopted)">@L["Workbench.MoveToWatch"]</button>
                        }
                        @if (CanShowBulkMoveButton(ReviewStatus.Later))
                        {
                        <button type="button"
                            class="bulk-review-button later"
                            data-testid="bulk-review-later"
                            disabled="@IsBulkMoveDisabled(ReviewStatus.Later)"
                            @onclick="() => MoveSelectedCommitsAsync(ReviewStatus.Later)">@L["Workbench.MoveToLater"]</button>
                        }
                        @if (CanShowBulkMoveButton(ReviewStatus.Archived))
                        {
                        <button type="button"
                            class="bulk-review-button archive"
                            data-testid="bulk-review-archived"
                            disabled="@IsBulkMoveDisabled(ReviewStatus.Archived)"
                            @onclick="() => MoveSelectedCommitsAsync(ReviewStatus.Archived)">@L["Workbench.Archive"]</button>
                        }
                        @if (CanShowBulkMoveButton(ReviewStatus.Unseen))
                        {
                        <button type="button"
                            class="bulk-review-button unseen"
                            data-testid="bulk-review-unseen"
                            disabled="@IsBulkMoveDisabled(ReviewStatus.Unseen)"
                            @onclick="() => MoveSelectedCommitsAsync(ReviewStatus.Unseen)">@L["Workbench.BackToUnseen"]</button>
                        }
                        <button type="button"
                            class="bulk-review-button delete"
                            data-testid="bulk-delete-unseen"
                            disabled="@IsBulkDeleteDisabled()"
                            @onclick="DeleteSelectedUnseenCommitsAsync">@L["Workbench.DeleteAndRescore"]</button>
                        @if (CanShowBatchExplanationButton())
                        {
                        <button type="button"
                            class="bulk-review-button explain"
                            data-testid="bulk-explain-adopted"
                            disabled="@IsBatchExplanationDisabled()"
                            @onclick="GenerateSelectedExplanationAsync">@L["Workbench.GenerateExplanations"]</button>
                        }
                        </div>
                    }
                        @if (!string.IsNullOrWhiteSpace(_bulkReviewStatus))
                        {
                            <span class="bulk-review-status" data-testid="bulk-review-status">@_bulkReviewStatus</span>
                        }
                    </div>
                }
                @if (ShouldShowBatchExplanationPanel())
                {
                    <div class="batch-explanation-panel" data-testid="batch-explanation-panel">
                        <header class="batch-explanation-header">
                            <div>
                                <h3>@L["Workbench.BatchExplanationTitle"]</h3>
                                <p>@L["Workbench.BatchExplanationDescription"]</p>
                            </div>
                            <div class="batch-explanation-actions">
                                @if (_batchExplanationBusy)
                                {
                                    <button type="button"
                                            class="toolbar-button secondary compact"
                                            data-testid="batch-explanation-cancel"
                                            disabled="@_batchExplanationCanceling"
                                            @onclick="CancelBatchExplanationAsync">@(_batchExplanationCanceling ? L["Common.Canceling"] : L["Common.Cancel"])</button>
                                }
                            </div>
                        </header>
                        @if (_batchExplanationBusy)
                        {
                            <div class="preview-progress batch-explanation-progress" data-testid="batch-explanation-progress">
                                <div class="preview-progress-row">
                                    <span class="preview-spinner" aria-hidden="true"></span>
                                    <span class="preview-progress-text progress-phase" data-testid="batch-explanation-progress-text">
                                        @L["Workbench.BatchExplanationProgress"]
                                    </span>
                                    <span class="progress-metric progress-metric-elapsed" data-testid="batch-explanation-progress-elapsed">
                                        <span class="progress-metric-label">@L["Common.Elapsed"]</span>
                                        <span class="progress-metric-value">@FormatElapsed(_batchExplanationElapsed)</span>
                                    </span>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_batchExplanationStatus))
                        {
                            <p class="batch-explanation-status" data-testid="batch-explanation-status">@_batchExplanationStatus</p>
                        }
                    </div>
                }
                <CommitList Filter="@_filter"
                            RefreshToken="_listRefreshVersion"
                            SelectedSha="@_selectedCommit?.Sha"
                            SelectedShas="_selectedCommitShas"
                            SelectionChanged="HandleCommitSelectionChanged"
                            OnCommitSelected="HandleCommitSelected" />
            </MudPaper>

            <MudDivider Class="my-2" />

            <MudPaper Elevation="0" Class="pa-2">
                @if (_selectedCommit is not null)
                {
                    @if (CanShowDrafts(_selectedCommit))
                    {
                        <div class="drafts-jump-row" data-testid="drafts-jump-row">
                            <a class="drafts-jump-link" data-testid="drafts-jump-link" href="#drafts-panel">@L["Workbench.GoToExplanations"]</a>
                        </div>
                    }
                    <ReviewActions Sha="@_selectedCommit.Sha"
                                   CurrentStatus="@_selectedCommit.Review?.Status"
                                   CurrentReviewReason="@_selectedCommit.Review?.Reason"
                                   FilePaths="@_selectedCommit.Files.Select(static file => file.Path).ToArray()"
                                   Reviewed="HandleReviewCompleted" />
                }
                <CommitDetail Commit="_selectedCommit" />
                @if (_selectedCommit is not null)
                {
                    @if (CanShowDrafts(_selectedCommit))
                    {
                        <DraftsPanel Sha="@_selectedCommit.Sha" />
                    }
                }
            </MudPaper>
        </main>
    </div>
</CascadingValue>
</CascadingValue>

@code {
    private ReviewStatus? _selectedStatus = ReviewStatus.Unseen;
    private Commit? _selectedCommit;
    private readonly HashSet<string> _selectedCommitShas = new(StringComparer.Ordinal);
    private CommitQueryFilter _filter = new() { Status = ReviewStatus.Unseen };
    private string _commitHashQuery = string.Empty;
    private int _listRefreshVersion;
    private bool _bulkReviewBusy;
    private string? _bulkReviewStatus;
    private bool _batchExplanationBusy;
    private bool _batchExplanationCanceling;
    private string? _batchExplanationStatus;
    private DateTimeOffset _batchExplanationStartedAt;
    private TimeSpan _batchExplanationElapsed;
    private CancellationTokenSource? _batchExplanationCts;
    private Task? _batchExplanationTimerTask;
    private IReviewBroadcaster? _broadcaster;
    private IAppUserSettingsStore? _settingsStore;
    private DocsThemeMode _theme = AppUserSettings.Default.DefaultDocsTheme;
    private string _displayCulture = AppUserSettings.Default.DisplayCulture;
    private bool _settingsOpen;
    private int _authRefreshToken;

    private void ApplyDisplayCultureForRender()
        => AppDisplayCulture.Apply(_displayCulture);

    protected override void OnInitialized()
    {
        _settingsStore = Services.GetService<IAppUserSettingsStore>();
        if (_settingsStore is not null)
        {
            _theme = _settingsStore.Current.DefaultDocsTheme;
            _displayCulture = AppDisplayCulture.Apply(_settingsStore.Current.DisplayCulture).Name;
            _settingsStore.SettingsChanged += OnSettingsChanged;
        }

        _broadcaster = Services.GetService<IReviewBroadcaster>();
        if (_broadcaster is not null)
        {
            _broadcaster.Reviewed += OnReviewed;
        }
    }

    private async void OnSettingsChanged(AppUserSettings settings)
    {
        try
        {
            await InvokeAsync(() =>
            {
                _theme = settings.DefaultDocsTheme;
                _displayCulture = AppDisplayCulture.Apply(settings.DisplayCulture).Name;
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private void HandleDisplayCultureChanged(string cultureName)
        => _displayCulture = AppDisplayCulture.Apply(cultureName).Name;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("repoSyncRadarLayout.initSidebarSplitter", "[data-testid='radar-shell']");
        }
        catch (JSException)
        {
            // The fixed fallback layout remains usable if the helper script is unavailable.
        }
    }

    private async void OnReviewed(object? sender, EventArgs e)
    {
        try
        {
            await InvokeAsync(() =>
            {
                // Replace the Filter reference so CommitList's OnParametersSetAsync
                // detects the change and re-queries IRadarRepository.
                _filter = BuildCurrentFilter();
                _selectedCommitShas.Clear();
                _listRefreshVersion++;
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // Component disposed mid-broadcast; safe to swallow.
        }
    }

    public void Dispose()
    {
        if (_broadcaster is not null)
        {
            _broadcaster.Reviewed -= OnReviewed;
        }
        if (_settingsStore is not null)
        {
            _settingsStore.SettingsChanged -= OnSettingsChanged;
        }
        CancelBatchExplanationProgress();
        _batchExplanationCts?.Dispose();
        _batchExplanationCts = null;
    }

    internal static string BuildShellClass(DocsThemeMode theme)
        => $"radar-shell radar-theme-{BuildThemeName(theme)}";

    internal static string BuildThemeName(DocsThemeMode theme)
        => theme == DocsThemeMode.Light ? "light" : "dark";

    private string SidebarResizeLabel
        => L["Workbench.SidebarResizeLabel"];

    private string CommitSearchPlaceholder
        => L["Workbench.CommitSearchPlaceholder"];

    private Task HandleStatusChanged(ReviewStatus? status)
    {
        _selectedStatus = status;
        _filter = BuildCurrentFilter();
        _selectedCommit = null;
        _selectedCommitShas.Clear();
        _bulkReviewStatus = null;
        ClearBatchExplanation();
        _listRefreshVersion++;
        return Task.CompletedTask;
    }

    private Task ToggleSettingsAsync()
    {
        _settingsOpen = !_settingsOpen;
        return Task.CompletedTask;
    }

    private Task HandleAuthChangedAsync()
    {
        _authRefreshToken++;
        return Task.CompletedTask;
    }

    private Task HandleCommitHashSearchChanged(ChangeEventArgs args)
    {
        _commitHashQuery = args.Value?.ToString() ?? string.Empty;
        RefreshCommitListForCurrentFilter();
        return Task.CompletedTask;
    }

    private Task ClearCommitHashSearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_commitHashQuery))
        {
            return Task.CompletedTask;
        }

        _commitHashQuery = string.Empty;
        RefreshCommitListForCurrentFilter();
        return Task.CompletedTask;
    }

    private void RefreshCommitListForCurrentFilter()
    {
        _filter = BuildCurrentFilter();
        _selectedCommit = null;
        _selectedCommitShas.Clear();
        _bulkReviewStatus = null;
        ClearBatchExplanation();
        _listRefreshVersion++;
    }

    private CommitQueryFilter BuildCurrentFilter()
        => new()
        {
            Status = _selectedStatus,
            ShaQuery = NormalizeCommitSearchQuery(_commitHashQuery),
        };

    private static string? NormalizeCommitSearchQuery(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }
        return value.Trim().ToLowerInvariant();
    }

    private Task HandleCommitSelected(Commit commit)
    {
        _selectedCommit = commit;
        return Task.CompletedTask;
    }

    private Task HandleCommitSelectionChanged(CommitSelectionChange change)
    {
        _bulkReviewStatus = null;
        if (!_batchExplanationBusy)
        {
            ClearBatchExplanation();
        }
        foreach (var sha in change.Shas)
        {
            if (change.Selected)
            {
                _selectedCommitShas.Add(sha);
            }
            else
            {
                _selectedCommitShas.Remove(sha);
            }
        }
        return Task.CompletedTask;
    }

    private bool IsBulkMoveDisabled(ReviewStatus status)
        => !IsBulkMoveSupported(status)
            || _bulkReviewBusy
            || _selectedCommitShas.Count == 0
            || _selectedStatus == status;

    private bool CanShowBulkMoveButton(ReviewStatus status)
        => _selectedStatus != status;

    private bool IsBulkDeleteDisabled()
        => _bulkReviewBusy
            || _selectedCommitShas.Count == 0
            || _selectedStatus != ReviewStatus.Unseen;

    private bool CanShowBatchExplanationButton()
        => _selectedStatus == ReviewStatus.Adopted;

    private bool IsBatchExplanationDisabled()
        => _batchExplanationBusy
            || _bulkReviewBusy
            || _selectedStatus != ReviewStatus.Adopted
            || _selectedCommitShas.Count < 2;

    private bool ShouldShowBatchExplanationPanel()
        => _batchExplanationBusy
            || !string.IsNullOrWhiteSpace(_batchExplanationStatus);

    private async Task MoveSelectedCommitsAsync(ReviewStatus status)
    {
        if (IsBulkMoveDisabled(status))
        {
            return;
        }

        var shas = _selectedCommitShas.ToArray();
        _bulkReviewBusy = true;
        try
        {
            var repo = Services.GetRequiredService<IRadarRepository>();
            foreach (var sha in shas)
            {
                await repo.SetReviewAsync(sha, status, reason: null);
            }

            _selectedCommit = null;
            _selectedCommitShas.Clear();
            _filter = BuildCurrentFilter();
            ClearBatchExplanation();
            _bulkReviewStatus = string.Create(
                System.Globalization.CultureInfo.InvariantCulture,
                $"{L["Workbench.BulkMoved", shas.Length, BuildStatusDestinationLabel(status)]}");
            Services.GetRequiredService<IReviewBroadcaster>().Publish();
        }
        finally
        {
            _bulkReviewBusy = false;
        }
    }

    private static bool IsBulkMoveSupported(ReviewStatus status)
        => status is ReviewStatus.Adopted or ReviewStatus.Later or ReviewStatus.Archived or ReviewStatus.Unseen;

    private async Task DeleteSelectedUnseenCommitsAsync()
    {
        if (IsBulkDeleteDisabled())
        {
            return;
        }

        var shas = _selectedCommitShas.ToArray();
        _bulkReviewBusy = true;
        try
        {
            var deleted = await Services.GetRequiredService<IRadarRepository>()
                .DeleteUnseenCommitsAsync(shas);
            _selectedCommit = null;
            _selectedCommitShas.Clear();
            _selectedStatus = ReviewStatus.Unseen;
            _filter = BuildCurrentFilter();
            _listRefreshVersion++;
            ClearBatchExplanation();
            _bulkReviewStatus = string.Create(
                System.Globalization.CultureInfo.InvariantCulture,
                $"{L["Workbench.DeletedAndCanRescore", deleted]}");
            Services.GetRequiredService<IReviewBroadcaster>().Publish();
        }
        finally
        {
            _bulkReviewBusy = false;
        }
    }

    private string BuildStatusDestinationLabel(ReviewStatus status)
        => status switch
        {
            ReviewStatus.Unseen => L["Sidebar.Unseen.Label"],
            ReviewStatus.Adopted => L["Sidebar.Watch.Label"],
            ReviewStatus.Later => L["Sidebar.Later.Label"],
            ReviewStatus.Rejected => L["Sidebar.Rejected.Label"],
            ReviewStatus.Archived => L["Sidebar.Archive.Label"],
            _ => status.ToString(),
        };

    private static bool CanShowDrafts(Commit commit)
        => commit.Review?.Status == ReviewStatus.Adopted;

    private async Task GenerateSelectedExplanationAsync()
    {
        if (IsBatchExplanationDisabled())
        {
            return;
        }

        var agent = Services.GetService<ICopilotAgent>();
        if (agent is null)
        {
            _batchExplanationStatus = L["Common.AgentNotRegistered"];
            return;
        }

        var shas = _selectedCommitShas.ToArray();
        StartBatchExplanationProgress();
        _batchExplanationStatus = null;
        StateHasChanged();
        try
        {
            var generated = await agent.GenerateBatchExplanationAsync(shas, _batchExplanationCts!.Token);
            _batchExplanationStatus = string.Create(
                System.Globalization.CultureInfo.InvariantCulture,
                $"{L["Workbench.BatchExplanationGenerated", generated]}");
            Services.GetService<IReviewBroadcaster>()?.Publish();
        }
        catch (OperationCanceledException)
        {
            _batchExplanationStatus = L["Workbench.BatchExplanationCanceled"];
        }
        catch (Exception ex)
        {
            _batchExplanationStatus = $"{L["Workbench.BatchExplanationFailed"]}: {BuildFriendlyBatchErrorMessage(ex)}";
        }
        finally
        {
            await StopBatchExplanationProgressAsync();
            StateHasChanged();
        }
    }

    private void StartBatchExplanationProgress()
    {
        _batchExplanationBusy = true;
        _batchExplanationCanceling = false;
        _batchExplanationStartedAt = DateTimeOffset.UtcNow;
        _batchExplanationElapsed = TimeSpan.Zero;
        _batchExplanationCts = new CancellationTokenSource();
        _batchExplanationTimerTask = UpdateBatchExplanationElapsedAsync(_batchExplanationCts.Token);
    }

    private async Task StopBatchExplanationProgressAsync()
    {
        CancelBatchExplanationProgress();
        if (_batchExplanationTimerTask is not null)
        {
            try { await _batchExplanationTimerTask.ConfigureAwait(false); }
            catch (OperationCanceledException) { }
            _batchExplanationTimerTask = null;
        }
        _batchExplanationCts?.Dispose();
        _batchExplanationCts = null;
        _batchExplanationBusy = false;
        _batchExplanationCanceling = false;
    }

    private void CancelBatchExplanationProgress()
    {
        try { _batchExplanationCts?.Cancel(); } catch (ObjectDisposedException) { }
    }

    private async Task UpdateBatchExplanationElapsedAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                _batchExplanationElapsed = ProgressElapsedDisplay.Advance(
                    _batchExplanationElapsed,
                    _batchExplanationStartedAt,
                    DateTimeOffset.UtcNow);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private Task CancelBatchExplanationAsync()
    {
        if (!_batchExplanationBusy || _batchExplanationCts is null || _batchExplanationCanceling)
        {
            return Task.CompletedTask;
        }

        _batchExplanationCanceling = true;
        try { _batchExplanationCts.Cancel(); } catch (ObjectDisposedException) { }
        return Task.CompletedTask;
    }

    private void ClearBatchExplanation()
    {
        if (_batchExplanationBusy)
        {
            return;
        }
        _batchExplanationStatus = null;
    }

    private static string FormatElapsed(TimeSpan elapsed)
        => elapsed.TotalHours >= 1
            ? $"{(int)elapsed.TotalHours}:{elapsed.Minutes:D2}:{elapsed.Seconds:D2}"
            : $"{elapsed.Minutes:D2}:{elapsed.Seconds:D2}";

    private static string BuildFriendlyBatchErrorMessage(Exception ex)
        => ex.Message.Contains("JSON", StringComparison.OrdinalIgnoreCase)
            ? "Copilot の応答を解説として読み取れませんでした。もう一度生成してください。"
            : ex.Message;

    private Task HandleReviewCompleted(ReviewStatus status)
    {
        _filter = BuildCurrentFilter();
        _selectedCommit = null;
        _selectedCommitShas.Clear();
        _bulkReviewStatus = L["Workbench.BulkMoved", 1, BuildStatusDestinationLabel(status)];
        ClearBatchExplanation();
        _listRefreshVersion++;
        return Task.CompletedTask;
    }
}
