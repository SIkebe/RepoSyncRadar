@* Top-level Razor shell rendered inside the WPF BlazorWebView. Phase 1 wires the
    minimal review surface: Sidebar (status counters) + CommitList (filtered rows) +
    CommitDetail (files + canonical URLs). Diff / WebView2 / review actions land in
    later steps. *@

@inject IServiceProvider Services
@inject IJSRuntime JS
@implements IDisposable
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@using RepoSyncRadar.App.Settings

<MudThemeProvider IsDarkMode="@(_theme == DocsThemeMode.Dark)" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingValue Value="Services" IsFixed="true">
    <div class="@BuildShellClass(_theme)" data-theme="@BuildThemeName(_theme)" data-testid="radar-shell">
        <aside class="radar-sidebar-pane">
            <MudText Typo="Typo.h6" Class="mb-2">キュー</MudText>
            <Sidebar Selected="_selectedStatus"
                     SelectedChanged="HandleStatusChanged" />
        </aside>

        <div class="radar-sidebar-resizer"
             role="separator"
             aria-orientation="vertical"
             aria-label="サイドバーと作業ペインの幅を変更"
             tabindex="0"
             data-testid="radar-sidebar-resizer"></div>

        <main class="radar-workbench">
            <AppHeader />

            <MudPaper Elevation="0" Class="pa-2 ask-palette-shell" data-testid="ask-palette-shell">
                <button type="button"
                        class="ask-palette-toggle"
                        data-testid="ask-palette-toggle"
                        aria-expanded="@_askPaletteExpanded.ToString().ToLowerInvariant()"
                        @onclick="ToggleAskPaletteAsync">
                    Ask
                </button>
                @if (_askPaletteExpanded)
                {
                    <AskPalette />
                }
            </MudPaper>

            <MudPaper Elevation="0" Class="pa-2">
                <div class="commit-search-toolbar" data-testid="commit-search-toolbar">
                    <label class="commit-search-label" for="commit-hash-search">検索</label>
                    <input id="commit-hash-search"
                           class="commit-search-input"
                           data-testid="commit-hash-search"
                           type="search"
                           autocomplete="off"
                           spellcheck="false"
                           placeholder="SHA / PR / タイトル"
                           value="@_commitHashQuery"
                           @oninput="HandleCommitHashSearchChanged" />
                    <button type="button"
                            class="commit-search-clear"
                            data-testid="commit-hash-search-clear"
                            disabled="@string.IsNullOrWhiteSpace(_commitHashQuery)"
                            @onclick="ClearCommitHashSearchAsync">クリア</button>
                </div>
                @if (_selectedCommitShas.Count > 0 || !string.IsNullOrWhiteSpace(_bulkReviewStatus))
                {
                    <div class="bulk-review-toolbar" data-testid="bulk-review-toolbar">
                    @if (_selectedCommitShas.Count > 0)
                    {
                        <span class="bulk-review-count" data-testid="bulk-review-count">@_selectedCommitShas.Count 件選択中</span>
                        <span class="bulk-review-hint" data-testid="bulk-review-hint">チェックしたコミットをまとめて移動します。詳細は行をクリックします。</span>
                        <div class="bulk-review-buttons">
                        @if (CanShowBulkMoveButton(ReviewStatus.Adopted))
                        {
                        <button type="button"
                            class="bulk-review-button adopt"
                            data-testid="bulk-review-adopted"
                            disabled="@IsBulkMoveDisabled(ReviewStatus.Adopted)"
                            @onclick="() => MoveSelectedCommitsAsync(ReviewStatus.Adopted)">注目へ</button>
                        }
                        @if (CanShowBulkMoveButton(ReviewStatus.Later))
                        {
                        <button type="button"
                            class="bulk-review-button later"
                            data-testid="bulk-review-later"
                            disabled="@IsBulkMoveDisabled(ReviewStatus.Later)"
                            @onclick="() => MoveSelectedCommitsAsync(ReviewStatus.Later)">保留へ</button>
                        }
                        @if (CanShowBulkMoveButton(ReviewStatus.Archived))
                        {
                        <button type="button"
                            class="bulk-review-button archive"
                            data-testid="bulk-review-archived"
                            disabled="@IsBulkMoveDisabled(ReviewStatus.Archived)"
                            @onclick="() => MoveSelectedCommitsAsync(ReviewStatus.Archived)">アーカイブへ</button>
                        }
                        @if (CanShowBulkMoveButton(ReviewStatus.Unseen))
                        {
                        <button type="button"
                            class="bulk-review-button unseen"
                            data-testid="bulk-review-unseen"
                            disabled="@IsBulkMoveDisabled(ReviewStatus.Unseen)"
                            @onclick="() => MoveSelectedCommitsAsync(ReviewStatus.Unseen)">未確認へ戻す</button>
                        }
                        <button type="button"
                            class="bulk-review-button delete"
                            data-testid="bulk-delete-unseen"
                            disabled="@IsBulkDeleteDisabled()"
                            @onclick="DeleteSelectedUnseenCommitsAsync">削除して再スコアリングへ</button>
                        </div>
                    }
                        @if (!string.IsNullOrWhiteSpace(_bulkReviewStatus))
                        {
                            <span class="bulk-review-status" data-testid="bulk-review-status">@_bulkReviewStatus</span>
                        }
                    </div>
                }
                <CommitList Filter="@_filter"
                            RefreshToken="_listRefreshVersion"
                            SelectedSha="@_selectedCommit?.Sha"
                            SelectedShas="_selectedCommitShas"
                            SelectionChanged="HandleCommitSelectionChanged"
                            OnCommitSelected="HandleCommitSelected" />
            </MudPaper>

            <MudDivider Class="my-2" />

            <MudPaper Elevation="0" Class="pa-2">
                @if (_selectedCommit is not null)
                {
                    <ReviewActions Sha="@_selectedCommit.Sha"
                                   FilePaths="@_selectedCommit.Files.Select(static file => file.Path).ToArray()"
                                   Reviewed="HandleReviewCompleted" />
                }
                <CommitDetail Commit="_selectedCommit" />
                @if (_selectedCommit is not null)
                {
                    @if (CanShowDrafts(_selectedCommit))
                    {
                        <DraftsPanel Sha="@_selectedCommit.Sha" />
                    }
                }
            </MudPaper>
        </main>
    </div>
</CascadingValue>

@code {
    private ReviewStatus? _selectedStatus = ReviewStatus.Unseen;
    private Commit? _selectedCommit;
    private readonly HashSet<string> _selectedCommitShas = new(StringComparer.Ordinal);
    private CommitQueryFilter _filter = new() { Status = ReviewStatus.Unseen };
    private string _commitHashQuery = string.Empty;
    private int _listRefreshVersion;
    private bool _bulkReviewBusy;
    private string? _bulkReviewStatus;
    private bool _askPaletteExpanded;
    private IReviewBroadcaster? _broadcaster;
    private IAppUserSettingsStore? _settingsStore;
    private DocsThemeMode _theme = AppUserSettings.Default.DefaultDocsTheme;

    protected override void OnInitialized()
    {
        _settingsStore = Services.GetService<IAppUserSettingsStore>();
        if (_settingsStore is not null)
        {
            _theme = _settingsStore.Current.DefaultDocsTheme;
            _settingsStore.SettingsChanged += OnSettingsChanged;
        }

        _broadcaster = Services.GetService<IReviewBroadcaster>();
        if (_broadcaster is not null)
        {
            _broadcaster.Reviewed += OnReviewed;
        }
    }

    private async void OnSettingsChanged(AppUserSettings settings)
    {
        try
        {
            await InvokeAsync(() =>
            {
                _theme = settings.DefaultDocsTheme;
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("repoSyncRadarLayout.initSidebarSplitter", "[data-testid='radar-shell']");
        }
        catch (JSException)
        {
            // The fixed fallback layout remains usable if the helper script is unavailable.
        }
    }

    private async void OnReviewed(object? sender, EventArgs e)
    {
        try
        {
            await InvokeAsync(() =>
            {
                // Replace the Filter reference so CommitList's OnParametersSetAsync
                // detects the change and re-queries IRadarRepository.
                _filter = BuildCurrentFilter();
                _selectedCommitShas.Clear();
                _listRefreshVersion++;
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // Component disposed mid-broadcast; safe to swallow.
        }
    }

    public void Dispose()
    {
        if (_broadcaster is not null)
        {
            _broadcaster.Reviewed -= OnReviewed;
        }
        if (_settingsStore is not null)
        {
            _settingsStore.SettingsChanged -= OnSettingsChanged;
        }
    }

    internal static string BuildShellClass(DocsThemeMode theme)
        => $"radar-shell radar-theme-{BuildThemeName(theme)}";

    internal static string BuildThemeName(DocsThemeMode theme)
        => theme == DocsThemeMode.Light ? "light" : "dark";

    private Task HandleStatusChanged(ReviewStatus? status)
    {
        _selectedStatus = status;
        _filter = BuildCurrentFilter();
        _selectedCommit = null;
        _selectedCommitShas.Clear();
        _bulkReviewStatus = null;
        _listRefreshVersion++;
        return Task.CompletedTask;
    }

    private Task HandleCommitHashSearchChanged(ChangeEventArgs args)
    {
        _commitHashQuery = args.Value?.ToString() ?? string.Empty;
        RefreshCommitListForCurrentFilter();
        return Task.CompletedTask;
    }

    private Task ClearCommitHashSearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_commitHashQuery))
        {
            return Task.CompletedTask;
        }

        _commitHashQuery = string.Empty;
        RefreshCommitListForCurrentFilter();
        return Task.CompletedTask;
    }

    private Task ToggleAskPaletteAsync()
    {
        _askPaletteExpanded = !_askPaletteExpanded;
        return Task.CompletedTask;
    }

    private void RefreshCommitListForCurrentFilter()
    {
        _filter = BuildCurrentFilter();
        _selectedCommit = null;
        _selectedCommitShas.Clear();
        _bulkReviewStatus = null;
        _listRefreshVersion++;
    }

    private CommitQueryFilter BuildCurrentFilter()
        => new()
        {
            Status = _selectedStatus,
            ShaQuery = NormalizeCommitSearchQuery(_commitHashQuery),
        };

    private static string? NormalizeCommitSearchQuery(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }
        return value.Trim().ToLowerInvariant();
    }

    private Task HandleCommitSelected(Commit commit)
    {
        _selectedCommit = commit;
        return Task.CompletedTask;
    }

    private Task HandleCommitSelectionChanged(CommitSelectionChange change)
    {
        _bulkReviewStatus = null;
        foreach (var sha in change.Shas)
        {
            if (change.Selected)
            {
                _selectedCommitShas.Add(sha);
            }
            else
            {
                _selectedCommitShas.Remove(sha);
            }
        }
        return Task.CompletedTask;
    }

    private bool IsBulkMoveDisabled(ReviewStatus status)
        => !IsBulkMoveSupported(status)
            || _bulkReviewBusy
            || _selectedCommitShas.Count == 0
            || _selectedStatus == status;

    private bool CanShowBulkMoveButton(ReviewStatus status)
        => _selectedStatus != status;

    private bool IsBulkDeleteDisabled()
        => _bulkReviewBusy
            || _selectedCommitShas.Count == 0
            || _selectedStatus != ReviewStatus.Unseen;

    private async Task MoveSelectedCommitsAsync(ReviewStatus status)
    {
        if (IsBulkMoveDisabled(status))
        {
            return;
        }

        var shas = _selectedCommitShas.ToArray();
        _bulkReviewBusy = true;
        try
        {
            var repo = Services.GetRequiredService<IRadarRepository>();
            foreach (var sha in shas)
            {
                await repo.SetReviewAsync(sha, status, reason: null);
            }

            _selectedCommit = null;
            _selectedCommitShas.Clear();
            _filter = BuildCurrentFilter();
            _bulkReviewStatus = string.Create(
                System.Globalization.CultureInfo.InvariantCulture,
                $"{shas.Length} 件を{BuildStatusDestinationLabel(status)}に移動しました");
            Services.GetRequiredService<IReviewBroadcaster>().Publish();
        }
        finally
        {
            _bulkReviewBusy = false;
        }
    }

    private static bool IsBulkMoveSupported(ReviewStatus status)
        => status is ReviewStatus.Adopted or ReviewStatus.Later or ReviewStatus.Archived or ReviewStatus.Unseen;

    private async Task DeleteSelectedUnseenCommitsAsync()
    {
        if (IsBulkDeleteDisabled())
        {
            return;
        }

        var shas = _selectedCommitShas.ToArray();
        _bulkReviewBusy = true;
        try
        {
            var deleted = await Services.GetRequiredService<IRadarRepository>()
                .DeleteUnseenCommitsAsync(shas);
            _selectedCommit = null;
            _selectedCommitShas.Clear();
            _selectedStatus = ReviewStatus.Unseen;
            _filter = BuildCurrentFilter();
            _listRefreshVersion++;
            _bulkReviewStatus = string.Create(
                System.Globalization.CultureInfo.InvariantCulture,
                $"{deleted} 件をローカル DB から削除しました。次回 Triage で再取得できます");
            Services.GetRequiredService<IReviewBroadcaster>().Publish();
        }
        finally
        {
            _bulkReviewBusy = false;
        }
    }

    private static string BuildStatusDestinationLabel(ReviewStatus status)
        => status switch
        {
            ReviewStatus.Unseen => "未確認",
            ReviewStatus.Adopted => "注目",
            ReviewStatus.Later => "保留",
            ReviewStatus.Rejected => "見送り候補",
            ReviewStatus.Archived => "アーカイブ",
            _ => status.ToString(),
        };

    private static bool CanShowDrafts(Commit commit)
        => commit.Review?.Status == ReviewStatus.Adopted;

    private Task HandleReviewCompleted(ReviewStatus status)
    {
        _filter = BuildCurrentFilter();
        _selectedCommit = null;
        _selectedCommitShas.Clear();
        _bulkReviewStatus = $"1 件を{BuildStatusDestinationLabel(status)}に移動しました";
        _listRefreshVersion++;
        return Task.CompletedTask;
    }
}
