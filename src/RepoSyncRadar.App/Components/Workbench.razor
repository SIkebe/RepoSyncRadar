@* Top-level Razor shell rendered inside the WPF BlazorWebView. Phase 1 wires the
    minimal review surface: Sidebar (status counters) + CommitList (filtered rows) +
    CommitDetail (files + canonical URLs). Diff / WebView2 / adoption actions land in
    later steps. *@

@inject IServiceProvider Services
@inject IJSRuntime JS
@implements IDisposable
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingValue Value="Services" IsFixed="true">
    <div class="radar-shell" data-testid="radar-shell">
        <aside class="radar-sidebar-pane">
            <MudText Typo="Typo.h6" Class="mb-2">Inbox</MudText>
            <Sidebar Selected="_selectedStatus"
                     SelectedChanged="HandleStatusChanged" />
        </aside>

        <div class="radar-sidebar-resizer"
             role="separator"
             aria-orientation="vertical"
             aria-label="サイドバーと作業ペインの幅を変更"
             tabindex="0"
             data-testid="radar-sidebar-resizer"></div>

        <main class="radar-workbench">
            <AppHeader />

            <MudPaper Elevation="0" Class="pa-2">
                <AskPalette />
            </MudPaper>

            <MudPaper Elevation="0" Class="pa-2">
                <CommitList Filter="@_filter"
                            RefreshToken="_listRefreshVersion"
                            SelectedSha="@_selectedCommit?.Sha"
                            OnCommitSelected="HandleCommitSelected" />
            </MudPaper>

            <MudDivider Class="my-2" />

            <MudPaper Elevation="0" Class="pa-2">
                <CommitDetail Commit="_selectedCommit" />
                @if (_selectedCommit is not null)
                {
                    <ReviewActions Sha="@_selectedCommit.Sha"
                                   FilePaths="@_selectedCommit.Files.Select(static file => file.Path).ToArray()"
                                   Reviewed="HandleReviewCompleted" />
                    <PreviewActions Commit="_selectedCommit" />
                    @if (CanShowDrafts(_selectedCommit))
                    {
                        <DraftsPanel Sha="@_selectedCommit.Sha" />
                    }
                }
            </MudPaper>
        </main>
    </div>
</CascadingValue>

@code {
    private ReviewStatus? _selectedStatus = ReviewStatus.Unseen;
    private Commit? _selectedCommit;
    private CommitQueryFilter _filter = new() { Status = ReviewStatus.Unseen };
    private int _listRefreshVersion;
    private IReviewBroadcaster? _broadcaster;

    protected override void OnInitialized()
    {
        _broadcaster = Services.GetService<IReviewBroadcaster>();
        if (_broadcaster is not null)
        {
            _broadcaster.Reviewed += OnReviewed;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("repoSyncRadarLayout.initSidebarSplitter", "[data-testid='radar-shell']");
        }
        catch (JSException)
        {
            // The fixed fallback layout remains usable if the helper script is unavailable.
        }
    }

    private async void OnReviewed(object? sender, EventArgs e)
    {
        try
        {
            await InvokeAsync(() =>
            {
                // Replace the Filter reference so CommitList's OnParametersSetAsync
                // detects the change and re-queries IRadarRepository.
                _filter = new CommitQueryFilter { Status = _selectedStatus };
                _listRefreshVersion++;
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // Component disposed mid-broadcast; safe to swallow.
        }
    }

    public void Dispose()
    {
        if (_broadcaster is not null)
        {
            _broadcaster.Reviewed -= OnReviewed;
        }
    }

    private Task HandleStatusChanged(ReviewStatus? status)
    {
        _selectedStatus = status;
        _filter = new CommitQueryFilter { Status = status };
        _selectedCommit = null;
        _listRefreshVersion++;
        return Task.CompletedTask;
    }

    private Task HandleCommitSelected(Commit commit)
    {
        _selectedCommit = commit;
        return Task.CompletedTask;
    }

    private static bool CanShowDrafts(Commit commit)
        => commit.Review?.Status == ReviewStatus.Adopted;

    private Task HandleReviewCompleted(ReviewStatus status)
    {
        _selectedStatus = _selectedStatus switch
        {
            null => null,
            ReviewStatus.Unseen => ReviewStatus.Unseen,
            _ => status,
        };
        _filter = new CommitQueryFilter { Status = _selectedStatus };
        _selectedCommit = null;
        _listRefreshVersion++;
        return Task.CompletedTask;
    }
}
