@using Microsoft.Extensions.DependencyInjection
@using RepoSyncRadar.Core.Services
@using RepoSyncRadar.Core.Services.Docs
@implements IDisposable

@*
    ArticleBodyPane — Rendering mode B from DESIGN.md §9.3.

    Fetches the rendered HTML for a docs.github.com pathname via IDocsApiClient
    (which calls /api/article/body) and embeds the response into an <iframe srcdoc>.
    The sandbox attribute strips scripts, top-level navigation, and form posts so a
    compromised response cannot exfiltrate the host BlazorWebView's tokens.

    On HTTP 404 (DocsArticleNotFoundException) the pane renders a localized error
    message instead of an empty iframe so users notice broken paths early.
*@

<section class="radar-article-body" data-testid="article-body">
    @if (_errorMessage is not null)
    {
        <div class="article-body-error"
             data-testid="article-body-error"
             role="alert">@_errorMessage</div>
    }
    else if (_bodyHtml is not null)
    {
        <iframe class="article-body-frame"
                data-testid="article-body-iframe"
                sandbox="allow-same-origin"
                srcdoc="@_bodyHtml"></iframe>
    }
    else if (_loading)
    {
        <p class="article-body-loading"
           data-testid="article-body-loading">読み込み中…</p>
    }
</section>

@code {
    [CascadingParameter] public IServiceProvider Services { get; set; } = default!;

    [Parameter] public string? Pathname { get; set; }

    private string? _bodyHtml;
    private string? _errorMessage;
    private bool _loading;
    private string? _loadedPathname;
    private CancellationTokenSource? _cts;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(Pathname))
        {
            ResetState();
            _loadedPathname = null;
            return;
        }

        if (string.Equals(_loadedPathname, Pathname, StringComparison.Ordinal))
        {
            return;
        }

        // Cancel any in-flight load before we kick off the new one.
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        ResetState();
        _loading = true;
        _loadedPathname = Pathname;

        var apiClient = Services.GetRequiredService<IDocsApiClient>();

        try
        {
            var html = await apiClient.GetArticleBodyAsync(Pathname, token);
            if (token.IsCancellationRequested)
            {
                return;
            }
            _bodyHtml = html;
        }
        catch (DocsArticleNotFoundException)
        {
            _errorMessage = $"記事が見つかりません (404): {Pathname}";
        }
        catch (DocsApiException ex)
        {
            _errorMessage = $"記事の取得に失敗しました ({(int)ex.StatusCode}): {Pathname}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetState()
    {
        _bodyHtml = null;
        _errorMessage = null;
        _loading = false;
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;
    }
}
