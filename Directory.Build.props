<Project>

  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!-- .NET 9.0.200+ では NuGet 監査の高重大度が既定でエラー扱いになる。
         直接依存のみゲートする(間接依存は上流の更新待ち)。 -->
    <NuGetAuditMode>direct</NuGetAuditMode>
    <!-- .NET 11 Preview 5+: also gate on known vulnerabilities / EOL in the resolved .NET SDK. -->
    <CheckSdkVulnerabilities>true</CheckSdkVulnerabilities>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- Keep the analyzer baseline stable while adopting .NET 11 previews; preview SDKs can otherwise
         promote broad existing style suggestions to warnings-as-errors across unrelated code. -->
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Authors>SIkebe</Authors>
    <Company>RepoSyncRadar</Company>
    <Copyright>Copyright (c) SIkebe</Copyright>
    <NeutralLanguage>ja-JP</NeutralLanguage>
    <RepoSyncRadarVersion Condition="'$(RepoSyncRadarVersion)' == ''">0.1.22</RepoSyncRadarVersion>
    <Version>$(RepoSyncRadarVersion)</Version>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

</Project>
