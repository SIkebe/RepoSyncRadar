<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!-- .NET 9.0.200+ では NuGet 監査の高重大度が既定でエラー扱いになる。
         直接依存のみゲートする(間接依存は上流の更新待ち)。 -->
    <NuGetAuditMode>direct</NuGetAuditMode>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Authors>SIkebe</Authors>
    <Company>RepoSyncRadar</Company>
    <Copyright>Copyright (c) SIkebe</Copyright>
    <NeutralLanguage>ja-JP</NeutralLanguage>
    <RepoSyncRadarVersion Condition="'$(RepoSyncRadarVersion)' == ''">0.1.3</RepoSyncRadarVersion>
    <Version>$(RepoSyncRadarVersion)</Version>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

</Project>
