<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!-- .NET 9.0.200+ では NuGet 監査の高重大度が既定でエラー扱いになる。
         直接依存のみゲートする(間接依存は上流の更新待ち)。 -->
    <NuGetAuditMode>direct</NuGetAuditMode>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Authors>SIkebe</Authors>
    <Company>RepoSyncRadar</Company>
    <Copyright>Copyright (c) SIkebe</Copyright>
    <NeutralLanguage>ja-JP</NeutralLanguage>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- GitHub.Copilot.SDK 1.0.0-beta.6 targets expect this from a packaged props file, but the nupkg does not include it. -->
    <CopilotCliVersion Condition="'$(CopilotCliVersion)' == ''">1.0.51</CopilotCliVersion>
  </PropertyGroup>

</Project>
